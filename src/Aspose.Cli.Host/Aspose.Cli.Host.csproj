<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Aspose.Cli.Host</AssemblyName>
    <RootNamespace>Aspose.Cli.Host</RootNamespace>
    <Description>
      Shared Aspose CLI host: command-line surface, output
      rendering, App and viewer service lifecycle, and explicit composition root.
    </Description>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aspose.Cli.Sdk\Aspose.Cli.Sdk.csproj" />
    <!-- The contract generator describes the host's App status, which the host publishes under v2/common. -->
    <ProjectReference Include="..\Aspose.Cli.Sdk.Analyzers\Aspose.Cli.Sdk.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="$(AsposeCliAnalyzerGlobalPropertiesToRemove)"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- The renderer-coverage drift test constructs the internal TableOutputWriter. -->
    <InternalsVisibleTo Include="Aspose.Cli.Platform.Tests" />
  </ItemGroup>

  <ItemGroup Label="Embedded local Web App">
    <EmbeddedResource Include="App\assets\app.html" LogicalName="app/app.html" />
    <EmbeddedResource Include="App\assets\app.css" LogicalName="app/app.css" />
    <EmbeddedResource Include="App\assets\app.js" LogicalName="app/app.js" />
    <EmbeddedResource Include="Viewer\kit.js" LogicalName="viewer/kit.js" />
    <EmbeddedResource Include="Viewer\kit.css" LogicalName="viewer/kit.css" />
  </ItemGroup>

  <ItemGroup Label="Platform Agent Skill">
    <!-- The platform Skill: what every product shares (App, preview, review, licensing, errors). -->
    <EmbeddedResource Include="Skills\Platform\**\*.*">
      <LogicalName>skill/$(AsposeCliSkillPrefix)platform/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
