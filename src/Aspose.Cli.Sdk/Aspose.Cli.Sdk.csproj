<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Shared host and product SDK for the Aspose CLI. The SDK owns
      shared contracts, safe runtime primitives, and compile-time product
      extension points without referencing any Aspose product engine.
    </Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aspose.Cli.Platform.Tests" />
    <InternalsVisibleTo Include="Aspose.Cli.TestKit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contract generator describes the SDK's own result records, whose schemas the SDK publishes under v2/common. -->
    <ProjectReference Include="..\Aspose.Cli.Sdk.Analyzers\Aspose.Cli.Sdk.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="$(AsposeCliAnalyzerGlobalPropertiesToRemove)"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\eng\generated\DistributionInfo.g.cs" Link="DistributionInfo.g.cs" />
  </ItemGroup>
</Project>
