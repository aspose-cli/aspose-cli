{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/common/verification-issue.schema.json",
  "title": "Verification issue",
  "description": "A problem found while verifying an edited output. Codes are listed in capabilities diagnostics with category verification, or are forwarded warning codes.",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "message": { "type": "string", "minLength": 1 },
    "location": { "type": "string", "minLength": 1 },
    "hint": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
