{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/common/verification-issue.schema.json",
  "title": "Verification issue",
  "description": "A problem found while verifying an edited output; any issue makes the verification fail.",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "message": { "type": "string" },
    "location": { "type": "string" },
    "hint": { "type": "string" }
  },
  "additionalProperties": false
}
