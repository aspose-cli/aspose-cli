{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/common/preview-session.schema.json",
  "title": "Product preview session result",
  "description": "Result of `aspose-cli preview open <file>`.",
  "type": "object",
  "required": ["schema", "schemaVersion", "id", "product", "url", "pid", "file", "view", "reused"],
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/common/preview-session.schema.json" },
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "product": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/d/[0-9a-f]{32}/$" },
    "pid": { "type": "integer", "minimum": 1 },
    "file": { "type": "string" },
    "view": { "type": "string", "minLength": 1 },
    "selector": { "$ref": "#/$defs/productPayload" },
    "reused": { "type": "boolean" },
    "license": { "$ref": "#/$defs/licenseInfo" },
    "warnings": { "$ref": "#/$defs/warnings" }
  },
  "additionalProperties": false,
  "$defs": {
    "productPayload": {
      "type": "object",
      "required": ["productId", "kind", "schemaVersion", "schemaId", "payload"],
      "properties": {
        "productId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "kind": { "const": "selector" },
        "schemaVersion": { "const": 2 },
        "schemaId": { "type": "string", "pattern": "^v2/[a-z0-9][a-z0-9-]*/[a-z][a-z0-9-]*$" },
        "payload": {}
      },
      "additionalProperties": false
    },
    "licenseInfo": {
      "type": "object",
      "required": ["mode"],
      "properties": { "mode": { "enum": ["evaluation", "licensed", "not-applicable"] } },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "docs": { "type": "string" },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  }
}
