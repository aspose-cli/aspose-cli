{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/common/font-check.schema.json",
  "title": "Font check",
  "description": "Result of `aspose-cli fonts check <file>`: whether the fonts a workbook uses are available here and, if not, what they will be substituted with — the rendering-fidelity diagnostic.",
  "type": "object",
  "required": ["schema", "schemaVersion", "source", "allAvailable", "fonts"],
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/common/font-check.schema.json" },
    "schemaVersion": { "const": 2 },
    "source": { "$ref": "#/$defs/source" },
    "allAvailable": { "type": "boolean" },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "available"],
        "properties": {
          "name": { "type": "string" },
          "available": { "type": "boolean" },
          "substitutedBy": { "type": "string" }
        }
      }
    },
    "license": { "type": "object" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "hint": { "type": "string", "minLength": 1 },
          "docs": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["path", "format", "sizeBytes"],
      "properties": {
        "path": { "type": "string" },
        "format": { "type": "string" },
        "sizeBytes": { "type": "integer" }
      }
    }
  }
}
