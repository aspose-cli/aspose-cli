{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/common/version.schema.json",
  "title": "Aspose CLI version",
  "description": "Result of `aspose-cli --version --output json`: the build identity, with the same values capabilities reports. Plain `--version` prints the artifact version as text instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "cliVersion", "sourceRevision", "buildDirty", "enginePins"],
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/common/version.schema.json" },
    "schemaVersion": { "const": 2 },
    "cliVersion": {
      "type": "string",
      "minLength": 1,
      "description": "CLI version without build metadata; equal to capabilities cliVersion."
    },
    "artifactVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Full artifact version as plain --version prints it; present only when it differs from cliVersion."
    },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "buildDirty": { "type": "boolean" },
    "enginePins": {
      "type": "array",
      "description": "Engine compiled for each product; equal to capabilities enginePins.",
      "items": {
        "type": "object",
        "required": ["product", "engine", "version"],
        "properties": {
          "product": { "type": "string", "minLength": 1 },
          "engine": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "license": { "$ref": "#/$defs/licenseInfo" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "hint": { "type": "string", "minLength": 1 },
          "docs": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "licenseInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["evaluation", "licensed", "not-applicable"] }
      }
    }
  }
}
