{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/common/license-status.schema.json",
  "title": "Aspose CLI license status",
  "description": "Result of `aspose-cli license status`.",
  "type": "object",
  "required": ["schema", "schemaVersion", "applicable", "mode"],
  "properties": {
    "schema": {
      "const": "https://schemas.aspose.dev/aspose-cli/v2/common/license-status.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "applicable": {
      "type": "boolean"
    },
    "mode": {
      "enum": ["evaluation", "licensed", "not-applicable"]
    },
    "source": {
      "anyOf": [
        {
          "enum": ["flag", "env:ASPOSE_LICENSE_B64", "env:ASPOSE_LICENSE_PATH", "project", "user"]
        },
        {
          "pattern": "^(project|user):[a-z0-9_-]+$"
        },
        {
          "pattern": "^env:ASPOSE_[A-Z0-9_]+_LICENSE_(B64|PATH)$"
        }
      ]
    },
    "path": {
      "type": "string"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["product", "applicable", "mode"],
        "properties": {
          "product": { "type": "string" },
          "applicable": { "type": "boolean" },
          "mode": { "enum": ["evaluation", "licensed", "not-applicable"] },
          "source": { "type": "string" },
          "path": { "type": "string" },
          "problem": { "type": "string" },
          "hint": { "type": "string" }
        }
      }
    },
    "license": {
      "$ref": "#/$defs/licenseInfo"
    },
    "warnings": {
      "$ref": "#/$defs/warnings"
    }
  },
  "$defs": {
    "licenseInfo": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["evaluation", "licensed", "not-applicable"] }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "docs": { "type": "string" },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  }
}
