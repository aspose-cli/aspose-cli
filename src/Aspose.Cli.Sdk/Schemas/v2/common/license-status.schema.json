{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/common/license-status.schema.json",
  "title": "Aspose CLI license status",
  "description": "Effective independently verified license status for every selected product.",
  "type": "object",
  "required": ["schema", "schemaVersion", "applicable", "products", "sharedUserLicenseInstalled"],
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/common/license-status.schema.json" },
    "schemaVersion": { "const": 2 },
    "applicable": { "type": "boolean" },
    "warnings": { "$ref": "#/$defs/warnings" },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/productLicense" }
    },
    "sharedUserLicenseInstalled": { "type": "boolean" },
    "identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "docs": { "type": "string" },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "productLicense": {
      "type": "object",
      "required": ["product", "name", "applicable", "mode", "userLicenseInstalled"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "applicable": { "type": "boolean" },
        "mode": { "enum": ["evaluation", "licensed", "invalid", "not-applicable"] },
        "source": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 },
        "userLicenseInstalled": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
