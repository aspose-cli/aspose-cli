{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/common/doctor.schema.json",
  "title": "Doctor",
  "description": "Result of `aspose-cli doctor`: environment self-diagnosis — license, runtime and output writability, each an ok/warn/fail check.",
  "type": "object",
  "required": ["schema", "schemaVersion", "ok", "checks"],
  "properties": {
    "schema": {
      "const": "https://schemas.aspose.dev/aspose-cli/v2/common/doctor.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "ok": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["ok", "warn", "fail"] },
          "detail": { "type": "string" },
          "hint": { "type": "string" }
        }
      }
    },
    "license": {
      "$ref": "#/$defs/licenseInfo"
    },
    "warnings": {
      "$ref": "#/$defs/warnings"
    }
  },
  "$defs": {
    "licenseInfo": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["evaluation", "licensed", "not-applicable"] }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "docs": { "type": "string" },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  }
}
