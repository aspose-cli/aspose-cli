{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/common/capabilities.schema.json",
  "title": "Aspose CLI capabilities",
  "description": "Machine-readable self-description of the CLI build: products, verbs, formats and structured operations. Agents use it for runtime discovery.",
  "type": "object",
  "required": ["schema", "schemaVersion", "edition", "cliVersion", "sourceRevision", "buildDirty", "enginePins", "products", "schemas", "routing", "commands", "resourceBudgetContractVersion", "resourceBudgets", "diagnostics"],
  "properties": {
    "schema": {
      "const": "https://schemas.aspose.dev/aspose-cli/v2/common/capabilities.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "cliVersion": {
      "type": "string"
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "buildDirty": {
      "type": "boolean"
    },
    "enginePins": {
      "type": "array",
      "items": { "$ref": "#/$defs/enginePin" }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "engine", "verbs", "convertFormats", "renderFormats", "operations"],
        "properties": {
          "id": { "type": "string" },
          "engine": { "$ref": "#/$defs/engine" },
          "verbs": { "type": "array", "items": { "type": "string" } },
          "convertFormats": { "type": "array", "items": { "type": "string" } },
          "renderFormats": { "type": "array", "items": { "type": "string" } },
          "operations": {
            "type": "array",
            "items": { "$ref": "#/$defs/productOperation" }
          },
          "loadFormats": { "type": "array", "items": { "type": "string" } },
          "formats": {
            "type": "array",
            "items": { "$ref": "#/$defs/productFormat" }
          },
          "commands": {
            "type": "array",
            "items": { "$ref": "#/$defs/command" }
          },
          "resourceBudgets": {
            "type": "array",
            "items": { "$ref": "#/$defs/resourceBudget" }
          },
          "preview": {
            "type": "object",
            "required": ["defaultView", "views", "background"],
            "properties": {
              "defaultView": { "type": "string" },
              "views": { "type": "array", "items": { "type": "string" } },
              "background": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "review": {
            "type": "object",
            "required": ["defaultView", "views", "visualInspectionRequired"],
            "properties": {
              "defaultView": { "type": "string" },
              "views": { "type": "array", "items": { "type": "string" } },
              "visualInspectionRequired": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "schemas": {
      "type": "array",
      "description": "Schema ids printable via `aspose-cli schema <id>`.",
      "items": { "type": "string" }
    },
    "routing": {
      "$ref": "#/$defs/routing"
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "resourceBudgetContractVersion": {
      "const": 1
    },
    "resourceBudgets": {
      "type": "array",
      "items": { "$ref": "#/$defs/resourceBudget" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "enginePin": {
      "type": "object",
      "required": ["product", "engine", "version"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "required": [
        "id",
        "sdk",
        "sdkVersion",
        "licenseRequired",
        "licenseApplicable",
        "supportsFontDiagnostics",
        "supportsExplicitFontProfiles"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sdk": { "type": "string", "minLength": 1 },
        "sdkVersion": { "type": "string", "minLength": 1 },
        "licenseRequired": { "type": "boolean" },
        "licenseApplicable": { "type": "boolean" },
        "supportsFontDiagnostics": { "type": "boolean" },
        "supportsExplicitFontProfiles": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "productOperation": {
      "type": "object",
      "required": [
        "id",
        "command",
        "inputSchema",
        "atomicByDefault",
        "supportsDryRun"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "command": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*( [a-z][a-z0-9_-]*)*$" },
        "inputSchema": { "type": "string", "pattern": "^v2/[a-z][a-z0-9_-]*/[a-z][a-z0-9_/-]*$" },
        "atomicByDefault": { "type": "boolean" },
        "supportsDryRun": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "owner",
        "severity",
        "category",
        "messageTemplateId",
        "hintTemplateId",
        "detailsSchemaId"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "owner": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning"] },
        "exitCode": { "type": "integer", "minimum": 1, "maximum": 9 },
        "category": { "type": "string", "minLength": 1 },
        "messageTemplateId": { "type": "string", "minLength": 1 },
        "hintTemplateId": { "type": "string", "minLength": 1 },
        "detailsSchemaId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resourceBudget": {
      "type": "object",
      "required": [
        "kind",
        "default",
        "maximum",
        "unit",
        "enforcementStage"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "default": { "type": "integer", "minimum": 1 },
        "maximum": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "option": { "type": "string" },
        "environmentVariable": { "type": "string" },
        "enforcementStage": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": [
        "totalProbeMilliseconds",
        "totalProbeBytes",
        "maxConcurrency",
        "indeterminatePolicy",
        "routes"
      ],
      "properties": {
        "defaultProduct": { "type": "string" },
        "defaultProductSource": { "type": "string" },
        "totalProbeMilliseconds": { "type": "integer", "minimum": 1 },
        "totalProbeBytes": { "type": "integer", "minimum": 1 },
        "maxConcurrency": { "type": "integer", "minimum": 1 },
        "indeterminatePolicy": { "type": "string" },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "extension",
              "product",
              "operations",
              "requiresContentProbe",
              "recognizerStrategy",
              "maxProbeBytes"
            ],
            "properties": {
              "extension": { "type": "string" },
              "product": { "type": "string" },
              "operations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "requiresContentProbe": { "type": "boolean" },
              "recognizerStrategy": { "type": "string" },
              "maxProbeBytes": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "productFormat": {
      "type": "object",
      "required": [
        "id",
        "extensions",
        "aliases",
        "uses",
        "operations",
        "declaredOwnership",
        "genericAvailable",
        "explicitAvailable"
      ],
      "properties": {
        "id": { "type": "string" },
        "extensions": { "type": "array", "items": { "type": "string" } },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "uses": { "type": "array", "items": { "type": "string" } },
        "operations": { "type": "array", "items": { "type": "string" } },
        "declaredOwnership": { "enum": ["explicit", "default"] },
        "finalOwner": { "type": "string" },
        "genericAvailable": { "type": "boolean" },
        "explicitAvailable": { "type": "boolean" },
        "recognizerStrategy": { "type": "string" },
        "maxProbeBytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "path",
        "name",
        "aliases",
        "hidden",
        "options",
        "arguments"
      ],
      "properties": {
        "path": { "type": "string" },
        "name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "hidden": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/argument" }
        }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": [
        "name",
        "aliases",
        "type",
        "minimumArity",
        "maximumArity",
        "required",
        "recursive",
        "hasDefault",
        "allowedValues",
        "secret",
        "valueSource",
        "inputKind"
      ],
      "properties": {
        "name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string" },
        "minimumArity": { "type": "integer", "minimum": 0 },
        "maximumArity": { "type": "integer", "minimum": 0 },
        "required": { "type": "boolean" },
        "recursive": { "type": "boolean" },
        "hasDefault": { "type": "boolean" },
        "default": { "type": "string" },
        "allowedValues": { "type": "array", "items": { "type": "string" } },
        "secret": { "type": "boolean" },
        "valueSource": { "enum": ["command-line", "environment-variable-name", "stdin"] },
        "inputKind": { "enum": ["none", "file", "json-source"] },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "argument": {
      "type": "object",
      "required": [
        "name",
        "type",
        "minimumArity",
        "maximumArity",
        "required",
        "hasDefault",
        "allowedValues",
        "inputKind",
        "valueSource",
        "secret"
      ],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "minimumArity": { "type": "integer", "minimum": 0 },
        "maximumArity": { "type": "integer", "minimum": 0 },
        "required": { "type": "boolean" },
        "hasDefault": { "type": "boolean" },
        "default": { "type": "string" },
        "allowedValues": { "type": "array", "items": { "type": "string" } },
        "inputKind": { "enum": ["none", "file", "json-source"] },
        "valueSource": { "enum": ["command-line", "environment-variable-name", "stdin"] },
        "secret": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
