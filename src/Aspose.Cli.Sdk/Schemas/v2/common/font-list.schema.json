{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/common/font-list.schema.json",
  "title": "Font list",
  "description": "Result of `aspose-cli fonts list`: the engine's font environment — the default fallback font and the sources it scans. Empty `sources` means the engine uses its platform defaults.",
  "type": "object",
  "required": ["schema", "schemaVersion", "sources"],
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/common/font-list.schema.json" },
    "schemaVersion": { "const": 2 },
    "defaultFont": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["folder", "file", "memory", "system", "other"] },
          "location": { "type": "string" }
        }
      }
    },
    "license": { "type": "object" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "hint": { "type": "string", "minLength": 1 },
          "docs": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        }
      }
    }
  }
}
