{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/common/skill-install.schema.json",
  "title": "Skill install",
  "description": "Result of `aspose-cli skill install`: the bundled agent skill was extracted to a target directory.",
  "type": "object",
  "required": ["schema", "schemaVersion", "skill", "target", "files"],
  "properties": {
    "schema": {
      "const": "https://schemas.aspose.dev/aspose-cli/v2/common/skill-install.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "skill": { "type": "string" },
    "target": { "type": "string" },
    "files": { "type": "integer", "minimum": 0 },
    "license": {
      "$ref": "#/$defs/licenseInfo"
    },
    "warnings": {
      "$ref": "#/$defs/warnings"
    }
  },
  "$defs": {
    "licenseInfo": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["evaluation", "licensed", "not-applicable"] }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "docs": { "type": "string" },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  }
}
