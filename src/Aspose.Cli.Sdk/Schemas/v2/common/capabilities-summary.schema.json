{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/common/capabilities-summary.schema.json",
  "title": "Aspose CLI capabilities summary",
  "description": "Result of `aspose-cli capabilities --summary`: each product's commands with their descriptions, formats and edit operation names, projected from the capabilities document. `aspose-cli capabilities <product> <command>` gives one command's full detail.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "cliVersion", "products"],
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/common/capabilities-summary.schema.json" },
    "schemaVersion": { "const": 2 },
    "cliVersion": {
      "type": "string",
      "minLength": 1,
      "description": "CLI version; equal to capabilities cliVersion."
    },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/product" }
    },
    "license": { "$ref": "#/$defs/licenseInfo" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "hint": { "type": "string", "minLength": 1 },
          "docs": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "loadFormats", "convertFormats", "renderFormats", "commands", "operations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "engineVersion": { "type": "string", "minLength": 1 },
        "loadFormats": { "$ref": "#/$defs/names" },
        "convertFormats": { "$ref": "#/$defs/names" },
        "renderFormats": { "$ref": "#/$defs/names" },
        "commands": {
          "type": "array",
          "description": "Visible product commands; each path selects its full detail through `capabilities <product> <command>`.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "ops"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "ops": { "$ref": "#/$defs/names" }
            }
          }
        }
      }
    },
    "names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "licenseInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["evaluation", "licensed", "not-applicable"] }
      }
    }
  }
}
