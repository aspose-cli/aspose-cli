<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Aspose.Cli.Sdk\build\Aspose.Cli.Sdk.props" />
  <PropertyGroup>
    <Description>Autonomous Slides product module with contracts, commands, preview, resources and Aspose.Slides adapter.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aspose.Cli.Sdk\Aspose.Cli.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspose.Slides.NET6.CrossPlatform" PrivateAssets="build;buildTransitive;contentFiles;analyzers" />
  </ItemGroup>
  <!-- The SDK clears RuntimeIdentifier on portable project references. Keep the
       publication RID separate so this product selects its own native content
       before the launcher bundles files. -->
  <Target Name="SelectSlidesNativeAssets" BeforeTargets="AssignTargetPaths"
          Condition="'$(AsposeCliPublishRuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.Identity)').Contains('net6.0_native')) and '%(None.Filename)%(None.Extension)' != 'aspose.slides.drawing.capi_vc14x64.dll'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- The design every new presentation starts from when no template is given. -->
    <EmbeddedResource Include="Engine\Templates\default-16x9.pptx" LogicalName="Templates/default-16x9.pptx" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aspose.Cli.Product.Slides.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The ops schema is generated from the operation records and served from them; the
         committed copy is for review and external readers, and a contract test keeps it current. -->
    <EmbeddedResource Remove="$(MSBuildProjectDirectory)\Schemas\v2\ops.schema.json" />
  </ItemGroup>
</Project>
