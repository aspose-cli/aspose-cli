{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/slides/presentation-info.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "source", "presentation", "slides"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/slides/presentation-info.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "presentation" },
    "source": { "type": "object" },
    "presentation": {
      "type": "object",
      "required": ["slideCount", "widthPoints", "heightPoints", "orientation", "masterCount", "layoutCount", "sectionCount", "commentCount", "mediaCount", "hasMacros"],
      "additionalProperties": false,
      "properties": {
        "slideCount": { "type": "integer", "minimum": 0 },
        "widthPoints": { "type": "number", "minimum": 0 },
        "heightPoints": { "type": "number", "minimum": 0 },
        "orientation": { "enum": ["landscape", "portrait", "square"] },
        "masterCount": { "type": "integer", "minimum": 0 },
        "layoutCount": { "type": "integer", "minimum": 0 },
        "sectionCount": { "type": "integer", "minimum": 0 },
        "commentCount": { "type": "integer", "minimum": 0 },
        "mediaCount": { "type": "integer", "minimum": 0 },
        "hasMacros": { "type": "boolean" }
      }
    },
    "slides": { "type": "array", "items": { "type": "object" } },
    "sections": { "type": "array", "items": { "type": "object" } },
    "masters": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "slideCount"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "slideCount": { "type": "integer", "minimum": 0, "description": "How many slides use one of this master's layouts." }
        }
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "master", "slideCount"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "master": { "type": ["string", "null"] },
          "slideCount": { "type": "integer", "minimum": 0, "description": "How many slides use this layout." }
        }
      }
    },
    "media": { "type": "array", "items": { "type": "object" } },
    "notes": { "type": "array", "items": { "type": "object" } },
    "comments": { "type": "array", "items": { "type": "object" } },
    "fonts": { "type": "array", "items": { "type": "string" } },
    "properties": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
