{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/slides/presentation-read.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "source", "scope", "window", "slides"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/slides/presentation-read.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "presentation" },
    "source": { "type": "object" },
    "scope": { "enum": ["text", "shapes", "full"] },
    "window": {
      "type": "object",
      "required": ["slides", "of", "truncated"],
      "additionalProperties": false,
      "properties": {
        "slides": { "type": "string" },
        "of": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      }
    },
    "slides": { "type": "array", "items": { "type": "object", "properties": { "shapes": { "type": "array", "items": { "type": "object", "properties": { "shapeId": { "type": "integer", "minimum": 1, "description": "Positive persistent identifier within this slide; pass as an edit operation shape selector." } } } } } } },
    "next": { "type": "string" },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
