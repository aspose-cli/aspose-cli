{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/slides/presentation-read.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "source", "scope", "slideCount", "slides", "window"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/slides/presentation-read.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "presentation" },
    "source": { "type": "object" },
    "scope": { "enum": ["text", "shapes", "full"] },
    "slideCount": { "type": "integer", "minimum": 0, "description": "How many slides the presentation holds." },
    "slides": { "type": "array", "items": { "type": "object", "properties": { "contentTruncated": { "type": "boolean", "description": "The shared max-chars budget covers title, text, runs, requested notes and comments, including repeated projections; re-read this slide with a larger budget for omitted content." }, "shapes": { "type": "array", "items": { "type": "object", "properties": { "shapeId": { "type": "integer", "minimum": 1, "description": "Positive persistent identifier within this slide; edit operations accept it as shapeId." } } } } } } },
    "window": { "$ref": "https://schemas.aspose.dev/aspose-cli/v2/common/result-window.schema.json" },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
