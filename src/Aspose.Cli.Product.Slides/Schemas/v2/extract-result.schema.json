{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/slides/extract-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "what", "items"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/slides/extract-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "type": "object" },
    "what": { "enum": ["media", "notes", "text"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sizeBytes"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "kind": { "enum": ["image", "audio", "video", "notes", "text"] },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "slide": { "type": "integer", "minimum": 1 },
          "slideId": { "type": "integer", "minimum": 1 },
          "index": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "contentType": { "type": "string" }
        }
      }
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
