{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/slides/edit-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "dryRun", "applied"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/slides/edit-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "type": "object" },
    "output": { "type": "object" },
    "dryRun": { "type": "boolean" },
    "applied": {
      "type": "array",
      "items": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/operation-outcome.schema.json" }
    },
    "backup": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/backup.schema.json" },
    "slidesTouched": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
