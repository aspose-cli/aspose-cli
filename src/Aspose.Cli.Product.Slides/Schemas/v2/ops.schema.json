    "update_chart_data": {
      "description": "Replaces the categories or series of a chart in its embedded workbook. When both are given, every series has one value per category.",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "update_chart_data"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "shapeId": {
          "description": "The persistent slide-scoped shapeId returned by query slides; not a shape position.",
          "type": "integer",
          "minimum": 1
        },
        "shapeName": {
          "description": "The shape name, matched case-sensitively.",
          "type": "string",
          "pattern": "\\S"
        },
        "placeholder": {
          "description": "The placeholder role, as query slides reports it.",
          "type": "string",
          "enum": [
            "title",
            "body",
            "subtitle",
            "footer"
          ]
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/slidesChartSeriesInput"
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "shapeId"
              ]
            },
            {
              "required": [
                "shapeName"
              ]
            },
            {
              "required": [
                "placeholder"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "categories"
              ]
            },
            {
              "required": [
                "series"
              ]
            }
          ]
        }
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "pages": {
      "type": "string",
      "description": "1-based pages and ranges separated by commas, such as 1-3,7,9-; a range with no end runs to the last page, and a range must not end before it starts.",
      "pattern": "^\\s*0*[1-9][0-9]*(-(0*[1-9][0-9]*)?)?(\\s*,\\s*0*[1-9][0-9]*(-(0*[1-9][0-9]*)?)?)*\\s*$"
    },
    "slidesChartSeriesInput": {
      "description": "One chart series.",
      "type": "object",
      "required": [
        "name",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "number"
          }
        },
        "xValues": {
          "description": "The x value of each point of a scatter series, one per value.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "slidesParagraphInput": {
      "description": "One body paragraph; its bullets and spacing come from the placeholder's level.",
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "level": {
          "description": "The outline level, 0 for a top-level paragraph.",
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "default": 0
        }
      }
    },
    "slidesRectInput": {
      "description": "A rectangle in presentation points from the top-left origin.",
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "slidesShapeStyleInput": {
      "description": "Visual styling of a slide shape and its text; it must set at least one property.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {
          "$ref": "#/$defs/color"
        },
        "line": {
          "$ref": "#/$defs/color"
        },
        "font": {
          "description": "A font name, applied to Latin, East Asian and complex-script text.",
          "type": "string"
        },
        "size": {
          "description": "The font size in points.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 400
        },
        "color": {
          "description": "The text color.",
          "$ref": "#/$defs/color"
        },
        "bold": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "minProperties": 1
        }
      ]
    }
  }
}
