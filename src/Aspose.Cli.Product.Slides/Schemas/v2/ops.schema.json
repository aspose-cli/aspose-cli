        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_title"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
