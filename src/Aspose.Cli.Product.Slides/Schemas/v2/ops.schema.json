{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/slides/ops.schema.json",
  "description": "The operation document of slides edit --ops. Every slide and shape target resolves against the presentation as it was before the first operation, so content inserted earlier in the batch cannot be targeted, and a target deleted earlier fails the operation. Operations apply in order. Without --best-effort the batch is atomic: if any operation fails, no file is written. With --best-effort the operations that succeed are kept and saved, each one that fails is reported, and the command exits 8 when any failed; an invalid document or a failure inside the document engine still writes nothing.",
  "type": "object",
  "required": [
    "ops"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "description": "Optional; checked when present.",
      "const": "https://schemas.aspose.dev/aspose-cli/v2/slides/ops.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "ifMatch": {
      "description": "The SHA-256 fingerprint the input must still have; the edit fails when it changed.",
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "ops": {
      "description": "Operations applied in order.",
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/add_section"
          },
          {
            "$ref": "#/$defs/add_slide"
          },
          {
            "$ref": "#/$defs/append_presentation"
          },
          {
            "$ref": "#/$defs/apply_layout"
          },
          {
            "$ref": "#/$defs/delete_shape"
          },
          {
            "$ref": "#/$defs/delete_slides"
          },
          {
            "$ref": "#/$defs/duplicate_slide"
          },
          {
            "$ref": "#/$defs/insert_chart"
          },
          {
            "$ref": "#/$defs/insert_image"
          },
          {
            "$ref": "#/$defs/insert_shape"
          },
          {
            "$ref": "#/$defs/insert_table"
          },
          {
            "$ref": "#/$defs/move_slide"
          },
          {
            "$ref": "#/$defs/replace_text"
          },
          {
            "$ref": "#/$defs/set_background"
          },
          {
            "$ref": "#/$defs/set_body"
          },
          {
            "$ref": "#/$defs/set_footer"
          },
          {
            "$ref": "#/$defs/set_notes"
          },
          {
            "$ref": "#/$defs/set_properties"
          },
          {
            "$ref": "#/$defs/set_shape_style"
          },
          {
            "$ref": "#/$defs/set_slide_hidden"
          },
          {
            "$ref": "#/$defs/set_slide_size"
          },
          {
            "$ref": "#/$defs/set_table_cell"
          },
          {
            "$ref": "#/$defs/set_text"
          },
          {
            "$ref": "#/$defs/set_title"
          },
          {
            "$ref": "#/$defs/set_transition"
          },
          {
            "$ref": "#/$defs/update_chart_data"
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "description": "A correlation id echoed in the result; op-0001 style ids are assigned when omitted.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "add_section": {
      "description": "Starts a new section at a slide; section names are unique.",
      "type": "object",
      "required": [
        "op",
        "name",
        "startSlide"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "add_section"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "startSlide": {
          "description": "The 1-based number of the section's first slide.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "add_slide": {
      "description": "Adds an empty slide.",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "add_slide"
        },
        "layout": {
          "description": "The layout name, matched case-insensitively; the first layout when omitted.",
          "type": "string",
          "pattern": "\\S"
        },
        "at": {
          "description": "The 1-based position of the new slide, at most the slide count plus one; the end when omitted.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "append_presentation": {
      "description": "Appends every slide of another presentation.",
      "type": "object",
      "required": [
        "op",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "append_presentation"
        },
        "path": {
          "description": "The source presentation, relative to the working directory.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "masterPolicy": {
          "description": "Whether appended slides keep their own masters or take the destination's first master.",
          "type": "string",
          "enum": [
            "keep-source",
            "use-dest"
          ],
          "default": "keep-source"
        }
      }
    },
    "apply_layout": {
      "description": "Applies a layout to slides.",
      "type": "object",
      "required": [
        "op",
        "slides",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "apply_layout"
        },
        "slides": {
          "$ref": "#/$defs/pages"
        },
        "layout": {
          "description": "The layout name, matched case-insensitively.",
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "delete_shape": {
      "description": "Deletes one shape.",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "delete_shape"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "shapeId": {
          "description": "The persistent slide-scoped shapeId returned by query slides; not a shape position.",
          "type": "integer",
          "minimum": 1
        },
        "shapeName": {
          "description": "The shape name, matched case-sensitively.",
          "type": "string",
          "pattern": "\\S"
        },
        "placeholder": {
          "description": "The placeholder role, as query slides reports it.",
          "type": "string",
          "enum": [
            "title",
            "body",
            "subtitle",
            "footer"
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "shapeId"
              ]
            },
            {
              "required": [
                "shapeName"
              ]
            },
            {
              "required": [
                "placeholder"
              ]
            }
          ]
        }
      ]
    },
    "delete_slides": {
      "description": "Deletes slides; a presentation must keep at least one slide.",
      "type": "object",
      "required": [
        "op",
        "slides"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "delete_slides"
        },
        "slides": {
          "$ref": "#/$defs/pages"
        }
      }
    },
    "duplicate_slide": {
      "description": "Inserts a copy of one slide.",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "duplicate_slide"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "description": "The 1-based position of the copy, at most the slide count plus one; the end when omitted.",
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        }
      ]
    },
    "insert_chart": {
      "description": "Inserts a chart. Every series has one value per category, and a scatter series has one x value per value.",
      "type": "object",
      "required": [
        "op",
        "kind",
        "rect",
        "categories",
        "series"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "insert_chart"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "bar",
            "column",
            "line",
            "pie",
            "scatter"
          ]
        },
        "rect": {
          "$ref": "#/$defs/slidesRectInput"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/slidesChartSeriesInput"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        }
      ]
    },
    "insert_image": {
      "description": "Inserts a picture.",
      "type": "object",
      "required": [
        "op",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "insert_image"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "description": "The picture, relative to the working directory.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rect": {
          "description": "Where the picture goes; when omitted it keeps its aspect ratio, centered in 80% by 75% of the slide.",
          "$ref": "#/$defs/slidesRectInput"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        }
      ]
    },
    "insert_shape": {
      "description": "Inserts a shape.",
      "type": "object",
      "required": [
        "op",
        "kind",
        "rect"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "insert_shape"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "rectangle",
            "rounded-rectangle",
            "ellipse",
            "line",
            "chevron"
          ]
        },
        "rect": {
          "$ref": "#/$defs/slidesRectInput"
        },
        "text": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/slidesShapeStyleInput"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        }
      ]
    },
    "insert_table": {
      "description": "Inserts a table with equal rows and columns; data fills it from the top-left cell.",
      "type": "object",
      "required": [
        "op",
        "rect",
        "rows",
        "cols"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "insert_table"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "rect": {
          "$ref": "#/$defs/slidesRectInput"
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "data": {
          "description": "Cell text by row, at most rows rows of at most cols cells each.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        }
      ]
    },
    "move_slide": {
      "description": "Moves one slide to a position; it keeps its slide id.",
      "type": "object",
      "required": [
        "op",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "move_slide"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "description": "The 1-based position, at most the slide count.",
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        }
      ]
    },
    "replace_text": {
      "description": "Replaces text within each paragraph of every slide's shapes (including table cells, group children and SmartArt nodes) and speaker notes. A regular expression runs with a one-second timeout and must compile.",
      "type": "object",
      "required": [
        "op",
        "find",
        "replace"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "replace_text"
        },
        "find": {
          "type": "string",
          "minLength": 1
        },
        "replace": {
          "description": "The replacement; with regex it honors .NET substitutions such as $1, and $$ is a literal $.",
          "type": "string"
        },
        "regex": {
          "description": "Whether find is a .NET regular expression rather than literal text.",
          "type": "boolean",
          "default": false
        },
        "matchCase": {
          "type": "boolean",
          "default": false
        },
        "scope": {
          "type": "string",
          "enum": [
            "shapes",
            "notes",
            "all"
          ],
          "default": "all"
        }
      }
    },
    "set_background": {
      "description": "Gives slides their own solid-color or stretched-picture background.",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_background"
        },
        "slides": {
          "description": "The slides to change; every slide when omitted.",
          "$ref": "#/$defs/pages"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "imagePath": {
          "description": "The picture, relative to the working directory.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "color"
              ]
            },
            {
              "required": [
                "imagePath"
              ]
            }
          ]
        }
      ]
    },
    "set_body": {
      "description": "Replaces the paragraphs of a slide's body placeholder.",
      "type": "object",
      "required": [
        "op",
        "paragraphs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_body"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slidesParagraphInput"
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        }
      ]
    },
    "set_footer": {
      "description": "Shows footer text, slide numbers or dates through the layout's own placeholders; it must set at least one of text, showNumber and showDate.",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_footer"
        },
        "slides": {
          "description": "The slides to change; every slide when omitted.",
          "$ref": "#/$defs/pages"
        },
        "text": {
          "type": "string"
        },
        "showNumber": {
          "type": "boolean"
        },
        "showDate": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "showNumber"
              ]
            },
            {
              "required": [
                "showDate"
              ]
            }
          ]
        }
      ]
    },
    "set_notes": {
      "description": "Replaces a slide's speaker-note text.",
      "type": "object",
      "required": [
        "op",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_notes"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        }
      ]
    },
    "set_properties": {
      "description": "Sets document properties; omitted properties keep their values.",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_properties"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "company": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "title"
              ]
            },
            {
              "required": [
                "author"
              ]
            },
            {
              "required": [
                "subject"
              ]
            },
            {
              "required": [
                "keywords"
              ]
            },
            {
              "required": [
                "company"
              ]
            }
          ]
        }
      ]
    },
    "set_shape_style": {
      "description": "Styles one shape and every run of its text.",
      "type": "object",
      "required": [
        "op",
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_shape_style"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "shapeId": {
          "description": "The persistent slide-scoped shapeId returned by query slides; not a shape position.",
          "type": "integer",
          "minimum": 1
        },
        "shapeName": {
          "description": "The shape name, matched case-sensitively.",
          "type": "string",
          "pattern": "\\S"
        },
        "placeholder": {
          "description": "The placeholder role, as query slides reports it.",
          "type": "string",
          "enum": [
            "title",
            "body",
            "subtitle",
            "footer"
          ]
        },
        "style": {
          "$ref": "#/$defs/slidesShapeStyleInput"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "shapeId"
              ]
            },
            {
              "required": [
                "shapeName"
              ]
            },
            {
              "required": [
                "placeholder"
              ]
            }
          ]
        }
      ]
    },
    "set_slide_hidden": {
      "description": "Hides or shows slides in a slide show.",
      "type": "object",
      "required": [
        "op",
        "slides",
        "hidden"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_slide_hidden"
        },
        "slides": {
          "$ref": "#/$defs/pages"
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "set_slide_size": {
      "description": "Sets the slide size of the whole presentation.",
      "type": "object",
      "required": [
        "op",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_slide_size"
        },
        "size": {
          "description": "16x9, 4x3, or WxHpt such as 800x450pt; each side is 72 through 7200 points.",
          "type": "string",
          "pattern": "^(16x9|4x3|[0-9]+(?:\\.[0-9]+)?x[0-9]+(?:\\.[0-9]+)?pt)$"
        },
        "scaleContent": {
          "description": "Whether the content is scaled to fit the new size rather than kept at its position.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "set_table_cell": {
      "description": "Sets the text of one cell of a table shape.",
      "type": "object",
      "required": [
        "op",
        "row",
        "col",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_table_cell"
        },
        "slide": {
          "description": "The 1-based slide number.",
          "type": "integer",
          "minimum": 1
        },
        "slideId": {
          "description": "The stable slide id reported by inspect and query slides.",
          "type": "integer",
          "minimum": 1
        },
        "shapeId": {
          "description": "The persistent slide-scoped shapeId returned by query slides; not a shape position.",
          "type": "integer",
          "minimum": 1
        },
        "shapeName": {
          "description": "The shape name, matched case-sensitively.",
          "type": "string",
          "pattern": "\\S"
        },
        "placeholder": {
          "description": "The placeholder role, as query slides reports it.",
          "type": "string",
          "enum": [
            "title",
            "body",
            "subtitle",
            "footer"
          ]
        },
        "row": {
          "description": "The 1-based row.",
          "type": "integer",
          "minimum": 1
        },
        "col": {
          "description": "The 1-based column.",
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "slide"
              ]
            },
            {
              "required": [
                "slideId"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "shapeId"
              ]
            },
            {
              "required": [
                "shapeName"
              ]
            },
            {
              "required": [
                "placeholder"
              ]
            }
          ]
        }
      ]
    },
    "set_text": {
