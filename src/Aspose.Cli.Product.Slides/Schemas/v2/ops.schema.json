    "set_transition": {
      "description": "Sets the slide-show transition of slides.",
      "type": "object",
      "required": [
        "op",
        "slides"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_transition"
        },
        "slides": {
          "$ref": "#/$defs/pages"
        },
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "fade",
            "push",
            "wipe",
            "split",
            "cover"
          ]
        },
        "durationMs": {
          "description": "The transition duration in milliseconds.",
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
