{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/slides/ops.schema.json",
  "type": "object",
  "required": ["ops"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/slides/ops.schema.json" },
    "schemaVersion": { "const": 2 },
    "ifMatch": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/addSlide" },
          { "$ref": "#/$defs/deleteSlides" },
          { "$ref": "#/$defs/moveSlide" },
          { "$ref": "#/$defs/duplicateSlide" },
          { "$ref": "#/$defs/setSlideHidden" },
          { "$ref": "#/$defs/applyLayout" },
          { "$ref": "#/$defs/setBackground" },
          { "$ref": "#/$defs/addSection" },
          { "$ref": "#/$defs/appendPresentation" },
          { "$ref": "#/$defs/setTitle" },
          { "$ref": "#/$defs/setBody" },
          { "$ref": "#/$defs/setText" },
          { "$ref": "#/$defs/replaceText" },
          { "$ref": "#/$defs/setNotes" },
          { "$ref": "#/$defs/insertImage" },
          { "$ref": "#/$defs/insertShape" },
          { "$ref": "#/$defs/insertTable" },
          { "$ref": "#/$defs/setTableCell" },
          { "$ref": "#/$defs/insertChart" },
          { "$ref": "#/$defs/updateChartData" },
          { "$ref": "#/$defs/deleteShape" },
          { "$ref": "#/$defs/setShapeStyle" },
          { "$ref": "#/$defs/setFooter" },
          { "$ref": "#/$defs/setTransition" },
          { "$ref": "#/$defs/setProperties" },
          { "$ref": "#/$defs/setSlideSize" }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
    "slide": { "type": "integer", "minimum": 1 },
    "slideId": { "type": "integer", "minimum": 1 },
    "slides": { "type": "string", "minLength": 1 },
    "shape": { "type": "integer", "minimum": 1 },
    "placeholder": { "enum": ["title", "body", "subtitle", "footer"] },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "style": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "fill": { "$ref": "#/$defs/color" },
        "line": { "$ref": "#/$defs/color" },
        "font": { "type": "string" },
        "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 400 },
        "color": { "$ref": "#/$defs/color" },
        "bold": { "type": "boolean" }
      }
    },
    "series": {
      "type": "object",
      "required": ["name", "values"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "values": { "type": "array", "minItems": 1, "items": { "type": "number" } },
        "xValues": { "type": "array", "minItems": 1, "items": { "type": "number" } }
      }
    },
    "addSlide": {
      "type": "object", "required": ["op"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "add_slide" }, "layout": { "type": "string" }, "at": { "$ref": "#/$defs/slide" } }
    },
    "deleteSlides": {
      "type": "object", "required": ["op", "slides"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "delete_slides" }, "slides": { "$ref": "#/$defs/slides" } }
    },
    "moveSlide": {
      "type": "object", "required": ["op", "to"], "additionalProperties": false,
      "oneOf": [{ "required": ["slide"] }, { "required": ["slideId"] }],
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "move_slide" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" }, "to": { "$ref": "#/$defs/slide" } }
    },
    "duplicateSlide": {
      "type": "object", "required": ["op"], "additionalProperties": false,
      "oneOf": [{ "required": ["slide"] }, { "required": ["slideId"] }],
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "duplicate_slide" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" }, "at": { "$ref": "#/$defs/slide" } }
    },
    "setSlideHidden": {
      "type": "object", "required": ["op", "slides", "hidden"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_slide_hidden" }, "slides": { "$ref": "#/$defs/slides" }, "hidden": { "type": "boolean" } }
    },
    "applyLayout": {
      "type": "object", "required": ["op", "slides", "layout"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "apply_layout" }, "slides": { "$ref": "#/$defs/slides" }, "layout": { "type": "string", "minLength": 1 } }
    },
    "setBackground": {
      "type": "object", "required": ["op"], "additionalProperties": false,
      "oneOf": [{ "required": ["color"] }, { "required": ["imagePath"] }],
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_background" }, "slides": { "$ref": "#/$defs/slides" }, "color": { "$ref": "#/$defs/color" }, "imagePath": { "type": "string", "minLength": 1 } }
    },
    "addSection": {
      "type": "object", "required": ["op", "name", "atSlide"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "add_section" }, "name": { "type": "string", "minLength": 1 }, "atSlide": { "$ref": "#/$defs/slide" } }
    },
    "appendPresentation": {
      "type": "object", "required": ["op", "path"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "append_presentation" }, "path": { "type": "string", "minLength": 1 }, "masterPolicy": { "enum": ["keep-source", "use-dest"], "default": "keep-source" } }
    },
    "setTitle": {
      "type": "object", "required": ["op", "text"], "additionalProperties": false,
      "oneOf": [{ "required": ["slide"] }, { "required": ["slideId"] }],
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_title" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" }, "text": { "type": "string" } }
    },
    "setBody": {
      "type": "object", "required": ["op", "paragraphs"], "additionalProperties": false,
      "oneOf": [{ "required": ["slide"] }, { "required": ["slideId"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_body" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" },
        "paragraphs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["text"], "additionalProperties": false,
            "properties": { "text": { "type": "string" }, "level": { "type": "integer", "minimum": 0, "maximum": 8, "default": 0 } }
          }
        }
      }
    },
    "setText": {
      "type": "object", "required": ["op", "text"], "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/slideAndShapeChoice" }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_text" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" },
        "shape": { "$ref": "#/$defs/shape" }, "shapeName": { "type": "string" }, "placeholder": { "$ref": "#/$defs/placeholder" }, "text": { "type": "string" }
      }
    },
    "replaceText": {
      "type": "object", "required": ["op", "find", "replace"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "replace_text" }, "find": { "type": "string", "minLength": 1 }, "replace": { "type": "string" },
        "regex": { "type": "boolean", "default": false }, "matchCase": { "type": "boolean", "default": false },
        "scope": { "enum": ["shapes", "notes", "all"], "default": "all" }
      }
    },
    "setNotes": {
      "type": "object", "required": ["op", "text"], "additionalProperties": false,
      "oneOf": [{ "required": ["slide"] }, { "required": ["slideId"] }],
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_notes" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" }, "text": { "type": "string" } }
    },
    "insertImage": {
      "type": "object", "required": ["op", "path"], "additionalProperties": false,
      "oneOf": [{ "required": ["slide"] }, { "required": ["slideId"] }],
      "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_image" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" }, "path": { "type": "string", "minLength": 1 }, "rect": { "$ref": "#/$defs/rect" } }
    },
    "insertShape": {
      "type": "object", "required": ["op", "kind", "rect"], "additionalProperties": false,
      "oneOf": [{ "required": ["slide"] }, { "required": ["slideId"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_shape" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" },
        "kind": { "enum": ["rectangle", "rounded-rectangle", "ellipse", "line", "chevron"] }, "rect": { "$ref": "#/$defs/rect" },
        "text": { "type": "string" }, "style": { "$ref": "#/$defs/style" }
      }
    },
    "insertTable": {
      "type": "object", "required": ["op", "rect", "rows", "cols"], "additionalProperties": false,
      "oneOf": [{ "required": ["slide"] }, { "required": ["slideId"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_table" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" },
        "rect": { "$ref": "#/$defs/rect" }, "rows": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cols": { "type": "integer", "minimum": 1, "maximum": 50 },
        "data": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "setTableCell": {
      "type": "object", "required": ["op", "row", "col", "text"], "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/slideAndShapeChoice" }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_table_cell" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" },
        "shape": { "$ref": "#/$defs/shape" }, "shapeName": { "type": "string" }, "placeholder": { "$ref": "#/$defs/placeholder" },
        "row": { "type": "integer", "minimum": 1 }, "col": { "type": "integer", "minimum": 1 }, "text": { "type": "string" }
      }
    },
    "insertChart": {
      "type": "object", "required": ["op", "kind", "rect", "categories", "series"], "additionalProperties": false,
      "oneOf": [{ "required": ["slide"] }, { "required": ["slideId"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_chart" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" },
        "kind": { "enum": ["bar", "column", "line", "pie", "scatter"] }, "rect": { "$ref": "#/$defs/rect" },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "series": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/series" } }, "title": { "type": "string" }
      }
    },
    "updateChartData": {
      "type": "object", "required": ["op"], "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/slideAndShapeChoice" }],
      "anyOf": [{ "required": ["categories"] }, { "required": ["series"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "update_chart_data" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" },
        "shape": { "$ref": "#/$defs/shape" }, "shapeName": { "type": "string" }, "placeholder": { "$ref": "#/$defs/placeholder" },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "series": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/series" } }
      }
    },
    "deleteShape": {
      "type": "object", "required": ["op"], "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/slideAndShapeChoice" }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "delete_shape" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" },
        "shape": { "$ref": "#/$defs/shape" }, "shapeName": { "type": "string" }, "placeholder": { "$ref": "#/$defs/placeholder" }
      }
    },
    "setShapeStyle": {
      "type": "object", "required": ["op", "style"], "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/slideAndShapeChoice" }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_shape_style" }, "slide": { "$ref": "#/$defs/slide" }, "slideId": { "$ref": "#/$defs/slideId" },
        "shape": { "$ref": "#/$defs/shape" }, "shapeName": { "type": "string" }, "placeholder": { "$ref": "#/$defs/placeholder" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "setFooter": {
      "type": "object", "required": ["op"], "additionalProperties": false,
      "anyOf": [{ "required": ["text"] }, { "required": ["showNumber"] }, { "required": ["showDate"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_footer" }, "slides": { "$ref": "#/$defs/slides" }, "text": { "type": "string" },
        "showNumber": { "type": "boolean" }, "showDate": { "type": "boolean" }
      }
    },
    "setTransition": {
      "type": "object", "required": ["op", "slides"], "additionalProperties": false,
      "anyOf": [{ "required": ["kind"] }, { "required": ["durationMs"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_transition" }, "slides": { "$ref": "#/$defs/slides" },
        "kind": { "enum": ["none", "fade", "push", "wipe", "split", "cover"] },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "setProperties": {
      "type": "object", "required": ["op"], "additionalProperties": false,
      "anyOf": [
        { "required": ["title"] }, { "required": ["author"] }, { "required": ["subject"] },
        { "required": ["keywords"] }, { "required": ["company"] }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_properties" }, "title": { "type": "string" }, "author": { "type": "string" },
        "subject": { "type": "string" }, "keywords": { "type": "string" }, "company": { "type": "string" }
      }
    },
    "setSlideSize": {
      "type": "object", "required": ["op", "size"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_slide_size" }, "size": { "type": "string", "pattern": "^(16x9|4x3|[0-9]+(?:\\.[0-9]+)?x[0-9]+(?:\\.[0-9]+)?pt)$" },
        "scaleContent": { "type": "boolean", "default": true }
      }
    },
    "slideAndShapeChoice": {
      "allOf": [
        { "oneOf": [{ "required": ["slide"] }, { "required": ["slideId"] }] },
        { "oneOf": [{ "required": ["shape"] }, { "required": ["shapeName"] }, { "required": ["placeholder"] }] }
      ]
    }
  }
}
