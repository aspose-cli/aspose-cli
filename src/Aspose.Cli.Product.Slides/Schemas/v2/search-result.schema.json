{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/slides/search-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "source", "pattern", "scope", "hits", "window"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/slides/search-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "source": { "type": "object" },
    "pattern": { "type": "string" },
    "scope": { "enum": ["shapes", "notes", "all"] },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide", "slideId", "scope", "text", "start", "length"],
        "additionalProperties": false,
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "slideId": { "type": "integer", "minimum": 1 },
          "scope": { "enum": ["shapes", "notes"] },
          "shapeId": { "type": "integer", "minimum": 1, "description": "Positive persistent identifier within the hit slide." },
          "shapeName": { "type": "string" },
          "text": { "type": "string" },
          "start": { "type": "integer", "minimum": 0 },
          "length": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "window": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/result-window.schema.json" },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
