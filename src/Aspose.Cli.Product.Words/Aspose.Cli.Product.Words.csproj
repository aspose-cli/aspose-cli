<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Aspose.Cli.Sdk\build\Aspose.Cli.Sdk.props" />
  <PropertyGroup>
    <Description>Autonomous Words product module with contracts, commands, preview, resources and Aspose.Words adapter.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aspose.Cli.Sdk\Aspose.Cli.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspose.Words" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
  <ItemGroup>
    <!-- The design every new document starts from when no template is given. -->
    <EmbeddedResource Include="Engine\Templates\default-a4.docx" LogicalName="Templates/default-a4.docx" />
  </ItemGroup>
  <ItemGroup>
    <!-- The ops schema is generated from the operation records and served from them; the
         committed copy is for review and external readers, and a contract test keeps it current. -->
    <EmbeddedResource Remove="$(MSBuildProjectDirectory)\Schemas\v2\ops.schema.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aspose.Cli.Product.Words.Tests" />
  </ItemGroup>
</Project>
