{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/words/document-info.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "source", "document"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/words/document-info.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "document" },
    "source": { "type": "object" },
    "document": {
      "type": "object",
      "required": ["sectionCount", "blockCount", "paragraphCount", "tableCount", "pageCount", "wordCount", "revisionsPresent", "revisionCount", "revisionAuthors", "commentCount", "protection", "signed", "hasMacros"],
      "additionalProperties": false,
      "properties": {
        "sectionCount": { "type": "integer", "minimum": 0 },
        "blockCount": { "type": "integer", "minimum": 0 },
        "paragraphCount": { "type": "integer", "minimum": 0 },
        "tableCount": { "type": "integer", "minimum": 0 },
        "pageCount": { "type": "integer", "minimum": 0 },
        "wordCount": { "type": "integer", "minimum": 0 },
        "revisionsPresent": { "type": "boolean" },
        "revisionCount": { "type": "integer", "minimum": 0 },
        "revisionAuthors": { "type": "array", "items": { "type": "string" } },
        "commentCount": { "type": "integer", "minimum": 0, "description": "The comments in the document, replies included; list them with --detail comments." },
        "protection": { "enum": ["none", "readOnly", "comments", "trackedChanges", "forms"], "description": "The editing restriction: none, or the protect operation mode that sets it; every SDK protection type maps to one of these." },
        "signed": { "type": "boolean" },
        "hasMacros": { "type": "boolean", "description": "Whether the document holds macros (a VBA project); an output other than docm, dotm, doc, dot or wordml drops them and reports MACROS_DROPPED." }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "orientation", "widthPoints", "heightPoints", "margins"],
        "additionalProperties": false,
        "properties": {
          "section": { "type": "integer", "minimum": 1, "description": "The 1-based section number that section operations accept." },
          "orientation": { "enum": ["portrait", "landscape"] },
          "widthPoints": { "type": "number", "minimum": 0 },
          "heightPoints": { "type": "number", "minimum": 0 },
          "margins": {
            "type": "object",
            "required": ["top", "right", "bottom", "left"],
            "additionalProperties": false,
            "description": "Page margins in points.",
            "properties": {
              "top": { "type": "number" },
              "right": { "type": "number" },
              "bottom": { "type": "number" },
              "left": { "type": "number" }
            }
          }
        }
      }
    },
    "outline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block", "headingLevel", "text"],
        "additionalProperties": false,
        "properties": {
          "block": { "type": "integer", "minimum": 1 },
          "headingLevel": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" }
        }
      }
    },
    "styles": { "type": "array", "items": { "type": "string" } },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "scope"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string" },
          "scope": { "enum": ["body", "headersFooters", "footnotes", "comments"], "description": "The story that holds the field, named as query search names its scopes." },
          "block": { "type": "integer", "minimum": 1, "description": "The body block that holds the field, or that anchors the comment or note holding it; absent in headers and footers." },
          "code": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "bookmarks": { "type": "array", "items": { "type": "string" } },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["author", "text"],
        "additionalProperties": false,
        "properties": {
          "author": { "type": "string" },
          "text": { "type": "string" },
          "block": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "revisions": {
      "type": "array",
      "description": "The tracked changes in document order, one entry per change. A replacement is a deletion followed by an insertion. document.revisionCount counts the revisions the document stores, one per run, paragraph mark or other changed node, so it can exceed the entries here.",
      "items": {
        "type": "object",
        "required": ["type", "author"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["insertion", "deletion", "formatChange", "styleDefinitionChange", "moving"] },
          "author": { "type": "string" },
          "date": { "type": "string", "description": "The date and time the document records, as ISO 8601 yyyy-MM-ddTHH:mm:ss without a time zone; absent when none is recorded." },
          "scope": { "enum": ["body", "headersFooters", "footnotes", "comments"], "description": "The story that holds the change, named as query search names its scopes; absent for style definition changes." },
          "block": { "type": "integer", "minimum": 1, "description": "The body block that holds the change, or that anchors the comment or note holding it; absent in headers and footers and for style definition changes." },
          "text": { "type": "string", "description": "The text an insertion adds, a deletion removes or a move relocates; a longer text is cut to 300 characters and an ellipsis; absent for format and style definition changes." }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "width", "height"],
        "additionalProperties": false,
        "properties": {
          "scope": { "enum": ["body", "headersFooters", "footnotes", "comments"], "description": "The story that holds the image, named as query search names its scopes." },
          "block": { "type": "integer", "minimum": 1, "description": "The body block that holds the image, or that anchors the comment or note holding it; absent in headers and footers." },
          "name": { "type": "string" },
          "width": { "type": "number", "minimum": 0, "description": "The width in points." },
          "height": { "type": "number", "minimum": 0, "description": "The height in points." }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block", "rowCount", "columnCount"],
        "additionalProperties": false,
        "properties": {
          "block": { "type": "integer", "minimum": 1 },
          "rowCount": { "type": "integer", "minimum": 0 },
          "columnCount": { "type": "integer", "minimum": 0 },
          "style": { "type": "string", "minLength": 1, "description": "The table style the table uses, accepted by insert_table's style; omitted for the default Table Normal style." }
        }
      }
    },
    "properties": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "fonts": { "type": "array", "items": { "type": "string" }, "description": "The fonts the document's text is drawn with, per character script; not the font table." },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
