{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/words/edit-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "dryRun", "applied"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/words/edit-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "type": "object" },
    "output": { "type": "object" },
    "dryRun": { "type": "boolean" },
    "applied": {
      "type": "array",
      "items": { "$ref": "https://schemas.aspose.dev/aspose-cli/v2/common/operation-outcome.schema.json" }
    },
    "backup": { "type": "object" },
    "pagesTouched": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "verification": {
      "type": "object",
      "required": ["ok", "issues"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } },
        "semanticChangesDetected": { "type": "boolean" },
        "fieldCount": { "type": "integer", "minimum": 0 },
        "revisionCount": { "type": "integer", "minimum": 0 },
        "protection": { "type": "string" }
      }
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
