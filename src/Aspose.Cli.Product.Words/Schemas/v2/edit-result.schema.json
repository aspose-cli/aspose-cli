{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/words/edit-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "dryRun", "applied"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/words/edit-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "type": "object" },
    "output": { "type": "object" },
    "dryRun": { "type": "boolean" },
    "applied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "index", "op", "status", "itemsAffected", "targets"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
          "index": { "type": "integer", "minimum": 0 },
          "op": { "type": "string" },
          "status": { "enum": ["ok", "failed"] },
          "itemsAffected": { "type": "integer", "minimum": 0 },
          "targets": { "type": "array", "maxItems": 100, "items": { "type": "string" } },
          "error": {
            "type": "object",
            "required": ["code", "message", "hint"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "hint": { "type": "string" }
            }
          }
        }
      }
    },
    "backup": { "type": "object" },
    "pagesTouched": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "verification": {
      "type": "object",
      "required": ["ok", "visualReviewRequired", "readBackBlocks", "renders", "issues"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "visualReviewRequired": { "type": "boolean" },
        "readBackBlocks": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "renders": { "type": "array", "items": { "type": "object" } },
        "issues": { "type": "array", "items": { "type": "string" } },
        "semanticChangesDetected": { "type": "boolean" },
        "fieldCount": { "type": "integer", "minimum": 0 },
        "revisionCount": { "type": "integer", "minimum": 0 },
        "protection": { "type": "string" }
      }
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
