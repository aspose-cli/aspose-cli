{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/words/edit-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "dryRun", "applied"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/words/edit-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "type": "object" },
    "output": { "type": "object" },
    "dryRun": { "type": "boolean" },
    "applied": {
      "type": "array",
      "items": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/operation-outcome.schema.json" }
    },
    "backup": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/backup.schema.json" },
    "pagesTouched": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true, "description": "The output pages the batch changed: those of the blocks and sections the operations addressed or inserted, of replaced text, and of the content that took the place of removed blocks. An operation whose only target is document can change any page." },
    "verification": {
      "type": "object",
      "required": ["ok", "issues"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/verification-issue.schema.json" }
        },
        "semanticChangesDetected": { "type": "boolean" },
        "fieldCount": { "type": "integer", "minimum": 0 },
        "revisionCount": { "type": "integer", "minimum": 0 },
        "protection": { "enum": ["none", "readOnly", "comments", "trackedChanges", "forms"], "description": "The editing restriction: none, or the protect operation mode that sets it; every SDK protection type maps to one of these." }
      }
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
