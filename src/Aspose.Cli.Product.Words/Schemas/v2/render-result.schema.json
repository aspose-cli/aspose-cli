{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/words/render-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/words/render-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "type": "object" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page", "output"],
        "additionalProperties": false,
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "output": { "type": "object" }
        }
      }
    },
    "dpi": { "type": "integer", "minimum": 1 },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
