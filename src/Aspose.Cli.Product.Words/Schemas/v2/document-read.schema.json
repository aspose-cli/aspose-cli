{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/words/document-read.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "source", "scope", "blockCount", "blocks", "window"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/words/document-read.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "document" },
    "source": { "type": "object" },
    "scope": { "enum": ["text", "full", "outline"] },
    "blockCount": { "type": "integer", "minimum": 0, "description": "The document's block count, whatever the range, section and scope select." },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["i", "type", "section", "contentTruncated"],
        "additionalProperties": false,
        "properties": {
          "i": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["paragraph", "table"] },
          "section": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "style": { "type": "string" },
          "headingLevel": { "type": "integer", "minimum": 1 },
          "runs": { "type": "array", "items": { "type": "object" } },
          "images": { "type": "array", "items": { "type": "object" } },
          "breakAfter": { "enum": ["page", "section"], "description": "The break that follows this block: a page break, or a section break after the last block of a section." },
          "rows": { "type": "integer", "minimum": 0 },
          "columns": { "type": "integer", "minimum": 0 },
          "cells": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "contentTruncated": { "type": "boolean", "description": "Returned document text shares the max-chars budget, including repeated projections. Re-read this item with a larger budget for omitted content." }
        }
      }
    },
    "window": { "$ref": "https://schemas.aspose.dev/aspose-cli/v2/common/result-window.schema.json", "description": "Counts blocks; total is the blocks the range, section and scope select. next starts again at a block whose content was truncated and doubles --max-chars when that block alone exceeded the budget." },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
