{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/words/document-read.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "source", "scope", "blockCount", "blocks", "window"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/words/document-read.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "document" },
    "source": { "type": "object" },
    "scope": { "enum": ["text", "full", "outline"] },
    "blockCount": { "type": "integer", "minimum": 0, "description": "The document's block count, whatever the range, section and scope select." },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block", "type", "section", "contentTruncated"],
        "additionalProperties": false,
        "properties": {
          "block": { "type": "integer", "minimum": 1, "description": "The 1-based block number that operation block addresses accept." },
          "type": { "enum": ["paragraph", "table"] },
          "section": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "style": { "type": "string" },
          "headingLevel": { "type": "integer", "minimum": 1 },
          "runs": {
            "type": "array",
            "description": "The runs of the visible text, in order: their text joins to the paragraph's text, without field codes, deleted text or anchored comments and footnotes.",
            "items": {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string" },
                "font": { "type": "string" },
                "size": { "type": "number", "description": "The font size in points." },
                "bold": { "type": "boolean" },
                "italic": { "type": "boolean" },
                "color": { "type": "string", "description": "A #RRGGBB color." }
              }
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["block", "width", "height"],
              "additionalProperties": false,
              "properties": {
                "block": { "type": "integer", "minimum": 1 },
                "name": { "type": "string" },
                "width": { "type": "number", "minimum": 0, "description": "The width in points." },
                "height": { "type": "number", "minimum": 0, "description": "The height in points." }
              }
            }
          },
          "breakAfter": { "enum": ["page", "section"], "description": "The break that follows this block: a page break, or a section break after the last block of a section." },
          "rowCount": { "type": "integer", "minimum": 0 },
          "columnCount": { "type": "integer", "minimum": 0 },
          "cells": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "contentTruncated": { "type": "boolean", "description": "Returned document text shares the max-chars budget, including repeated projections. Re-read this item with a larger budget for omitted content." }
        }
      }
    },
    "window": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/result-window.schema.json", "description": "Counts blocks; total is the blocks the range, section and scope select. next starts again at a block whose content was truncated and doubles --max-chars when that block alone exceeded the budget." },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
