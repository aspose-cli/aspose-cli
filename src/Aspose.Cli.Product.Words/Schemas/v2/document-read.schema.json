{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/words/document-read.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "source", "scope", "window", "blocks"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/words/document-read.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "document" },
    "source": { "type": "object" },
    "scope": { "enum": ["text", "full", "outline"] },
    "window": {
      "type": "object",
      "required": ["blocks", "of", "truncated"],
      "additionalProperties": false,
      "properties": {
        "blocks": { "type": "string" },
        "of": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean", "description": "True if content within a returned item or later selected items was omitted." }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["i", "type", "section", "contentTruncated"],
        "additionalProperties": false,
        "properties": {
          "i": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["paragraph", "table"] },
          "section": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "style": { "type": "string" },
          "headingLevel": { "type": "integer", "minimum": 1 },
          "runs": { "type": "array", "items": { "type": "object" } },
          "images": { "type": "array", "items": { "type": "object" } },
          "breakAfter": { "type": "string" },
          "rows": { "type": "integer", "minimum": 0 },
          "columns": { "type": "integer", "minimum": 0 },
          "cells": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "contentTruncated": { "type": "boolean", "description": "Returned document text shares the max-chars budget, including repeated projections. Re-read this item with a larger budget for omitted content." }
        }
      }
    },
    "next": { "type": "string", "description": "Command for unread items; does not resume within an item whose contentTruncated is true." },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
