{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/words/search-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "source", "pattern", "hits", "window"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/words/search-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "source": { "type": "object" },
    "pattern": { "type": "string" },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block", "section", "scope", "snippet"],
        "additionalProperties": false,
        "properties": {
          "block": { "type": "integer", "minimum": 0 },
          "section": { "type": "integer", "minimum": 0 },
          "scope": { "enum": ["body", "headersFooters", "footnotes", "comments"] },
          "snippet": { "type": "string" }
        }
      }
    },
    "window": { "$ref": "https://schemas.aspose.dev/aspose-cli/v2/common/result-window.schema.json" },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
