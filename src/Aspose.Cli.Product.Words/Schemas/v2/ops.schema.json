          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "custom": {
          "description": "Custom properties by name; a null value removes the property.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "set_style": {
      "description": "Applies an existing paragraph style to target blocks.",
      "type": "object",
      "required": [
        "op",
        "target",
