{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/words/ops.schema.json",
  "title": "Words edit operation batch",
  "type": "object",
  "required": ["ops"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/words/ops.schema.json" },
    "schemaVersion": { "const": 2 },
    "ifMatch": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/op" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block": { "type": "integer", "minimum": 1 },
        "blocks": { "type": "string", "minLength": 1 },
        "bookmark": { "type": "string", "minLength": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "find": { "type": "string", "minLength": 1 },
        "nth": { "type": "integer", "minimum": 1 }
      },
      "oneOf": [
        { "required": ["block"] },
        { "required": ["blocks"] },
        { "required": ["bookmark"] },
        { "required": ["heading"] },
        { "required": ["find"] }
      ]
    },
    "position": { "enum": ["before", "after"] },
    "paragraph": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "style": { "type": "string", "minLength": 1 },
        "listLevel": { "type": "integer", "minimum": 0, "maximum": 8, "description": "Makes the paragraph a list item at this level: in the anchor's list when the anchor is a list item, otherwise in one new bullet list." }
      }
    },
    "margins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "type": "number", "minimum": 0 },
        "right": { "type": "number", "minimum": 0 },
        "bottom": { "type": "number", "minimum": 0 },
        "left": { "type": "number", "minimum": 0 }
      }
    },
    "pageSetup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "enum": ["a3", "a4", "a5", "letter", "legal"] },
        "orientation": { "enum": ["portrait", "landscape"] },
        "margins": { "$ref": "#/$defs/margins" },
        "columns": { "type": "integer", "minimum": 1 }
      }
    },
    "op": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "find", "replace"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "replace_text" },
            "find": { "type": "string", "minLength": 1 },
            "replace": { "type": "string", "description": "With regex, .NET substitutions such as $1 and ${name} apply; write $$ for a literal $." },
            "regex": { "type": "boolean" },
            "matchCase": { "type": "boolean" },
            "wholeWord": { "type": "boolean" },
            "scope": { "enum": ["body", "headersFooters", "comments", "all"] },
            "maxReplacements": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "text"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_text" },
            "at": { "$ref": "#/$defs/target" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "position", "paragraphs"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_paragraphs" },
            "at": { "$ref": "#/$defs/target" },
            "position": { "$ref": "#/$defs/position" },
            "paragraphs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/paragraph" } }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "position", "markdown"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_markdown" },
            "at": { "$ref": "#/$defs/target" },
            "position": { "$ref": "#/$defs/position" },
            "markdown": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "target"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "delete_blocks" },
            "target": { "$ref": "#/$defs/target" }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "position", "kind"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_break" },
            "at": { "$ref": "#/$defs/target" },
            "position": { "$ref": "#/$defs/position" },
            "kind": { "enum": ["page", "section"] }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "position", "path"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_image" },
            "at": { "$ref": "#/$defs/target" },
            "position": { "$ref": "#/$defs/position" },
            "path": { "type": "string", "minLength": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "inline": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "position", "rows", "cols"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_table" },
            "at": { "$ref": "#/$defs/target" },
            "position": { "$ref": "#/$defs/position" },
            "rows": { "type": "integer", "minimum": 1, "maximum": 32767 },
            "cols": { "type": "integer", "minimum": 1, "maximum": 63 },
            "data": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "string" } }
            },
            "style": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "row", "col", "text"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_table_cell" },
            "at": { "$ref": "#/$defs/target" },
            "row": { "type": "integer", "minimum": 1 },
            "col": { "type": "integer", "minimum": 1 },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "position"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_toc" },
            "at": { "$ref": "#/$defs/target" },
            "position": { "$ref": "#/$defs/position" },
            "maxLevel": { "type": "integer", "minimum": 1, "maximum": 9 }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "name"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_bookmark" },
            "at": { "$ref": "#/$defs/target" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "position", "text", "url"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_hyperlink" },
            "at": { "$ref": "#/$defs/target" },
            "position": { "$ref": "#/$defs/position" },
            "text": { "type": "string" },
            "url": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "position", "code"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "insert_field" },
            "at": { "$ref": "#/$defs/target" },
            "position": { "$ref": "#/$defs/position" },
            "code": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "add_section" },
            "position": { "enum": ["start", "end", "after"] },
            "after": { "type": "integer", "minimum": 1 },
            "pageSetup": { "$ref": "#/$defs/pageSetup" }
          },
          "if": { "required": ["position"], "properties": { "position": { "const": "after" } } },
          "then": { "required": ["after"] },
          "else": { "not": { "required": ["after"] } }
        },
        {
          "type": "object",
          "required": ["op", "section"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "delete_section" },
            "section": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op", "setup"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_page_setup" },
            "section": { "type": "integer", "minimum": 1 },
            "setup": { "$ref": "#/$defs/pageSetup" }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_header" },
            "section": { "type": "integer", "minimum": 1 },
            "kind": { "enum": ["primary", "first", "even"] },
            "paragraphs": { "type": "array", "items": { "type": "string" } },
            "markdown": { "type": "string" }
          },
          "oneOf": [{ "required": ["paragraphs"] }, { "required": ["markdown"] }]
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_footer" },
            "section": { "type": "integer", "minimum": 1 },
            "kind": { "enum": ["primary", "first", "even"] },
            "paragraphs": { "type": "array", "items": { "type": "string" } },
            "markdown": { "type": "string" }
          },
          "oneOf": [{ "required": ["paragraphs"] }, { "required": ["markdown"] }]
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_page_numbers" },
            "section": { "type": "integer", "minimum": 1 },
            "location": { "enum": ["header", "footer"] },
            "alignment": { "enum": ["left", "center", "right"] },
            "format": { "enum": ["decimal", "upperRoman", "lowerRoman", "upperLetter", "lowerLetter"] },
            "start": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["op", "target"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "format_text" },
            "target": { "$ref": "#/$defs/target" },
            "bold": { "type": "boolean" },
            "italic": { "type": "boolean" },
            "underline": { "type": "boolean" },
            "size": { "type": "number", "exclusiveMinimum": 0 },
            "color": { "type": "string" },
            "font": { "type": "string", "minLength": 1 },
            "highlight": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "target", "style"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_style" },
            "target": { "$ref": "#/$defs/target" },
            "style": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op", "name"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "define_style" },
            "name": { "type": "string", "minLength": 1 },
            "basedOn": { "type": "string", "minLength": 1 },
            "font": { "type": "string", "minLength": 1 },
            "size": { "type": "number", "exclusiveMinimum": 0 },
            "bold": { "type": "boolean" },
            "color": { "type": "string" },
            "spaceBefore": { "type": "number", "minimum": 0 },
            "spaceAfter": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["op", "target", "kind"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "apply_list" },
            "target": { "$ref": "#/$defs/target" },
            "kind": { "enum": ["bullet", "number"] },
            "level": { "type": "integer", "minimum": 0, "maximum": 8 }
          }
        },
        {
          "type": "object",
          "required": ["op", "font"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_default_font" },
            "font": { "type": "string", "minLength": 1 },
            "size": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "set_properties" },
            "title": { "type": "string" },
            "author": { "type": "string" },
            "subject": { "type": "string" },
            "keywords": { "type": "string" },
            "custom": {
              "type": "object",
              "additionalProperties": { "type": ["string", "null"] }
            }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "add_watermark" },
            "text": { "type": "string", "minLength": 1, "maxLength": 200 },
            "imagePath": { "type": "string", "minLength": 1 },
            "faded": { "type": "boolean", "default": true, "description": "Semi-transparent text or a washed-out image." },
            "color": { "type": "string" }
          },
          "oneOf": [
            { "required": ["text"], "not": { "required": ["imagePath"] } },
            { "required": ["imagePath"], "not": { "anyOf": [{ "required": ["text"] }, { "required": ["color"] }] } }
          ]
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": { "id": { "$ref": "#/$defs/id" }, "op": { "const": "remove_watermark" } }
        },
        {
          "type": "object",
          "required": ["op", "mode"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "protect" },
            "mode": { "enum": ["readOnly", "comments", "trackedChanges", "forms"] },
            "passwordEnv": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "unprotect" },
            "passwordEnv": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "accept_revisions" },
            "author": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "reject_revisions" },
            "author": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op", "at", "author", "text"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "add_comment" },
            "at": { "$ref": "#/$defs/target" },
            "author": { "type": "string", "minLength": 1 },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "remove_comments" },
            "author": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["op", "path"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "append_document" },
            "path": { "type": "string", "minLength": 1 },
            "importFormatMode": { "enum": ["keepSource", "useDestination"] }
          }
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "mail_merge" },
            "path": { "type": "string", "minLength": 1 },
            "inline": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": { "type": ["string", "null"] }
              }
            },
            "regions": { "type": "boolean" }
          },
          "oneOf": [
            { "required": ["path"], "not": { "required": ["inline"] } },
            { "required": ["inline"], "not": { "required": ["path"] } }
          ]
        },
        {
          "type": "object",
          "required": ["op"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "op": { "const": "update_fields" },
            "what": { "enum": ["all", "toc"] }
          }
        }
      ]
    }
  }
}
