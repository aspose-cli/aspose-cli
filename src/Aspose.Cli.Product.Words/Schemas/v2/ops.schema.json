        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "col": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "set_text": {
      "description": "Replaces the inline content of paragraph blocks, or the text a bookmark encloses.",
      "type": "object",
      "required": [
        "op",
        "at",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "set_text"
        },
        "at": {
          "$ref": "#/$defs/wordsTarget"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "unprotect": {
      "description": "Removes document protection.",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "unprotect"
        },
        "passwordEnv": {
          "description": "The environment variable that holds the protection password.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "update_fields": {
      "description": "Updates the tables of contents, or every field and the page layout.",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "update_fields"
        },
        "what": {
          "type": "string",
          "enum": [
            "all",
            "toc"
          ],
          "default": "all"
        }
      }
    },
    "marginInput": {
      "description": "Page margins in points; omitted margins keep their values.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "number",
          "minimum": 0
        },
        "right": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        },
        "left": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "pageSetupInput": {
      "description": "Page size, orientation, margins and column settings; omitted settings keep their values.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string",
          "enum": [
            "a3",
            "a4",
            "a5",
            "letter",
            "legal"
          ]
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "margins": {
          "$ref": "#/$defs/marginInput"
        },
        "columnCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pages": {
      "type": "string",
      "description": "1-based pages and ranges separated by commas, such as 1-3,7,9-; a range with no end runs to the last page, and a range must not end before it starts.",
      "pattern": "^\\s*0*[1-9][0-9]*(-(0*[1-9][0-9]*)?)?(\\s*,\\s*0*[1-9][0-9]*(-(0*[1-9][0-9]*)?)?)*\\s*$"
    },
    "paragraphInput": {
      "description": "One paragraph supplied to an insertion operation.",
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "style": {
          "description": "An existing paragraph style.",
          "type": "string",
          "minLength": 1
        },
        "listLevel": {
          "description": "Makes the paragraph a list item at this level: in the anchor's list when the anchor is a list item, otherwise in one new bullet list.",
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "position": {
      "type": "string",
      "enum": [
        "before",
        "after"
      ]
    },
    "webLink": {
      "type": "string",
      "description": "An absolute http://, https:// or mailto: URL.",
      "format": "uri",
      "pattern": "^(http://|https://|mailto:)"
    },
    "wordsTarget": {
      "description": "A block address: exactly one of block, blocks, bookmark, heading or find.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block": {
          "description": "One canonical 1-based block.",
          "type": "integer",
          "minimum": 1
        },
        "blocks": {
          "description": "Canonical 1-based blocks and block ranges.",
          "$ref": "#/$defs/pages"
        },
        "bookmark": {
          "description": "A bookmark name.",
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "description": "Visible heading text, matched case-insensitively.",
          "type": "string",
          "minLength": 1
        },
        "find": {
          "description": "Visible text that locates a block, matched case-insensitively.",
          "type": "string",
          "minLength": 1
        },
        "nth": {
          "description": "The 1-based match of a heading or find address; the first when omitted.",
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "block"
              ]
            },
            {
              "required": [
                "blocks"
              ]
            },
            {
              "required": [
                "bookmark"
              ]
            },
            {
              "required": [
                "heading"
              ]
            },
            {
              "required": [
                "find"
              ]
            }
          ]
        }
      ]
    }
  }
}
