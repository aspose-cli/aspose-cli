<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Aspose.Cli.Sdk\build\Aspose.Cli.Sdk.props" />
  <PropertyGroup>
    <Description>Autonomous Cells product module with contracts, commands, preview, resources and Aspose.Cells adapter.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aspose.Cli.Sdk\Aspose.Cli.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspose.Cells" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aspose.Cli.Product.Cells.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The ops schema is generated from the operation records and served from them; the
         committed copy is for review and external readers, and a contract test keeps it current. -->
    <EmbeddedResource Remove="$(MSBuildProjectDirectory)\Schemas\v2\ops.schema.json" />
  </ItemGroup>
</Project>
