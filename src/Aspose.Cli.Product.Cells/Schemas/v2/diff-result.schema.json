{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/cells/diff-result.schema.json",
  "title": "Cells diff result",
  "description": "Result of `aspose-cli cells compare`: a structural comparison of two workbooks. The exit code is 0 even when they differ — the verdict is the `identical` flag, so compare can be used as a verifier.",
  "type": "object",
  "required": ["schema", "schemaVersion", "left", "right", "identical", "summary"],
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/cells/diff-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "left": { "$ref": "#/$defs/source" },
    "right": { "$ref": "#/$defs/source" },
    "identical": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["sheetsAdded", "sheetsRemoved", "sheetsRenamed", "sheetsModified", "cellsDiffering"],
      "properties": {
        "sheetsAdded": { "type": "integer", "minimum": 0 },
        "sheetsRemoved": { "type": "integer", "minimum": 0 },
        "sheetsRenamed": {
          "type": "integer",
          "minimum": 0,
          "description": "Sheets the right holds under a new name, paired with the left sheet by their internal sheet id."
        },
        "sheetsModified": { "type": "integer", "minimum": 0 },
        "cellsDiffering": {
          "type": "integer",
          "minimum": 0,
          "description": "Total differing cells across the workbook. The true count even when a LIST_TRUNCATED warning reports that --max-diffs capped the listed 'cells'."
        }
      }
    },
    "sheets": {
      "type": "array",
      "description": "Per-sheet differences; omitted when identical.",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["added", "removed", "modified", "renamed"] },
          "from": { "type": "string", "description": "The sheet's name on the left, for a renamed sheet." },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["cell"],
              "properties": {
                "cell": { "type": "string" },
                "left": { "$ref": "#/$defs/side" },
                "right": { "$ref": "#/$defs/side" }
              }
            }
          }
        }
      }
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["path", "format", "sizeBytes", "fingerprint"],
      "properties": {
        "path": { "type": "string" },
        "format": { "type": "string" },
        "sizeBytes": { "type": "integer" },
        "fingerprint": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/file-fingerprint.schema.json" }
      }
    },
    "side": {
      "type": "object",
      "description": "Canonical stored value and optional formula. Dates are raw numeric serials; an absent empty side is omitted.",
      "required": ["t"],
      "properties": {
        "t": { "enum": ["empty", "number", "string", "boolean", "error"] },
        "v": { "type": ["string", "number", "boolean", "null"] },
        "f": { "type": "string" }
      },
      "oneOf": [
        { "properties": { "t": { "const": "empty" }, "v": { "type": "null" } } },
        { "required": ["v"], "properties": { "t": { "const": "number" }, "v": { "type": "number" } } },
        { "required": ["v"], "properties": { "t": { "enum": ["string", "error"] }, "v": { "type": "string" } } },
        { "required": ["v"], "properties": { "t": { "const": "boolean" }, "v": { "type": "boolean" } } }
      ]
    }
  }
}
