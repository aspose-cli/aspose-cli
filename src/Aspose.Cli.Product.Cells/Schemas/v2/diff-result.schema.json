{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/cells/diff-result.schema.json",
  "title": "Cells diff result",
  "description": "Result of `aspose-cli cells compare`: a structural comparison of two workbooks. The exit code is 0 even when they differ — the verdict is the `identical` flag, so compare can be used as a verifier.",
  "type": "object",
  "required": ["schema", "schemaVersion", "left", "right", "identical", "summary"],
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/cells/diff-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "left": { "$ref": "#/$defs/source" },
    "right": { "$ref": "#/$defs/source" },
    "identical": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["sheetsAdded", "sheetsRemoved", "sheetsModified", "cellsDiffering"],
      "properties": {
        "sheetsAdded": { "type": "integer", "minimum": 0 },
        "sheetsRemoved": { "type": "integer", "minimum": 0 },
        "sheetsModified": { "type": "integer", "minimum": 0 },
        "cellsDiffering": {
          "type": "integer",
          "minimum": 0,
          "description": "Total differing cells across the workbook. The true count even when 'truncated' is set — the --max-diffs cap bounds the listed 'cells', not this total."
        }
      }
    },
    "sheets": {
      "type": "array",
      "description": "Per-sheet differences; omitted when identical.",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["added", "removed", "modified"] },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["cell"],
              "properties": {
                "cell": { "type": "string" },
                "left": { "$ref": "#/$defs/side" },
                "right": { "$ref": "#/$defs/side" }
              }
            }
          }
        }
      }
    },
    "truncated": {
      "type": "boolean",
      "description": "True when more cells differ than --max-diffs listed; summary.cellsDiffering still reports the full count."
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["path", "format", "sizeBytes", "fingerprint"],
      "properties": {
        "path": { "type": "string" },
        "format": { "type": "string" },
        "sizeBytes": { "type": "integer" },
        "fingerprint": { "$ref": "https://schemas.aspose.dev/aspose-cli/v2/common/file-fingerprint.schema.json" }
      }
    },
    "side": {
      "type": "object",
      "description": "A cell value and, in scope, its formula. Absent when the cell is empty on that side.",
      "properties": {
        "v": { "type": ["string", "number", "boolean", "null"] },
        "f": { "type": "string" }
      }
    }
  }
}
