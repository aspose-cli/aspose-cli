{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/cells/create-result.schema.json",
  "title": "Create result",
  "description": "Result of `aspose-cli cells create`.",
  "type": "object",
  "required": ["schema", "schemaVersion", "output", "sheets"],
  "properties": {
    "schema": {
      "const": "https://schemas.aspose.dev/aspose-cli/v2/cells/create-result.schema.json"
    },
    "schemaVersion": { "const": 2 },
    "output": { "$ref": "#/$defs/outputInfo" },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "license": { "$ref": "#/$defs/licenseInfo" },
    "warnings": { "$ref": "#/$defs/warnings" }
  },
  "$defs": {
    "outputInfo": {
      "type": "object",
      "required": ["path", "format", "sizeBytes", "fingerprint"],
      "properties": {
        "path": { "type": "string" },
        "format": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "fingerprint": { "$ref": "https://schemas.aspose.dev/aspose-cli/v2/common/file-fingerprint.schema.json" }
      }
    },
    "licenseInfo": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["evaluation", "licensed", "not-applicable"] }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "docs": { "type": "string" },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        }
      }
    }
  },
  "additionalProperties": false
}
