{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/cells/workbook-info.schema.json",
  "title": "Workbook info",
  "description": "Result of `aspose-cli cells inspect`: structural summary of a workbook. First step of the projection ladder; never contains full cell data.",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "source", "workbook"],
  "properties": {
    "schema": {
      "const": "https://schemas.aspose.com/aspose-cli/v2/cells/workbook-info.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "workbook"
    },
    "source": {
      "$ref": "#/$defs/sourceInfo"
    },
    "workbook": {
      "type": "object",
      "required": ["name", "sheetCount", "sheets", "hasVba", "definedNameCount", "structureProtected", "structurePasswordProtected"],
      "properties": {
        "name": { "type": "string" },
        "sheetCount": { "type": "integer", "minimum": 0 },
        "sheets": {
          "type": "array",
          "items": { "$ref": "#/$defs/sheetInfo" }
        },
        "hasVba": { "type": "boolean" },
        "definedNameCount": { "type": "integer", "minimum": 0 },
        "structureProtected": { "type": "boolean" },
        "structurePasswordProtected": { "type": "boolean" },
        "author": { "type": "string" },
        "title": { "type": "string" },
        "definedNames": {
          "type": "array",
          "items": { "$ref": "#/$defs/definedNameInfo" }
        },
        "formulaErrors": {
          "type": "array",
          "items": { "$ref": "#/$defs/cellError" }
        },
        "fonts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableInfo" }
        },
        "charts": {
          "type": "array",
          "items": { "$ref": "#/$defs/chartInfo" }
        },
        "pivots": {
          "type": "array",
          "items": { "$ref": "#/$defs/pivotInfo" }
        },
        "validations": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationInfo" }
        }
      }
    },
    "license": {
      "$ref": "#/$defs/licenseInfo"
    },
    "warnings": {
      "$ref": "#/$defs/warnings"
    }
  },
  "$defs": {
    "sourceInfo": {
      "type": "object",
      "required": ["path", "format", "sizeBytes", "fingerprint"],
      "properties": {
        "path": { "type": "string" },
        "format": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "fingerprint": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/file-fingerprint.schema.json" }
      }
    },
    "sheetInfo": {
      "type": "object",
      "required": ["name", "position", "rowCount", "columnCount", "hidden", "protected", "passwordProtected", "chartCount", "pivotTableCount"],
      "properties": {
        "name": { "type": "string" },
        "position": { "type": "integer", "minimum": 0 },
        "usedRange": { "type": "string" },
        "rowCount": { "type": "integer", "minimum": 0 },
        "columnCount": { "type": "integer", "minimum": 0 },
        "hidden": { "type": "boolean" },
        "protected": { "type": "boolean" },
        "passwordProtected": { "type": "boolean" },
        "chartCount": { "type": "integer", "minimum": 0 },
        "pivotTableCount": { "type": "integer", "minimum": 0 },
        "preview": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": ["string", "null"] }
          }
        }
      }
    },
    "definedNameInfo": {
      "type": "object",
      "required": ["name", "refersTo"],
      "properties": {
        "name": { "type": "string" },
        "refersTo": { "type": "string" }
      }
    },
    "cellError": {
      "type": "object",
      "required": ["sheet", "cell", "error"],
      "properties": {
        "sheet": { "type": "string" },
        "cell": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "tableInfo": {
      "type": "object",
      "required": ["sheet", "name", "range"],
      "properties": {
        "sheet": { "type": "string" },
        "name": { "type": "string" },
        "range": { "type": "string" }
      }
    },
    "chartInfo": {
      "type": "object",
      "required": ["sheet", "index", "name", "type"],
      "properties": {
        "sheet": { "type": "string" },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based index of the chart on its sheet, as update_chart and delete_chart take it."
        },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "description": "A create_chart type, or the lower-camel engine name of a type outside that vocabulary, such as columnStacked.",
          "anyOf": [
            { "enum": ["column", "bar", "line", "pie", "scatter", "area"] },
            { "pattern": "^[a-z][A-Za-z0-9]*$" }
          ]
        }
      }
    },
    "pivotInfo": {
      "type": "object",
      "required": ["sheet", "name", "range"],
      "properties": {
        "sheet": { "type": "string" },
        "name": { "type": "string" },
        "range": { "type": "string" }
      }
    },
    "validationInfo": {
      "type": "object",
      "required": ["sheet", "range", "type"],
      "properties": {
        "sheet": { "type": "string" },
        "range": { "type": "string" },
        "type": {
          "type": "string",
          "description": "A set_validation type, or the lower-camel engine name of a type outside that vocabulary, such as anyValue.",
          "anyOf": [
            { "enum": ["list", "wholeNumber", "decimal", "date", "textLength", "custom"] },
            { "pattern": "^[a-z][A-Za-z0-9]*$" }
          ]
        }
      }
    },
    "licenseInfo": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["evaluation", "licensed", "not-applicable"] }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "docs": { "type": "string" },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        }
      }
    }
  }
}
