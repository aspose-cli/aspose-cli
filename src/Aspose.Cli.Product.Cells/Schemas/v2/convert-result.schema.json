{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/cells/convert-result.schema.json",
  "title": "Convert result",
  "description": "Result of `aspose-cli cells convert`.",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "output"],
  "properties": {
    "schema": {
      "const": "https://schemas.aspose.com/aspose-cli/v2/cells/convert-result.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "input": {
      "$ref": "#/$defs/sourceInfo"
    },
    "output": {
      "$ref": "#/$defs/outputInfo"
    },
    "sheet": {
      "type": "string"
    },
    "license": {
      "$ref": "#/$defs/licenseInfo"
    },
    "warnings": {
      "$ref": "#/$defs/warnings"
    }
  },
  "$defs": {
    "sourceInfo": {
      "type": "object",
      "required": ["path", "format", "sizeBytes"],
      "properties": {
        "path": { "type": "string" },
        "format": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "outputInfo": {
      "type": "object",
      "required": ["path", "format", "sizeBytes"],
      "properties": {
        "path": { "type": "string" },
        "format": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "encrypted": { "type": "boolean", "description": "True when the output file is encrypted and opens only with its password." }
      }
    },
    "licenseInfo": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["evaluation", "licensed", "not-applicable"] }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "docs": { "type": "string" },
          "location": { "type": "string", "minLength": 1 },
          "affectsCompleteness": { "type": "boolean" }
        }
      }
    }
  }
}
