{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/pdf/edit-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "dryRun", "applied"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/pdf/edit-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "$ref": "#/$defs/source" },
    "output": { "$ref": "#/$defs/output" },
    "dryRun": { "type": "boolean" },
    "applied": {
      "type": "array",
      "items": { "$ref": "https://schemas.aspose.dev/aspose-cli/v2/common/operation-outcome.schema.json" }
    },
    "backup": { "type": "object" },
    "mutation": {
      "$ref": "https://schemas.aspose.dev/aspose-cli/v2/common/mutation-receipt.schema.json"
    },
    "pagesTouched": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  },
  "$defs": {
    "source": {
      "type": "object", "required": ["path", "format", "sizeBytes", "fingerprint"], "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "const": "pdf" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "fingerprint": {
          "type": "object",
          "required": ["sha256"],
          "additionalProperties": false,
          "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      }
    },
    "output": {
      "type": "object", "required": ["path", "format", "sizeBytes", "fingerprint"], "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "const": "pdf" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "fingerprint": { "$ref": "https://schemas.aspose.dev/aspose-cli/v2/common/file-fingerprint.schema.json" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "dryRun": { "const": true } }, "required": ["dryRun"] },
      "then": { "not": { "anyOf": [{ "required": ["output"] }, { "required": ["mutation"] }] } },
      "else": { "required": ["output", "mutation"] }
    }
  ]
}
