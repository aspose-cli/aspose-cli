{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/pdf/edit-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "dryRun", "applied"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/pdf/edit-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "$ref": "#/$defs/source" },
    "output": { "$ref": "#/$defs/output" },
    "dryRun": { "type": "boolean" },
    "applied": {
      "type": "array",
      "items": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/operation-outcome.schema.json" }
    },
    "backup": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/backup.schema.json" },
    "pagesTouched": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "verification": {
      "type": "object",
      "description": "Present with --verify: the staged output read back against the effect of each form, redaction, bookmark, metadata, attachment and page operation.",
      "required": ["ok", "issues", "checkedOps"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/verification-issue.schema.json" }
        },
        "checkedOps": { "type": "array", "items": { "type": "string" }, "description": "In batch order, the ids of the operations whose every recorded effect was read back; an operation left out was not fully checked." }
      }
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  },
  "$defs": {
    "source": {
      "type": "object", "required": ["path", "format", "sizeBytes", "fingerprint"], "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "const": "pdf" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "fingerprint": {
          "type": "object",
          "required": ["sha256"],
          "additionalProperties": false,
          "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      }
    },
    "output": {
      "type": "object", "required": ["path", "format", "sizeBytes", "fingerprint"], "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "const": "pdf" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "fingerprint": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/file-fingerprint.schema.json" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "dryRun": { "const": true } }, "required": ["dryRun"] },
      "then": { "not": { "required": ["output"] } },
      "else": { "required": ["output"] }
    }
  ]
}
