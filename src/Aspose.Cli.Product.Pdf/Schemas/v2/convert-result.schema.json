{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/pdf/convert-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/pdf/convert-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": {
      "type": "object",
      "required": ["path", "format", "sizeBytes"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "const": "pdf" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "format", "sizeBytes"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "format": { "type": "string" },
          "sizeBytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "pages": { "type": "string" },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
