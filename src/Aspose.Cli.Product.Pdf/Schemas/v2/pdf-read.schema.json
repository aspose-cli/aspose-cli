{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/pdf/pdf-read.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "source", "mode", "pageCount", "pages", "window"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/pdf/pdf-read.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "pdf" },
    "source": {
      "type": "object",
      "required": ["path", "format", "sizeBytes"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "const": "pdf" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "mode": { "enum": ["plain", "layout"] },
    "pageCount": { "type": "integer", "minimum": 0, "description": "How many pages the document has, whatever --pages selected." },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "text", "truncated"],
        "additionalProperties": false,
        "properties": {
          "page": { "type": "integer", "minimum": 1, "description": "The 1-based page number that operations address." },
          "text": { "type": "string" },
          "truncated": { "type": "boolean" }
        }
      }
    },
    "scannedPagesSuspected": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "window": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/result-window.schema.json" },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
