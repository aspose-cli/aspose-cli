{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/pdf/search-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "source", "pattern", "hits", "window"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/pdf/search-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "source": { "$ref": "#/$defs/source" }, "pattern": { "type": "string" },
    "hits": {
      "type": "array",
      "items": {
        "type": "object", "required": ["page", "snippet", "rect", "occurrence"], "additionalProperties": false,
        "properties": {
          "page": { "type": "integer", "minimum": 1 }, "snippet": { "type": "string" },
          "rect": { "$ref": "#/$defs/rect" }, "occurrence": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "window": { "$ref": "https://schemas.aspose.com/aspose-cli/v2/common/result-window.schema.json" }, "license": { "type": "object" }, "warnings": { "type": "array" }
  },
  "$defs": {
    "source": {
      "type": "object", "required": ["path", "format", "sizeBytes"], "additionalProperties": false,
      "properties": { "path": { "type": "string" }, "format": { "const": "pdf" }, "sizeBytes": { "type": "integer", "minimum": 0 } }
    },
    "rect": {
      "type": "object", "required": ["x", "y", "width", "height"], "additionalProperties": false,
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 }
      }
    }
  }
}
