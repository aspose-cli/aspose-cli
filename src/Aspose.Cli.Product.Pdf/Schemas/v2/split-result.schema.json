{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/pdf/split-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/pdf/split-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "$ref": "#/$defs/source" },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "pages", "output"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "pages": { "type": "string", "description": "The part's pages as range text, such as 1-3 or 1-3,7." },
          "bookmark": { "type": "string" },
          "output": { "$ref": "#/$defs/output" }
        }
      }
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["path", "format", "sizeBytes"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "const": "pdf" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "output": {
      "type": "object",
      "required": ["path", "format", "sizeBytes"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "const": "pdf" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
