{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/pdf/pdf-info.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "kind", "source", "pdf"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/pdf/pdf-info.schema.json" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "pdf" },
    "source": {
      "type": "object",
      "required": ["path", "format", "sizeBytes", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "const": "pdf" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "fingerprint": {
          "type": "object",
          "required": ["sha256"],
          "additionalProperties": false,
          "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      }
    },
    "pdf": {
      "type": "object",
      "required": ["pageCount", "distinctPageSizes", "version", "encrypted", "linearized", "tagged", "formType", "attachmentCount", "signed", "passwordType"],
      "additionalProperties": false,
      "properties": {
        "pageCount": { "type": "integer", "minimum": 0 },
        "distinctPageSizes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["widthPoints", "heightPoints", "pageCount"],
            "additionalProperties": false,
            "properties": {
              "widthPoints": { "type": "number", "exclusiveMinimum": 0 },
              "heightPoints": { "type": "number", "exclusiveMinimum": 0 },
              "pageCount": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "version": { "type": "string" },
        "encrypted": { "type": "boolean" },
        "linearized": { "type": "boolean" },
        "tagged": { "type": "boolean" },
        "pdfaProfile": { "type": "string", "pattern": "^pdfa-[1-4][abuef]?$", "description": "The PDF/A profile the file declares in its metadata, such as pdfa-2b; absent when it declares none. A declaration is not a check: pdf validate --profile verifies conformance." },
        "formType": { "enum": ["none", "acro", "xfa"] },
        "attachmentCount": { "type": "integer", "minimum": 0 },
        "signed": { "type": "boolean" },
        "passwordType": { "enum": ["none", "user", "owner"] }
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 20,
      "description": "The first pages' geometry with --preview; a LIST_TRUNCATED warning names the page count when there are more.",
      "items": {
        "type": "object",
        "required": ["page", "widthPoints", "heightPoints", "rotation", "mediaBox", "cropBox"],
        "additionalProperties": false,
        "properties": {
          "page": { "type": "integer", "minimum": 1, "description": "The 1-based page number that operations address." },
          "widthPoints": { "type": "number", "exclusiveMinimum": 0 },
          "heightPoints": { "type": "number", "exclusiveMinimum": 0 },
          "rotation": { "enum": [0, 90, 180, 270], "description": "Clockwise page rotation in degrees." },
          "mediaBox": { "$ref": "#/$defs/box" },
          "cropBox": { "$ref": "#/$defs/box" }
        }
      }
    },
    "pageLabels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["startPage", "style", "startingValue"],
        "additionalProperties": false,
        "properties": {
          "startPage": { "type": "integer", "minimum": 1 },
          "style": {
            "enum": ["arabic", "roman-upper", "roman-lower", "letters-upper", "letters-lower", "none"],
            "description": "The numbering style, one of the values set_page_labels accepts."
          },
          "prefix": { "type": "string" },
          "startingValue": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "outline": {
      "type": "array",
      "maxItems": 200,
      "description": "Bookmarks in reading order, depth first; a LIST_TRUNCATED warning names the total when there are more.",
      "items": {
        "type": "object",
        "required": ["title", "level", "index"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "level": { "type": "integer", "minimum": 1 },
          "index": { "type": "string", "pattern": "^[1-9][0-9]*(/[1-9][0-9]*)*$", "description": "The bookmark's 1-based positions from the top level down, joined by '/': 2/1 is the first child of the second top-level bookmark. delete_bookmarks.indexes and add_bookmark.parent accept it." },
          "page": { "type": "integer", "minimum": 1, "description": "The page the bookmark opens; omitted when its destination is not a page of the document." }
        }
      }
    },
    "forms": {
      "type": "object",
      "required": ["type", "fieldCount", "readOnly"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["none", "acro", "xfa"] },
        "fieldCount": { "type": "integer", "minimum": 0 },
        "readOnly": { "type": "boolean" }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "mimeType": { "type": "string" },
          "sizeBytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "embedded", "subset"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "embedded": { "type": "boolean" },
          "subset": { "type": "boolean" }
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["hasOpenPassword", "hasOwnerPassword", "ownerAccess", "print", "copy", "modify", "annotate", "fillForms", "extractAccessibility", "assemble", "printHighResolution"],
      "additionalProperties": false,
      "properties": {
        "hasOpenPassword": { "type": "boolean" },
        "hasOwnerPassword": { "type": "boolean" },
        "ownerAccess": { "type": "boolean" },
        "print": { "type": "boolean" },
        "copy": { "type": "boolean" },
        "modify": { "type": "boolean" },
        "annotate": { "type": "boolean" },
        "fillForms": { "type": "boolean" },
        "extractAccessibility": { "type": "boolean" },
        "assemble": { "type": "boolean" },
        "printHighResolution": { "type": "boolean" }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "signed"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "signed": { "type": "boolean" },
          "valid": { "type": "boolean" }
        }
      }
    },
    "layers": { "type": "array", "items": { "type": "string" } },
    "metadata": {
      "type": "object",
      "description": "Document information and XMP properties as the file stores them; XMP keys start with xmp:. creationDate and modificationDate are ISO 8601: in UTC ending in Z when the stored date states an offset, without Z when it states none, and the stored text unchanged when it is not a PDF date.",
      "additionalProperties": { "type": ["string", "null"] }
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  },
  "$defs": {
    "box": {
      "type": "object",
      "required": ["left", "bottom", "right", "top"],
      "additionalProperties": false,
      "properties": {
        "left": { "type": "number" },
        "bottom": { "type": "number" },
        "right": { "type": "number" },
        "top": { "type": "number" }
      }
    }
  }
}
