{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.com/aspose-cli/v2/pdf/sign-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "output", "signature", "visible", "page"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.com/aspose-cli/v2/pdf/sign-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "type": "object" },
    "output": { "type": "object" },
    "signature": {
      "type": "object",
      "required": ["name", "signed"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "signed": { "const": true },
        "valid": { "type": ["boolean", "null"] }
      }
    },
    "visible": { "type": "boolean" },
    "page": { "type": "integer", "minimum": 1 },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  }
}
