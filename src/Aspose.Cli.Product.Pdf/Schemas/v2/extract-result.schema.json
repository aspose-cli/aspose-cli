{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aspose.dev/aspose-cli/v2/pdf/extract-result.schema.json",
  "type": "object",
  "required": ["schema", "schemaVersion", "input", "what", "items"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "https://schemas.aspose.dev/aspose-cli/v2/pdf/extract-result.schema.json" },
    "schemaVersion": { "const": 2 },
    "input": { "$ref": "#/$defs/source" },
    "what": { "enum": ["images", "attachments", "text", "tables"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sizeBytes"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "kind": { "enum": ["image", "attachment", "text", "table"] },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "rect": { "$ref": "#/$defs/rect" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "license": { "type": "object" },
    "warnings": { "type": "array" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["path", "format", "sizeBytes"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "const": "pdf" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    }
  }
}
