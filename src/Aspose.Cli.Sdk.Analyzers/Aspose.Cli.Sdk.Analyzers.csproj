<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>
      Compile-time validation and source generation for Aspose CLI product modules.
    </Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);ASPOSE_CLI_ANALYZER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host's global option names, compiled here so the analyzer reserves exactly them. -->
    <Compile Include="..\Aspose.Cli.Sdk\Extensibility\Commanding\GlobalOptionNames.cs" Link="GlobalOptionNames.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
