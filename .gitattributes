# Normalize line endings for text files
* text=auto

*.cs text
*.csproj text
*.props text
*.targets text
*.sln text
*.json text
*.md text
*.yml text
*.yaml text
*.editorconfig text
*.gitignore text
*.gitattributes text
*.ps1 text
*.sh text eol=lf

# The release signs the installer as checked out; the build and signing jobs must see the
# same bytes whatever their Git line-ending settings.
/install.ps1 text eol=crlf

# Retain the exact notice bytes, including whitespace, from the pinned packages.
eng/notices/*.txt -text -whitespace

# Binary fixtures
*.xlsx binary
*.xlsb binary
*.xls binary
*.ods binary
*.pdf binary
*.pptx binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
