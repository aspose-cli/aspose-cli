{
  "name": "an invalid --font-dir is reported before --password-stdin reads standard input, in every product",
  "files": {
    "locked.pdf": { "fixture": "pdf.encrypted" },
    "locked.xlsx": { "fixture": "cells.encrypted" },
    "locked.docx": { "fixture": "words.encrypted" },
    "locked.pptx": { "fixture": "slides.encrypted" },
    "not-a-directory.txt": { "text": "fonts" }
  },
  "steps": [
    {
      "args": ["pdf", "render", "locked.pdf", "--out", "page.png", "--font-dir", "missing-fonts", "--password-stdin"],
      "stdin": "",
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          { "path": "error.details.option", "equals": "--font-dir" },
          { "path": "error.message", "contains": "'missing-fonts' does not exist or is not a directory" }
        ],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "render", "locked.pdf", "--out", "page.png", "--font-dir", "not-a-directory.txt", "--password-stdin"],
      "stdin": "scenario-stdin-secret\n",
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--font-dir" }],
        "files": { "nothingWritten": true },
        "hidden": ["scenario-stdin-secret"]
      }
    },
    {
      "args": ["cells", "render", "locked.xlsx", "--out", "page.png", "--font-dir", "missing-fonts", "--password-stdin"],
      "stdin": "",
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--font-dir" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["words", "render", "locked.docx", "--out", "page.png", "--font-dir", "missing-fonts", "--password-stdin"],
      "stdin": "",
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--font-dir" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["slides", "render", "locked.pptx", "--out", "page.png", "--font-dir", "missing-fonts", "--password-stdin"],
      "stdin": "",
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--font-dir" }],
        "files": { "nothingWritten": true }
      }
    }
  ]
}
