{
  "name": "an empty password is refused the same way in every product, before any document is opened",
  "files": {
    "locked.xlsx": { "fixture": "cells.encrypted" },
    "locked.pdf": { "fixture": "pdf.encrypted" },
    "locked.pptx": { "fixture": "slides.encrypted" },
    "locked.docx": { "fixture": "words.encrypted" },
    "open.xlsx": { "fixture": "cells.xlsx" },
    "open.pdf": { "fixture": "pdf.pdf" },
    "open.pptx": { "fixture": "slides.pptx" },
    "open.docx": { "fixture": "words.docx" }
  },
  "steps": [
    { "args": ["cells", "inspect", "locked.xlsx", "--password-stdin"], "stdin": "", "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["pdf", "inspect", "locked.pdf", "--password-stdin"], "stdin": "", "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["slides", "inspect", "locked.pptx", "--password-stdin"], "stdin": "", "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["words", "inspect", "locked.docx", "--password-stdin"], "stdin": "", "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["cells", "inspect", "locked.xlsx", "--password-env", "EMPTY_PASSWORD"], "env": { "EMPTY_PASSWORD": "" }, "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["pdf", "inspect", "locked.pdf", "--password-env", "EMPTY_PASSWORD"], "env": { "EMPTY_PASSWORD": "" }, "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["slides", "inspect", "locked.pptx", "--password-env", "EMPTY_PASSWORD"], "env": { "EMPTY_PASSWORD": "" }, "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["words", "inspect", "locked.docx", "--password-env", "EMPTY_PASSWORD"], "env": { "EMPTY_PASSWORD": "" }, "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["cells", "inspect", "locked.xlsx", "--password", ""], "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["pdf", "inspect", "locked.pdf", "--password", ""], "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["slides", "inspect", "locked.pptx", "--password", ""], "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["words", "inspect", "locked.docx", "--password", ""], "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["cells", "inspect", "open.xlsx", "--password-stdin"], "stdin": "", "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["pdf", "inspect", "open.pdf", "--password-stdin"], "stdin": "", "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["slides", "inspect", "open.pptx", "--password-stdin"], "stdin": "", "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["words", "inspect", "open.docx", "--password-stdin"], "stdin": "", "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } } },
    { "args": ["cells", "inspect", "locked.xlsx"], "expect": { "exitCode": 3, "error": "PASSWORD_REQUIRED", "files": { "nothingWritten": true } } },
    { "args": ["pdf", "inspect", "locked.pdf"], "expect": { "exitCode": 3, "error": "PASSWORD_REQUIRED", "files": { "nothingWritten": true } } },
    { "args": ["slides", "inspect", "locked.pptx"], "expect": { "exitCode": 3, "error": "PASSWORD_REQUIRED", "files": { "nothingWritten": true } } },
    { "args": ["words", "inspect", "locked.docx"], "expect": { "exitCode": 3, "error": "PASSWORD_REQUIRED", "files": { "nothingWritten": true } } }
  ]
}
