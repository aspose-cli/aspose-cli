{
  "name": "words create encrypts with a password from the environment and never prints it",
  "files": {
    "source.md": { "fixture": "markdown" }
  },
  "steps": [
    {
      "args": ["words", "create", "secret.docx", "--markdown", "source.md", "--encrypt-env", "DOC_PASSWORD"],
      "env": { "DOC_PASSWORD": "Scenario-Password-41d7" },
      "expect": {
        "exitCode": 0,
        "files": { "present": ["secret.docx"] },
        "hidden": ["Scenario-Password-41d7"]
      }
    },
    {
      "args": ["words", "inspect", "secret.docx"],
      "expect": {
        "error": "PASSWORD_REQUIRED",
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["words", "inspect", "secret.docx", "--password-stdin"],
      "stdin": "Scenario-Password-41d7",
      "expect": {
        "exitCode": 0,
        "hidden": ["Scenario-Password-41d7"],
        "files": { "nothingWritten": true }
      }
    }
  ]
}
