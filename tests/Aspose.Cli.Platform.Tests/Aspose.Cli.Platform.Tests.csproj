<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Focused SDK, Host, analyzer, architecture, and real CLI tests.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aspose.Cli.Sdk\Aspose.Cli.Sdk.csproj" />
    <!-- The analyzer tests use its types, and the SDK tests declare their operation vocabulary as products do. -->
    <ProjectReference Include="..\..\src\Aspose.Cli.Sdk.Analyzers\Aspose.Cli.Sdk.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\..\src\Aspose.Cli.Host\Aspose.Cli.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- Repository files outside the projects that these tests read; scripts/test.ps1 runs this project when one changes. -->
  <ItemGroup>
    <RepositoryInput Include="..\..\README.md" />
    <RepositoryInput Include="..\..\CONTRIBUTING.md" />
    <RepositoryInput Include="..\..\KNOWN-ISSUES.md" />
    <RepositoryInput Include="..\..\LICENSE" />
  </ItemGroup>

</Project>
