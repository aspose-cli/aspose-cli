{
  "schema": "https://schemas.aspose.com/aspose-cli/v2/common/capabilities-summary.schema.json",
  "schemaVersion": 2,
  "cliVersion": "<build>",
  "products": [
    {
      "id": "cells",
      "name": "Cells",
      "description": "Read, edit, convert and render workbooks through the Aspose.Cells object model.",
      "engine": "aspose",
      "engineVersion": "<build>",
      "loadFormats": [
        "xlsx",
        "xltx",
        "xlsm",
        "xltm",
        "xlam",
        "xlsb",
        "xls",
        "xlt",
        "csv",
        "tsv"
      ],
      "convertFormats": [
        "xlsx",
        "xltx",
        "xlsm",
        "xltm",
        "xlam",
        "xlsb",
        "xls",
        "xlt",
        "csv",
        "tsv",
        "ods",
        "html",
        "mhtml",
        "pdf",
        "xps",
        "json",
        "md"
      ],
      "renderFormats": [
        "png",
        "jpeg",
        "svg"
      ],
      "commands": [
        {
          "command": "convert",
          "description": "Convert a workbook, or CSV or TSV text, to another format with the engine's options for it. An html, mhtml or md output is one file: it holds its images itself (SaveAsSingleFile, ExportImagesAsBase64)."
        },
        {
          "command": "create",
          "description": "Create a workbook: the engine's new workbook, or a copy of a template saved in the output's format."
        },
        {
          "command": "edit",
          "description": "Apply a batch of set, add, delete, move and do operations to a workbook; nothing is written when one fails."
        },
        {
          "command": "read",
          "description": "Read a workbook's objects, each with every row of the object table, and its inventory."
        },
        {
          "command": "render",
          "description": "Render sheets, or an area of one, to images as the engine draws them."
        },
        {
          "command": "search",
          "description": "Search the text of a workbook's cells, as their number formats show it, their formulas and their comments; each hit names the object's address and row."
        }
      ],
      "operations": []
    },
    {
      "id": "pdf",
      "name": "PDF",
      "description": "PDF automation with page, security and fixed-layout semantics.",
      "engine": "aspose",
      "engineVersion": "<build>",
      "loadFormats": [
        "pdf"
      ],
      "convertFormats": [
        "docx",
        "xlsx",
        "pptx",
        "html",
        "epub",
        "txt",
        "md",
        "xps",
        "pdfa-1b",
        "pdfa-2b",
        "pdfa-3b",
        "tiff"
      ],
      "renderFormats": [
        "png",
        "jpeg",
        "svg"
      ],
      "commands": [
        {
          "command": "convert",
          "description": "Convert selected PDF pages to a supported format."
        },
        {
          "command": "create",
          "description": "Create a PDF from exactly one source family."
        },
        {
          "command": "edit",
          "description": "Apply one validated, atomic PDF operation batch."
        },
        {
          "command": "extract",
          "description": "Extract bounded PDF assets, text, tables or form data."
        },
        {
          "command": "inspect",
          "description": "Show PDF structure, security state and properties."
        },
        {
          "command": "merge",
          "description": "Merge PDF inputs in order."
        },
        {
          "command": "read",
          "description": "Read a bounded page-text window."
        },
        {
          "command": "render",
          "description": "Render one or more PDF pages."
        },
        {
          "command": "search",
          "description": "Search PDF text and return page rectangles."
        },
        {
          "command": "sign",
          "description": "Apply a PKCS#7 signature and verify the saved signature field."
        },
        {
          "command": "split",
          "description": "Split a PDF into an atomic output set."
        },
        {
          "command": "validate",
          "description": "Validate a PDF against a PDF/A profile."
        }
      ],
      "operations": [
        {
          "command": "edit",
          "ops": [
            "add_attachment",
            "add_bookmark",
            "add_footer_text",
            "add_header_text",
            "add_hyperlink",
            "add_page_numbers",
            "add_stamp_image",
            "add_watermark_image",
            "add_watermark_text",
            "clear_properties",
            "crop_pages",
            "decrypt_document",
            "delete_attachment",
            "delete_bookmarks",
            "delete_pages",
            "encrypt_document",
            "flatten_forms",
            "import_pages",
            "insert_page",
            "move_pages",
            "optimize_document",
            "redact_area",
            "redact_text",
            "rotate_pages",
            "set_form_field",
            "set_page_labels",
            "set_page_size",
            "set_properties"
          ]
        }
      ]
    },
    {
      "id": "slides",
      "name": "Slides",
      "description": "Read, edit, convert and render presentations through the Aspose.Slides object model.",
      "engine": "aspose",
      "engineVersion": "<build>",
      "loadFormats": [
        "ppt",
        "pptx",
        "pptm",
        "pps",
        "ppsx",
        "ppsm",
        "pot",
        "potx",
        "potm",
        "odp",
        "otp",
        "fodp"
      ],
      "convertFormats": [
        "pptx",
        "ppt",
        "pptm",
        "odp",
        "pdf",
        "xps",
        "html",
        "html5",
        "gif",
        "md"
      ],
      "renderFormats": [
        "png",
        "jpeg",
        "tiff",
        "svg"
      ],
      "commands": [
        {
          "command": "convert",
          "description": "Convert a presentation or selected slides."
        },
        {
          "command": "create",
          "description": "Create a presentation: the engine's new presentation, or a copy of a template saved in the output's format."
        },
        {
          "command": "edit",
          "description": "Apply a batch of set, add, delete, move and do operations to a presentation; nothing is written when one fails."
        },
        {
          "command": "extract",
          "description": "Extract the media a presentation embeds, byte for byte."
        },
        {
          "command": "read",
          "description": "Read a presentation's objects, each with every row of the object table, and its inventory."
        },
        {
          "command": "render",
          "description": "Render one or more slides for visual verification."
        },
        {
          "command": "search",
          "description": "Search the text of a presentation's shapes, table cells, notes and chart titles; each hit names the object's address."
        }
      ],
      "operations": []
    },
    {
      "id": "words",
      "name": "Words",
      "description": "Word-processing document automation with layout fidelity.",
      "engine": "aspose",
      "engineVersion": "<build>",
      "loadFormats": [
        "doc",
        "dot",
        "docx",
        "docm",
        "dotx",
        "dotm",
        "flatopc",
        "rtf",
        "wordml",
        "html",
        "mhtml",
        "odt",
        "ott",
        "txt",
        "md",
        "pdf",
        "epub",
        "mobi",
        "azw3",
        "chm"
      ],
      "convertFormats": [
        "doc",
        "dot",
        "docx",
        "docm",
        "dotx",
        "dotm",
        "flatopc",
        "rtf",
        "wordml",
        "pdf",
        "xps",
        "openxps",
        "ps",
        "pcl",
        "html",
        "html-fixed",
        "mhtml",
        "epub",
        "mobi",
        "azw3",
        "odt",
        "ott",
        "txt",
        "md"
      ],
      "renderFormats": [
        "png",
        "jpeg",
        "svg"
      ],
      "commands": [
        {
          "command": "compare",
          "description": "Semantically compare two documents and optionally save a redline."
        },
        {
          "command": "convert",
          "description": "Convert a document using the detected input format."
        },
        {
          "command": "create",
          "description": "Create a document from at most one content source, optionally inside a template; without either it is blank."
        },
        {
          "command": "edit",
          "description": "Apply one validated, atomic Words operation batch."
        },
        {
          "command": "extract",
          "description": "Extract bounded document assets."
        },
        {
          "command": "inspect",
          "description": "Show document structure, safety state and metadata."
        },
        {
          "command": "read",
          "description": "Read a bounded, stable window of document blocks."
        },
        {
          "command": "render",
          "description": "Render one or more document pages."
        },
        {
          "command": "search",
          "description": "Search bounded document scopes with regex timeout protection."
        },
        {
          "command": "split",
          "description": "Split a document into safe, deterministically named DOCX files."
        }
      ],
      "operations": [
        {
          "command": "edit",
          "ops": [
            "accept_revisions",
            "add_comment",
            "clear_list",
            "define_style",
            "delete_blocks",
            "delete_comments",
            "delete_section",
            "delete_watermark",
            "format_text",
            "import_sections",
            "insert_bookmark",
            "insert_break",
            "insert_field",
            "insert_hyperlink",
            "insert_image",
            "insert_markdown",
            "insert_paragraphs",
            "insert_section",
            "insert_table",
            "insert_toc",
            "mail_merge",
            "protect_document",
            "refresh_fields",
            "reject_revisions",
            "repeat_table_row",
            "replace_text",
            "set_default_font",
            "set_footer",
            "set_header",
            "set_list",
            "set_page_numbers",
            "set_page_setup",
            "set_properties",
            "set_style",
            "set_table_cell",
            "set_table_pagination",
            "set_table_style",
            "set_text",
            "set_watermark",
            "unprotect_document"
          ]
        }
      ]
    }
  ]
}
