{
  "schema": "https://schemas.aspose.com/aspose-cli/v2/common/capabilities-summary.schema.json",
  "schemaVersion": 2,
  "cliVersion": "<build>",
  "products": [
    {
      "id": "cells",
      "name": "Cells",
      "description": "Spreadsheet operations (Excel and friends) with engine-grade fidelity.",
      "engine": "aspose",
      "engineVersion": "<build>",
      "loadFormats": [
        "xlsx",
        "xltx",
        "xlsm",
        "xltm",
        "xlsb",
        "xls",
        "ods",
        "csv",
        "tsv",
        "html",
        "mhtml"
      ],
      "convertFormats": [
        "xlsx",
        "xltx",
        "xlsm",
        "xltm",
        "xlsb",
        "xls",
        "ods",
        "csv",
        "tsv",
        "html",
        "mhtml",
        "pdf",
        "xps",
        "json",
        "md"
      ],
      "renderFormats": [
        "png",
        "jpeg",
        "svg"
      ],
      "commands": [
        {
          "command": "compare",
          "description": "Compare stored workbook values and optional formula text; dates are ISO 8601."
        },
        {
          "command": "convert",
          "description": "Convert a workbook to another format."
        },
        {
          "command": "create",
          "description": "Create a new workbook."
        },
        {
          "command": "edit",
          "description": "Apply a batch of edit ops atomically. Editable outputs: xlsx, xltx, xlsm, xltm, xlsb, xls, ods, csv, tsv, html, mhtml."
        },
        {
          "command": "inspect",
          "description": "Show structure and metadata of a workbook."
        },
        {
          "command": "read",
          "description": "Read cell data of one sheet as a windowed projection."
        },
        {
          "command": "render",
          "description": "Render sheets, or a range of one, to images."
        },
        {
          "command": "search",
          "description": "Find cells whose value or formula matches a pattern."
        }
      ],
      "operations": [
        {
          "command": "edit",
          "ops": [
            "add_comment",
            "add_conditional_format",
            "add_sparkline",
            "clear_autofilter",
            "clear_conditional_formats",
            "clear_print_area",
            "clear_range",
            "clear_tab_color",
            "clear_validation",
            "copy_range",
            "define_name",
            "define_table",
            "delete_chart",
            "delete_columns",
            "delete_comment",
            "delete_duplicates",
            "delete_hyperlink",
            "delete_name",
            "delete_rows",
            "delete_sheet",
            "format_range",
            "freeze_panes",
            "group_columns",
            "group_rows",
            "import_range",
            "import_sheet",
            "insert_chart",
            "insert_columns",
            "insert_image",
            "insert_pivot",
            "insert_rows",
            "insert_sheet",
            "merge_cells",
            "move_sheet",
            "protect_sheet",
            "protect_workbook",
            "refresh_pivot",
            "rename_sheet",
            "replace_text",
            "resize_columns",
            "resize_rows",
            "resize_table",
            "set_active_sheet",
            "set_autofilter",
            "set_borders",
            "set_chart",
            "set_comment",
            "set_default_font",
            "set_formula",
            "set_hyperlink",
            "set_page_setup",
            "set_print_area",
            "set_sheet_view",
            "set_sheet_visibility",
            "set_tab_color",
            "set_validation",
            "set_values",
            "sort_range",
            "unfreeze_panes",
            "ungroup_columns",
            "ungroup_rows",
            "unmerge_cells",
            "unprotect_sheet",
            "unprotect_workbook"
          ]
        }
      ]
    },
    {
      "id": "pdf",
      "name": "PDF",
      "description": "PDF automation with page, security and fixed-layout semantics.",
      "engine": "aspose",
      "engineVersion": "<build>",
      "loadFormats": [
        "pdf"
      ],
      "convertFormats": [
        "docx",
        "xlsx",
        "pptx",
        "html",
        "epub",
        "txt",
        "md",
        "xps",
        "pdfa-1b",
        "pdfa-2b",
        "pdfa-3b",
        "tiff"
      ],
      "renderFormats": [
        "png",
        "jpeg",
        "svg"
      ],
      "commands": [
        {
          "command": "convert",
          "description": "Convert selected PDF pages to a supported format."
        },
        {
          "command": "create",
          "description": "Create a PDF from exactly one source family."
        },
        {
          "command": "edit",
          "description": "Apply one validated, atomic PDF operation batch."
        },
        {
          "command": "extract",
          "description": "Extract bounded PDF assets, text, tables or form data."
        },
        {
          "command": "inspect",
          "description": "Show PDF structure, security state and properties."
        },
        {
          "command": "merge",
          "description": "Merge PDF inputs in order."
        },
        {
          "command": "read",
          "description": "Read a bounded page-text window."
        },
        {
          "command": "render",
          "description": "Render one or more PDF pages."
        },
        {
          "command": "search",
          "description": "Search PDF text and return page rectangles."
        },
        {
          "command": "sign",
          "description": "Apply a PKCS#7 signature and verify the saved signature field."
        },
        {
          "command": "split",
          "description": "Split a PDF into an atomic output set."
        },
        {
          "command": "validate",
          "description": "Validate a PDF against a PDF/A profile."
        }
      ],
      "operations": [
        {
          "command": "edit",
          "ops": [
            "add_attachment",
            "add_bookmark",
            "add_footer_text",
            "add_header_text",
            "add_hyperlink",
            "add_page_numbers",
            "add_stamp_image",
            "add_watermark_image",
            "add_watermark_text",
            "clear_properties",
            "crop_pages",
            "decrypt_document",
            "delete_attachment",
            "delete_bookmarks",
            "delete_pages",
            "encrypt_document",
            "flatten_forms",
            "import_pages",
            "insert_page",
            "move_pages",
            "optimize_document",
            "redact_area",
            "redact_text",
            "rotate_pages",
            "set_form_field",
            "set_page_labels",
            "set_page_size",
            "set_properties"
          ]
        }
      ]
    },
    {
