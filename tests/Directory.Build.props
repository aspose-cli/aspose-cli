<Project>

  <!-- Inherit repository-wide defaults, then add test-only conventions. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestKit Condition="'$(MSBuildProjectName)' == 'Aspose.Cli.TestKit'">true</IsTestKit>
  </PropertyGroup>

  <!-- xUnit.net v3 test projects are executables run through VSTest. -->
  <PropertyGroup Condition="'$(IsTestKit)' != 'true'">
    <OutputType>Exe</OutputType>
    <!-- Tests bound their own waits and scripts/test.ps1 reports a hung test by name, so
         threading TestContext cancellation through every awaited call adds no signal. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <!-- Every test project runs isolated from the developer's environment (TestKit TestEnvironment). -->
  <ItemGroup Condition="'$(IsTestKit)' != 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Aspose.Cli.TestKit\Aspose.Cli.TestKit.csproj" />
    <Compile Include="$(MSBuildThisFileDirectory)TestAssemblyFixture.cs" Link="TestAssemblyFixture.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestKit)' == 'true'">
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <!-- A RepositoryInput names a repository file outside this project that its tests read, so that
       scripts/test.ps1 runs the project when the file changes: one that is missing, outside the
       repository or inside this project (whose changes reach it already) is a mistake. -->
  <Target Name="CheckRepositoryInputs" BeforeTargets="CoreCompile" Condition="'@(RepositoryInput)' != ''">
    <PropertyGroup>
      <_RepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</_RepositoryRoot>
    </PropertyGroup>
    <ItemGroup>
      <_RepositoryInputCheck Include="@(RepositoryInput->'%(FullPath)')">
        <FromRoot>$([MSBuild]::MakeRelative('$(_RepositoryRoot)', '%(FullPath)'))</FromRoot>
        <FromProject>$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)\', '%(FullPath)'))</FromProject>
      </_RepositoryInputCheck>
    </ItemGroup>
    <Error ContinueOnError="ErrorAndContinue" Condition="!Exists('%(_RepositoryInputCheck.Identity)')"
           Text="RepositoryInput '%(_RepositoryInputCheck.Identity)' does not exist." />
    <Error ContinueOnError="ErrorAndContinue" Condition="$([System.String]::Copy('%(_RepositoryInputCheck.FromRoot)').StartsWith('..')) Or $([System.IO.Path]::IsPathRooted('%(_RepositoryInputCheck.FromRoot)'))"
           Text="RepositoryInput '%(_RepositoryInputCheck.Identity)' lies outside the repository; a test reads only repository files." />
    <Error ContinueOnError="ErrorAndContinue" Condition="!$([System.String]::Copy('%(_RepositoryInputCheck.FromProject)').StartsWith('..')) And !$([System.IO.Path]::IsPathRooted('%(_RepositoryInputCheck.FromProject)'))"
           Text="RepositoryInput '%(_RepositoryInputCheck.Identity)' lies inside $(MSBuildProjectName), whose changes already reach it; remove the item." />
  </Target>

</Project>
