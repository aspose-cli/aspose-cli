{
  "name": "pdf inspect --detail links lists the links to places in the document with the page each opens, and without one each link that leads nowhere, which NAVIGATION_DEGRADED counts",
  "files": {
    "nav.pdf": { "base64": "" },
    "contract.html": { "text": "<html><head><meta charset=\"utf-8\"><title>Contract</title></head><body><h1 id=\"c1\">General</h1><p>Contents: <a href=\"#c2\">Price</a> | <a href=\"annex.pdf\">Annex</a> | <a href=\"https://example.com/terms\">Terms</a></p><h1 id=\"c2\" style=\"page-break-before:always\">Price</h1><p>The price.</p></body></html>" }
  },
  "steps": [
    {
      "args": ["pdf", "inspect", "nav.pdf", "--detail", "links"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "links", "equals": [] },
          { "path": "documentLinks[0].page", "equals": 1 },
          { "path": "documentLinks[0].targetPage", "equals": 2 },
          { "path": "documentLinks[1].page", "equals": 1 },
          { "path": "documentLinks[1].targetPage", "equals": 3 },
          { "path": "documentLinks[2]", "exists": false }
        ]
      }
    },
    {
      "args": ["pdf", "edit", "nav.pdf", "--ops", "[{\"op\":\"delete_pages\",\"pages\":\"3\"}]", "--out", "deleted.pdf"],
      "expect": { "exitCode": 0, "warnings": { "present": ["NAVIGATION_DEGRADED"] } }
    },
    {
      "args": ["pdf", "inspect", "deleted.pdf", "--detail", "links"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "documentLinks[0].targetPage", "equals": 2 },
          { "path": "documentLinks[1].page", "equals": 1 },
          { "path": "documentLinks[1].targetPage", "exists": false }
        ]
      }
    },
    {
      "args": ["pdf", "create", "contract.pdf", "--from-html", "contract.html"],
      "expect": { "exitCode": 0, "warnings": { "present": ["NAVIGATION_DEGRADED"] } }
    },
    {
      "args": ["pdf", "inspect", "contract.pdf", "--detail", "links"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "links[0].url", "equals": "https://example.com/terms" },
          { "path": "documentLinks[0].page", "equals": 1 },
          { "path": "documentLinks[0].targetPage", "exists": false },
          { "path": "documentLinks[1].page", "equals": 1 },
          { "path": "documentLinks[1].targetPage", "exists": false }
        ]
      }
    }
  ]
}
