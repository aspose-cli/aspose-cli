{
  "name": "pdf edit counts the links and bookmarks through a name of the Dests dictionary that a page deletion breaks, and none that a deletion of another page leaves, when the catalog also has a name tree of destinations, which the engine does not read beside the dictionary (PDF-NAMES-BESIDE-DESTS): four pages, a link and a bookmark on page 1 to 'intree' (page 2, in the name tree) and to 'indict' (page 3, in the dictionary)",
  "files": {
    "names.pdf": {
      "base64": ""
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "edit",
        "names.pdf",
        "--ops",
        "[{\"op\":\"delete_pages\",\"pages\":\"4\"}]",
        "--out",
        "deleted-4.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "verification.ok",
            "equals": true
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "deleted-4.pdf",
        "--detail",
        "outline",
        "--detail",
        "links"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "documentLinks[1].page",
            "equals": 1
          },
          {
            "path": "documentLinks[1].targetPage",
            "equals": 3
          },
          {
            "path": "outline[1].title",
            "equals": "Dict"
          },
          {
            "path": "outline[1].page",
            "equals": 3
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "names.pdf",
        "--ops",
        "[{\"op\":\"delete_pages\",\"pages\":\"3\"}]",
        "--out",
        "deleted-3.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "verification.ok",
            "equals": true
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "1 bookmark(s), 1 link(s) and 1 named destination(s) lead to pages the edit deleted."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].affectsCompleteness",
            "exists": false
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1]",
            "exists": false
          }
        ]
      }
    }
  ]
}
