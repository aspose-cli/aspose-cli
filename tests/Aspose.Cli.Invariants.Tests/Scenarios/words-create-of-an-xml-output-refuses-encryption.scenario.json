{
  "name": "words create of an .xml output with a password is refused with OPTION_INVALID naming flatopc, without a template and with one, for every password option, and writes nothing",
  "files": { "template.xml": { "fixture": "words.wordml" } },
  "steps": [
    {
      "args": ["words", "create", "blank.xml", "--encrypt-env", "NEW_PASSWORD"],
      "env": { "NEW_PASSWORD": "Scenario-New-Secret-7d2a" },
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.message", "contains": "'flatopc' format cannot be password-protected" }, { "path": "error.details.option", "equals": "--encrypt-env" }],
        "files": { "nothingWritten": true },
        "hidden": ["Scenario-New-Secret-7d2a"]
      }
    },
    {
      "args": ["words", "create", "templated.xml", "--template", "template.xml", "--encrypt-env", "NEW_PASSWORD"],
      "env": { "NEW_PASSWORD": "Scenario-New-Secret-7d2a" },
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.message", "contains": "'flatopc' format cannot be password-protected" }],
        "files": { "nothingWritten": true },
        "hidden": ["Scenario-New-Secret-7d2a"]
      }
    },
    {
      "args": ["words", "create", "literal.xml", "--encrypt", "Scenario-New-Secret-7d2a"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.message", "contains": "'flatopc' format cannot be password-protected" }, { "path": "error.details.option", "equals": "--encrypt" }],
        "files": { "nothingWritten": true }
      }
    },
    { "args": ["words", "create", "plain.xml"], "expect": { "exitCode": 0, "json": [{ "path": "output.format", "equals": "flatopc" }], "files": { "present": ["plain.xml"] } } }
  ]
}
