{
  "name": "pdf edit --verify reports the text a redaction moved under its cover as an issue and exits 8, publishing the output; without --verify it warns and exits 0, and a redaction with nothing after it on its line moves nothing",
  "files": {
    "runs.pdf": { "base64": "" }
  },
  "steps": [
    {
      "args": ["pdf", "edit", "runs.pdf", "--ops", "[{\"op\":\"redact_text\",\"find\":\"Jane Roe\"}]", "--out", "verified.pdf", "--verify"],
      "expect": {
        "exitCode": 8,
        "warnings": { "present": ["REDACTION_TEXT_MOVED"] },
        "json": [
          { "path": "verification.ok", "equals": false },
          { "path": "verification.issues[0].code", "equals": "REDACTION_TEXT_MOVED" }
        ],
        "files": { "present": ["verified.pdf"], "unchanged": ["runs.pdf"] },
        "reopens": ["verified.pdf"]
      }
    },
    {
      "args": ["pdf", "edit", "runs.pdf", "--ops", "[{\"op\":\"redact_text\",\"find\":\"Jane Roe\"}]", "--out", "unverified.pdf"],
      "expect": {
        "exitCode": 0,
        "warnings": { "present": ["REDACTION_TEXT_MOVED"] },
        "files": { "present": ["unverified.pdf"] }
      }
    },
    {
      "args": ["pdf", "edit", "runs.pdf", "--ops", "[{\"op\":\"redact_text\",\"find\":\"the order.\"}]", "--out", "last.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "warnings": { "absent": ["REDACTION_TEXT_MOVED"] },
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.checkedOps", "contains": "op-0001" }
        ]
      }
    }
  ]
}
