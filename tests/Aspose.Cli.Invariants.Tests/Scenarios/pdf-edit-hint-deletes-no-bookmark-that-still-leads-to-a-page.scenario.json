{
  "name": "the delete_bookmarks operation a page deletion's hint gives, appended to the batch as written, deletes the bookmarks that lost their page and no other: a child under a listed parent is not listed again, and a parent that holds a bookmark that still leads to its page is named instead of deleted",
  "files": {
    "tree.pdf": { "base64": "" }
  },
  "steps": [
    {
      "args": ["pdf", "edit", "tree.pdf", "--ops", "[{\"op\":\"delete_pages\",\"pages\":\"1,4\"}]", "--out", "both.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "warnings", "contains": { "code": "NAVIGATION_DEGRADED", "message": "3 bookmark(s), 0 link(s) and 0 named destination(s) lead to pages the edit deleted.", "hint": "The pages they led to were deleted as the batch asked. Bookmarks you no longer need can be removed with {\"op\":\"delete_bookmarks\",\"bookmarks\":[\"1\",\"4\"]}." } }
        ]
      }
    },
    {
      "args": ["pdf", "edit", "tree.pdf", "--ops", "[{\"op\":\"delete_pages\",\"pages\":\"1,4\"},{\"op\":\"delete_bookmarks\",\"bookmarks\":[\"1\",\"4\"]}]", "--out", "both-cleaned.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "warnings": { "absent": ["NAVIGATION_DEGRADED"] },
        "json": [{ "path": "verification.ok", "equals": true }]
      }
    },
    {
      "args": ["pdf", "inspect", "both-cleaned.pdf", "--detail", "outline"],
      "expect": {
        "exitCode": 0,
        "json": [{ "path": "outline", "equals": [{ "title": "B2", "level": 1, "bookmark": "1", "page": 1 }, { "title": "B3", "level": 1, "bookmark": "2", "page": 2 }] }]
      }
    },
    {
      "args": ["pdf", "edit", "tree.pdf", "--ops", "[{\"op\":\"delete_pages\",\"pages\":\"4\"}]", "--out", "parent.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "warnings", "contains": { "code": "NAVIGATION_DEGRADED", "message": "1 bookmark(s), 0 link(s) and 0 named destination(s) lead to pages the edit deleted.", "hint": "The pages they led to were deleted as the batch asked. Bookmark(s) 4 of the output lost their page but hold other bookmarks, which deleting them deletes too, so keep them or tell the user." } }
        ]
      }
    },
    {
      "args": ["pdf", "inspect", "parent.pdf", "--detail", "outline"],
      "expect": {
        "exitCode": 0,
        "json": [{ "path": "outline[4]", "equals": { "title": "B4a", "level": 2, "bookmark": "4/1", "page": 1 } }]
      }
    },
    {
      "args": ["pdf", "edit", "tree.pdf", "--ops", "[{\"op\":\"delete_pages\",\"pages\":\"1\"}]", "--out", "child.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "warnings", "contains": { "code": "NAVIGATION_DEGRADED", "message": "2 bookmark(s), 0 link(s) and 0 named destination(s) lead to pages the edit deleted.", "hint": "The pages they led to were deleted as the batch asked. Bookmarks you no longer need can be removed with {\"op\":\"delete_bookmarks\",\"bookmarks\":[\"1\",\"4/1\"]}." } }
        ]
      }
    },
    {
      "args": ["pdf", "edit", "tree.pdf", "--ops", "[{\"op\":\"delete_pages\",\"pages\":\"1\"},{\"op\":\"delete_bookmarks\",\"bookmarks\":[\"1\",\"4/1\"]}]", "--out", "child-cleaned.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "warnings": { "absent": ["NAVIGATION_DEGRADED"] },
        "json": [{ "path": "verification.ok", "equals": true }]
      }
    },
    {
      "args": ["pdf", "inspect", "child-cleaned.pdf", "--detail", "outline"],
      "expect": {
        "exitCode": 0,
        "json": [{ "path": "outline", "equals": [{ "title": "B2", "level": 1, "bookmark": "1", "page": 1 }, { "title": "B3", "level": 1, "bookmark": "2", "page": 2 }, { "title": "B4", "level": 1, "bookmark": "3", "page": 3 }] }]
      }
    }
  ]
}
