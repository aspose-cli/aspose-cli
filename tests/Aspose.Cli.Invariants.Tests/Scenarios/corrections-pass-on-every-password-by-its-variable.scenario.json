{
  "name": "a corrected command line passes on a password given literally or on stdin by its -env option and a placeholder, never repeats it, and run with a variable protects its output",
  "steps": [
    {
      "args": ["cells", "create", "--out", "a.xlsx", "--encrypt", "Literal-Secret-81c4"],
      "expect": {
        "error": "USAGE_ERROR",
        "json": [
          { "path": "error.details.suggestions[0]", "equals": "aspose-cli cells create a.xlsx --encrypt-env \"<password-env>\" --output-format json" }
        ],
        "files": { "nothingWritten": true },
        "hidden": ["Literal-Secret-81c4"]
      }
    },
    {
      "args": ["cells", "create", "a.xlsx", "--encrypt-env", "SCENARIO_PASSWORD"],
      "env": { "SCENARIO_PASSWORD": "Literal-Secret-81c4" },
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["cells", "inspect", "a.xlsx"],
      "expect": { "error": "PASSWORD_REQUIRED" }
    },
    {
      "args": ["cells", "read", "file", "a.xlsx", "--password", "Literal-Secret-81c4"],
      "expect": {
        "error": "USAGE_ERROR",
        "json": [
          { "path": "error.hint", "equals": "Run 'aspose-cli cells read a.xlsx --password-env \"<password-env>\" --output-format json'." }
        ],
        "hidden": ["Literal-Secret-81c4"]
      }
    },
    {
      "args": ["cells", "read", "file", "a.xlsx", "--password-stdin"],
      "stdin": "Literal-Secret-81c4\n",
      "expect": {
        "error": "USAGE_ERROR",
        "json": [
          { "path": "error.hint", "equals": "Run 'aspose-cli cells read a.xlsx --password-env \"<password-env>\" --output-format json'." }
        ],
        "hidden": ["Literal-Secret-81c4"]
      }
    },
    {
      "args": ["cells", "read", "a.xlsx", "--password-env", "SCENARIO_PASSWORD"],
      "env": { "SCENARIO_PASSWORD": "Literal-Secret-81c4" },
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["read", "a.xlsx", "--password", "Literal-Secret-81c4"],
      "expect": {
        "error": "USAGE_ERROR",
        "json": [
          { "path": "error.hint", "equals": "Did you mean 'cells read'? Run 'aspose-cli cells read a.xlsx --password-env \"<password-env>\" --output-format json'." }
        ],
        "hidden": ["Literal-Secret-81c4"]
      }
    },
    {
      "args": ["cells", "review", "a.xlsx", "--password", "Literal-Secret-81c4"],
      "expect": {
        "error": "USAGE_ERROR",
        "json": [
          { "path": "error.details.suggestions[0]", "equals": "aspose-cli review a.xlsx --password-env \"<password-env>\" --output-format json" }
        ],
        "hidden": ["Literal-Secret-81c4"]
      }
    },
    {
      "args": ["cells", "create", "--out", "b.xlsx", "--encrypt-env", "SCENARIO_PASSWORD"],
      "env": { "SCENARIO_PASSWORD": "Literal-Secret-81c4" },
      "expect": {
        "error": "USAGE_ERROR",
        "json": [
          { "path": "error.details.suggestions[0]", "equals": "aspose-cli cells create b.xlsx --encrypt-env SCENARIO_PASSWORD --output-format json" }
        ]
      }
    },
    {
      "args": ["cells", "create", "--out", "c.xlsx"],
      "expect": {
        "error": "USAGE_ERROR",
        "json": [
          { "path": "error.details.suggestions[0]", "equals": "aspose-cli cells create c.xlsx --output-format json" }
        ]
      }
    }
  ]
}
