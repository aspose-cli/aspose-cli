{
  "name": "the window cells render names for an image too large to read of an encrypted workbook passes on its password variable",
  "steps": [
    {
      "args": ["cells", "create", "tall.xlsx", "--sheet-names", "Data", "--encrypt-env", "BOOK_PASSWORD"],
      "env": { "BOOK_PASSWORD": "hint-secret-7d2a" },
      "expect": { "exitCode": 0 }
    },
    {
      "args": [
        "cells", "edit", "tall.xlsx", "--password-env", "BOOK_PASSWORD", "--in-place", "--ops",
        "{\"ops\":[{\"op\":\"set_values\",\"sheet\":\"Data\",\"range\":\"A1\",\"values\":[[\"Top\"]]},{\"op\":\"set_values\",\"sheet\":\"Data\",\"range\":\"A30\",\"values\":[[\"Bottom\"]]},{\"op\":\"resize_rows\",\"sheet\":\"Data\",\"first\":1,\"last\":30,\"height\":400}]}"
      ],
      "env": { "BOOK_PASSWORD": "hint-secret-7d2a" },
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["cells", "render", "tall.xlsx", "--password-env", "BOOK_PASSWORD", "--out", "tall.png"],
      "env": { "BOOK_PASSWORD": "hint-secret-7d2a" },
      "expect": {
        "exitCode": 0,
        "warnings": { "present": ["RENDER_IMAGE_LARGE"] },
        "hidden": ["hint-secret-7d2a"]
      }
    }
  ]
}
