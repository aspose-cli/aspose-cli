{
  "name": "cells edit names the rows of a kind for a row it does not have, and says what an argument of an action takes",
  "steps": [
    { "args": ["cells", "create", "book.xlsx"], "expect": { "exitCode": 0 } },
    {
      "args": ["cells", "edit", "book.xlsx", "--in-place", "--ops", "{\"ops\":[{\"set\":\"sheet/Sheet1\",\"props\":{\"to\":\"Sales\"}}]}"],
      "expect": {
        "exitCode": 4,
        "error": "OPS_INVALID",
        "json": [
          { "path": "error.details.reason", "equals": "unknown-field" },
          { "path": "error.details.field", "equals": "props.to" },
          { "path": "error.details.at", "equals": "sheet/Sheet1" },
          { "path": "error.details.available", "equals": ["autoFilter.range", "isGridlinesVisible", "isRowColumnHeadersVisible", "name", "tabColor", "visibilityType", "zoom"] }
        ],
        "files": { "unchanged": ["book.xlsx"], "nothingWritten": true }
      }
    },
    {
      "args": ["cells", "edit", "book.xlsx", "--in-place", "--ops", "{\"ops\":[{\"do\":\"sort\",\"args\":{\"range\":\"sheet/Sheet1/range/A1:B4\",\"hasHeaders\":true,\"keys\":[{\"column\":\"A\",\"direction\":\"desc\"}]}}]}"],
      "expect": {
        "exitCode": 4,
        "error": "OPS_INVALID",
        "json": [
          { "path": "error.details.reason", "equals": "invalid-value" },
          { "path": "error.details.field", "equals": "args.keys" },
          { "path": "error.message", "contains": "a key with column and order" }
        ],
        "files": { "unchanged": ["book.xlsx"], "nothingWritten": true }
      }
    }
  ]
}
