{
  "name": "pdf merge refuses a single input before it resolves the output or reads a password",
  "files": {
    "one.pdf": { "fixture": "pdf.pdf" },
    "two.pdf": { "fixture": "pdf.pdf" }
  },
  "steps": [
    {
      "args": ["pdf", "merge", "one.pdf", "--out", "merged.pdf", "--password-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 2,
        "error": "USAGE_ERROR",
        "json": [{ "path": "error.message", "contains": "Pass at least two PDF inputs to merge." }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "merge", "one.pdf", "--out", "merged.pdf", "--encrypt-stdin"],
      "stdin": "",
      "expect": {
        "exitCode": 2,
        "error": "USAGE_ERROR",
        "json": [{ "path": "error.message", "contains": "Pass at least two PDF inputs to merge." }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "merge", "one.pdf", "--out", "merged.txt"],
      "expect": {
        "exitCode": 2,
        "error": "USAGE_ERROR",
        "json": [{ "path": "error.message", "contains": "Pass at least two PDF inputs to merge." }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "merge", "one.pdf", "two.pdf", "--out", "merged.pdf", "--password-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--password-env" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "merge", "missing.pdf", "--out", "merged.pdf", "--password-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 3,
        "error": "FILE_NOT_FOUND",
        "files": { "nothingWritten": true }
      }
    }
  ]
}
