{
  "name": "slides insert_image with alternative text that holds a tab warns ALT_TEXT_TABS_DROPPED at the picture, since the saved presentation does not keep the tab (known issue SLIDES-ALT-TEXT-TAB), and writes the text as given",
  "files": {
    "deck.md": { "text": "# T\n" },
    "dot.png": { "base64": "iVBORw0KGgoAAAANSUhEUgAAACgAAAAoCAIAAAADnC86AAAAMElEQVR4nO3NMQ0AAAgDsCmZfynIwgQJT5P+zbQvIhaLxWKxWCwWi8VisVgsFvcsXhHvWVsvWSOBAAAAAElFTkSuQmCC" }
  },
  "steps": [
    {
      "args": ["slides", "create", "deck.pptx", "--from-markdown", "deck.md"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["slides", "edit", "deck.pptx", "--out", "tab.pptx", "--ops", "{\"ops\":[{\"op\":\"insert_image\",\"slide\":1,\"path\":\"dot.png\",\"rect\":{\"x\":10,\"y\":10,\"width\":40,\"height\":40},\"altText\":\"a\\tb\"}]}"],
      "expect": {
        "exitCode": 0,
        "warnings": { "present": ["ALT_TEXT_TABS_DROPPED"] },
        "json": [
          { "path": "warnings[code=ALT_TEXT_TABS_DROPPED][0].location", "startsWith": "slide/1/shape/" },
          { "path": "warnings[code=ALT_TEXT_TABS_DROPPED][0].message", "contains": "SLIDES-ALT-TEXT-TAB" },
          { "path": "warnings[code=ALT_TEXT_TABS_DROPPED][1]", "exists": false }
        ]
      }
    }
  ]
}
