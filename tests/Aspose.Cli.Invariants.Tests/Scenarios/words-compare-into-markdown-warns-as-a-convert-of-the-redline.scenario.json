{
  "name": "words compare into Markdown warns of the revisions it mixes into the text, as a convert of the redline does, and names the headers and footers once",
  "files": {
    "left.docx": { "fixture": "words.rich" },
    "change.json": { "text": "{\"ops\":[{\"op\":\"replace_text\",\"find\":\"ZqxBd\",\"replace\":\"ZqxBe\"}]}" }
  },
  "steps": [
    {
      "args": ["words", "edit", "left.docx", "--ops", "change.json", "--out", "right.docx"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["words", "compare", "left.docx", "right.docx", "--out", "redline.md"],
      "expect": {
        "exitCode": 0,
        "warnings": { "only": ["LOSSY_CONVERSION", "LOSSY_CONVERSION", "LOSSY_CONVERSION", "LOSSY_CONVERSION"] },
        "json": [
          { "path": "warnings[code=LOSSY_CONVERSION][0].message", "equals": "Conversion to md cannot preserve every Word feature." },
          { "path": "warnings[code=LOSSY_CONVERSION][1].details.content", "equals": ["headers-footers"] },
          { "path": "warnings[code=LOSSY_CONVERSION][2].details.content", "equals": ["comments"] },
          { "path": "warnings[code=LOSSY_CONVERSION][3].details.content", "equals": ["revisions"] },
          { "path": "warnings[code=LOSSY_CONVERSION][3].message", "startsWith": "The md output writes the deleted and moved-from text of tracked changes" },
          { "path": "warnings[code=LOSSY_CONVERSION][3].hint", "equals": "To see what changed, write the redline as DOCX, PDF or HTML, which mark the changes." }
        ]
      }
    },
    {
      "args": ["words", "compare", "left.docx", "right.docx", "--out", "redline.docx"],
      "expect": { "exitCode": 0, "warnings": { "absent": ["LOSSY_CONVERSION"] } }
    },
    {
      "args": ["words", "convert", "redline.docx", "--to", "md", "--out", "converted.md"],
      "expect": {
        "exitCode": 0,
        "warnings": { "only": ["LOSSY_CONVERSION", "LOSSY_CONVERSION", "LOSSY_CONVERSION", "LOSSY_CONVERSION"] },
        "json": [
          { "path": "warnings[code=LOSSY_CONVERSION][0].message", "equals": "Conversion to md cannot preserve every Word feature." },
          { "path": "warnings[code=LOSSY_CONVERSION][1].details.content", "equals": ["headers-footers"] },
          { "path": "warnings[code=LOSSY_CONVERSION][2].details.content", "equals": ["comments"] },
          { "path": "warnings[code=LOSSY_CONVERSION][3].details.content", "equals": ["revisions"] }
        ]
      }
    }
  ]
}
