{
  "name": "slides read --max-chars cuts a text before a character of two code units, an emoji here, rather than inside it, so what it reports is still whole characters",
  "files": {
    "deck.md": { "text": "# T\n" }
  },
  "steps": [
    {
      "args": ["slides", "create", "deck.pptx", "--from-markdown", "deck.md"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["slides", "edit", "deck.pptx", "--ops", "{\"ops\":[{\"op\":\"set_title\",\"slide\":1,\"text\":\"a\\ud83d\\ude00b\"}]}", "--out", "emoji.pptx"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["slides", "read", "emoji.pptx", "--max-chars", "2"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "slides[0].title", "equals": "a" },
          { "path": "slides[0].contentTruncated", "equals": true }
        ]
      }
    }
  ]
}
