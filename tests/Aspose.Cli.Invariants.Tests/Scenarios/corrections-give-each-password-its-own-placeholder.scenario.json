{
  "name": "a corrected command line with two passwords gives each its own placeholder, so two variables in their place keep them apart, and a line with one keeps <password-env>",
  "steps": [
    {
      "args": ["cells", "create", "enc.xlsx", "--encrypt-env", "OPEN_PASSWORD"],
      "env": { "OPEN_PASSWORD": "Open-Secret-1a2b" },
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["cells", "convert", "file", "enc.xlsx", "--to", "xlsx", "--out", "o.xlsx", "--password", "Open-Secret-1a2b", "--encrypt", "Out-Secret-3c4d"],
      "expect": {
        "error": "USAGE_ERROR",
        "files": { "nothingWritten": true },
        "hidden": ["Open-Secret-1a2b", "Out-Secret-3c4d"]
      }
    },
    {
      "args": ["cells", "convert", "enc.xlsx", "--to", "xlsx", "--out", "o.xlsx", "--password-env", "OPEN_PASSWORD", "--encrypt-env", "OUT_PASSWORD"],
      "env": { "OPEN_PASSWORD": "Open-Secret-1a2b", "OUT_PASSWORD": "Out-Secret-3c4d" },
      "expect": { "exitCode": 0, "files": { "present": ["o.xlsx"] } }
    },
    {
      "args": ["cells", "read", "o.xlsx", "--password-env", "OUT_PASSWORD"],
      "env": { "OUT_PASSWORD": "Out-Secret-3c4d" },
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["cells", "read", "o.xlsx", "--password-env", "OPEN_PASSWORD"],
      "env": { "OPEN_PASSWORD": "Open-Secret-1a2b" },
      "expect": { "error": "PASSWORD_INVALID" }
    },
    {
      "args": ["cells", "convert", "file", "enc.xlsx", "--to", "xlsx", "--out", "p.xlsx", "--password-env", "OPEN_PASSWORD", "--encrypt", "Out-Secret-3c4d"],
      "env": { "OPEN_PASSWORD": "Open-Secret-1a2b" },
      "expect": {
        "error": "USAGE_ERROR",
        "hidden": ["Out-Secret-3c4d"]
      }
    },
    {
      "args": ["cells", "convert", "file", "enc.xlsx", "--to", "xlsx", "--out", "p.xlsx", "--password", "Open-Secret-1a2b"],
      "expect": {
        "error": "USAGE_ERROR",
        "hidden": ["Open-Secret-1a2b"]
      }
    }
  ]
}
