{
  "name": "a search reports a mistake in its own options before it reads the input password, as read and edit do",
  "files": {
    "doc.docx": { "fixture": "words.docx" }
  },
  "steps": [
    {
      "args": ["words", "search", "doc.docx", "--pattern", "(", "--regex", "--password-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--pattern" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["words", "search", "doc.docx", "--pattern", "Total", "--max-hits", "0", "--password-stdin"],
      "stdin": "",
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--max-hits" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["words", "search", "doc.docx", "--pattern", "Total", "--skip", "-1", "--password", ""],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--skip" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["words", "search", "doc.docx", "--pattern", "Total", "--password-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--password-env" }],
        "files": { "nothingWritten": true }
      }
    }
  ]
}
