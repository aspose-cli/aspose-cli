{
  "name": "words read and extract --what text name the comments anchored in the text they return, which a comment's own story holds, with the inspect that lists them; a text or Markdown convert writes them into the body and says so, and a Word output keeps them",
  "files": {
    "source.md": { "text": "# Terms\n\nPayment is due in thirty days.\n\nDelivery is free.\n\nNo comment here.\n" },
    "comments.json": { "text": "{\"ops\":[{\"op\":\"add_comment\",\"target\":{\"block\":2},\"author\":\"Ann\",\"text\":\"Check the term.\"},{\"op\":\"add_comment\",\"target\":{\"block\":3},\"author\":\"Bob\",\"text\":\"Only in Europe.\"}]}" }
  },
  "steps": [
    {
      "args": ["words", "create", "plain.docx", "--from-markdown", "source.md"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["words", "edit", "plain.docx", "--ops", "comments.json", "--out", "commented.docx"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["words", "read", "commented.docx"],
      "expect": {
        "exitCode": 0,
        "warnings": { "only": ["COMMENTS_NOT_IN_TEXT"] },
        "json": [
          { "path": "blocks[1].text", "equals": "Payment is due in thirty days." },
          { "path": "warnings[code=COMMENTS_NOT_IN_TEXT][0].message", "equals": "The text leaves out the 2 comment(s) anchored in it: a comment is not body text." }
        ]
      }
    },
    {
      "args": ["words", "read", "commented.docx", "--blocks", "3-4"],
      "expect": {
        "exitCode": 0,
        "json": [{ "path": "warnings[code=COMMENTS_NOT_IN_TEXT][0].message", "equals": "The text leaves out the 1 comment(s) anchored in it: a comment is not body text." }]
      }
    },
    {
      "args": ["words", "read", "commented.docx", "--blocks", "4"],
      "expect": { "exitCode": 0, "warnings": { "only": [] } }
    },
    {
      "args": ["words", "extract", "commented.docx", "--what", "text", "--out-dir", "text"],
      "expect": {
        "exitCode": 0,
        "warnings": { "only": ["COMMENTS_NOT_IN_TEXT"] },
        "json": [{ "path": "warnings[code=COMMENTS_NOT_IN_TEXT][0].message", "equals": "The text leaves out the 2 comment(s) anchored in it: a comment is not body text." }]
      }
    },
    {
      "args": ["words", "inspect", "commented.docx", "--detail", "comments"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "comments[0].text", "equals": "Check the term." },
          { "path": "comments[1].text", "equals": "Only in Europe." }
        ]
      }
    },
    {
      "args": ["words", "convert", "commented.docx", "--to", "md"],
      "expect": {
        "exitCode": 0,
        "warnings": { "absent": ["COMMENTS_NOT_IN_TEXT"] },
        "json": [{ "path": "warnings[code=LOSSY_CONVERSION][1].message", "equals": "The md output writes the text of 2 comment(s) into the body text, where it reads as document text." }]
      }
    },
    {
      "args": ["words", "convert", "commented.docx", "--to", "txt"],
      "expect": {
        "exitCode": 0,
        "warnings": { "absent": ["COMMENTS_NOT_IN_TEXT"] },
        "json": [{ "path": "warnings[code=LOSSY_CONVERSION][1].message", "equals": "The txt output writes the text of 2 comment(s) into the body text, where it reads as document text." }]
      }
    },
    {
      "args": ["words", "convert", "commented.docx", "--to", "docx", "--out", "copy.docx"],
      "expect": { "exitCode": 0, "warnings": { "only": [] } }
    },
    {
      "args": ["words", "read", "plain.docx"],
      "expect": { "exitCode": 0, "warnings": { "only": [] } }
    }
  ]
}
