{
  "name": "pdf edit --verify keeps checking a field set before a page operation when a later redact_area covers another page, and expects it gone where the redact_area covers its widget on the page it moved to",
  "files": {
    "form.html": { "text": "<html><head><meta charset=\"utf-8\"><title>Registration</title></head><body><h1>Registration Form</h1><p>Name: <input type=\"text\" name=\"applicant\" value=\"\"></p><p>ID No.: <input type=\"text\" name=\"idno\" value=\"\"></p><p>Mobile: <input type=\"text\" name=\"mobile\" value=\"13812345678\"></p></body></html>" },
    "blank-page.json": { "text": "{\"ops\":[{\"op\":\"set_form_field\",\"name\":\"idno\",\"value\":\"110101199003071234\"},{\"op\":\"insert_page\",\"at\":2},{\"op\":\"redact_area\",\"page\":2,\"rect\":{\"x\":0,\"y\":0,\"width\":50,\"height\":50}}]}" },
    "moved-field.json": { "text": "{\"ops\":[{\"op\":\"set_form_field\",\"name\":\"idno\",\"value\":\"110101199003071234\"},{\"op\":\"insert_page\",\"at\":1},{\"op\":\"redact_area\",\"page\":2,\"rect\":{\"x\":130,\"y\":112,\"width\":80,\"height\":22}}]}" }
  },
  "steps": [
    {
      "args": ["pdf", "create", "form.pdf", "--from-html", "form.html"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["pdf", "edit", "form.pdf", "--ops", "blank-page.json", "--out", "blank.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.checkedOps", "contains": "op-0001" },
          { "path": "verification.checkedOps", "contains": "op-0002" }
        ]
      }
    },
    {
      "args": ["pdf", "edit", "form.pdf", "--ops", "moved-field.json", "--out", "moved.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.checkedOps", "notContains": "op-0001" },
          { "path": "verification.uncheckedOps[1].id", "equals": "op-0003" },
          { "path": "verification.uncheckedOps[1].reason", "equals": "Only that the form fields an earlier set_form_field of the batch set and its area covers are gone was read back; render the page to confirm the cover." }
        ]
      }
    },
    {
      "args": ["pdf", "inspect", "moved.pdf", "--detail", "forms"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "forms.fields[1].name", "notContains": "idno" },
          { "path": "forms.fieldCount", "equals": 2 }
        ]
      }
    }
  ]
}
