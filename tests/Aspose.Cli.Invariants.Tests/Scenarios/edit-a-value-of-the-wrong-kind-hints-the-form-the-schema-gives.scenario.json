{
  "name": "an operation field given a value of the wrong JSON kind hints the form the schema describes for its kind of value, such as a page range, in every product of operations, with the same error details; a field without such a kind keeps its own description",
  "files": { "doc.pdf": { "fixture": "pdf.pdf" } },
  "steps": [
    {
      "args": ["pdf", "edit", "doc.pdf", "--ops", "{\"ops\":[{\"op\":\"delete_pages\",\"pages\":[1]}]}", "--out", "out.pdf"],
      "expect": { "exitCode": 4, "error": "OPS_INVALID", "json": [{ "path": "error.details", "equals": { "id": "op-0001", "op": "delete_pages", "reason": "wrong-type", "field": "pages" } }], "files": { "nothingWritten": true } }
    },
    { "args": ["pdf", "edit", "doc.pdf", "--ops", "{\"ops\":[{\"op\":\"delete_pages\",\"pages\":2}]}", "--out", "out.pdf"], "expect": { "exitCode": 4, "error": "OPS_INVALID", "files": { "nothingWritten": true } } }
  ]
}
