{
  "name": "an operation field given a value of the wrong JSON kind hints the form the schema describes for its kind of value, such as a page range or an A1 range, in every product, with the same error details; a field without such a kind keeps its own description",
  "files": {
    "deck.pptx": { "fixture": "slides.pptx" },
    "doc.pdf": { "fixture": "pdf.pdf" },
    "book.xlsx": { "fixture": "cells.xlsx" }
  },
  "steps": [
    {
      "args": ["slides", "edit", "deck.pptx", "--ops", "{\"ops\":[{\"op\":\"delete_slides\",\"slides\":[2]}]}", "--out", "out.pptx"],
      "expect": {
        "exitCode": 4,
        "error": "OPS_INVALID",
        "json": [
          { "path": "error.details", "equals": { "id": "op-0001", "op": "delete_slides", "reason": "wrong-type", "field": "slides" } },
          { "path": "error.hint", "startsWith": "'slides' is the slides to delete: 1-based numbers and ranges separated by commas, such as 1-3,7,9-;" }
        ],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "edit", "doc.pdf", "--ops", "{\"ops\":[{\"op\":\"delete_pages\",\"pages\":[1]}]}", "--out", "out.pdf"],
      "expect": {
        "exitCode": 4,
        "error": "OPS_INVALID",
        "json": [
          { "path": "error.details", "equals": { "id": "op-0001", "op": "delete_pages", "reason": "wrong-type", "field": "pages" } },
          { "path": "error.hint", "startsWith": "'pages' is the pages to delete: 1-based numbers and ranges separated by commas, such as 1-3,7,9-;" }
        ],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["cells", "edit", "book.xlsx", "--ops", "{\"ops\":[{\"op\":\"clear_range\",\"sheet\":\"Sheet1\",\"range\":[\"A1:B2\"]}]}", "--out", "out.xlsx"],
      "expect": {
        "exitCode": 4,
        "error": "OPS_INVALID",
        "json": [
          { "path": "error.details", "equals": { "id": "op-0001", "op": "clear_range", "reason": "wrong-type", "field": "range" } },
          { "path": "error.hint", "contains": ": an A1 cell or range on the operation's sheet, such as B2 or B2:D10;" }
        ],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["slides", "edit", "deck.pptx", "--ops", "{\"ops\":[{\"op\":\"delete_slides\",\"slides\":2}]}", "--out", "out.pptx"],
      "expect": {
        "exitCode": 4,
        "error": "OPS_INVALID",
        "json": [ { "path": "error.hint", "contains": "such as 1-3,7,9-" } ],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["slides", "edit", "deck.pptx", "--ops", "{\"ops\":[{\"op\":\"delete_shape\",\"slide\":\"1\",\"shapeId\":2}]}", "--out", "out.pptx"],
      "expect": {
        "exitCode": 4,
        "error": "OPS_INVALID",
        "json": [ { "path": "error.hint", "startsWith": "'slide' is the 1-based slide number. Fix the named operation;" } ],
        "files": { "nothingWritten": true }
      }
    }
  ]
}
