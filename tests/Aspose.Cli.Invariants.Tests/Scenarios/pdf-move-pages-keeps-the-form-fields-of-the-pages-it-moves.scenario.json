{
  "name": "pdf edit move_pages keeps the form fields of the pages it moves: after any move the fields keep their names, values and widgets on the moved page, a value set after the move is the one the page shows, a redact_area over it leaves the value nowhere; a field with widgets on pages the move leaves is refused, and import_pages still names the fields it brings apart",
  "files": {
    "form.html": {
      "text": "<html><head><meta charset=\"utf-8\"><title>Registration</title></head><body><h1>Registration Form</h1><p>Name: <input type=\"text\" name=\"applicant\" value=\"\"></p><p>ID No.: <input type=\"text\" name=\"idno\" value=\"\"></p><p>Mobile: <input type=\"text\" name=\"mobile\" value=\"13812345678\"></p></body></html>"
