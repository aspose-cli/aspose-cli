        "inspect",
        "inserted.pdf",
        "--detail",
        "forms"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "forms.fieldCount",
            "equals": 3
          },
          {
            "path": "forms.fields[0].name",
            "equals": "applicant"
          },
          {
            "path": "forms.fields[0].page",
            "equals": 2
