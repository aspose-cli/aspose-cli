{
  "name": "a review that --max-items stopped after the first part, in every product alike (three slides, pages or PDF pages, and five sheets of a workbook evaluation mode saved twice, with its two warning sheets, in either run), says in one finding how many it rendered of how many, as its coverage counts them, and which it left out, and its hint names the review of every part in a new directory, which is complete, names nothing left out and is refused a second time over its own output",
  "files": {
    "deck.md": { "text": "# One\n\n- Point\n\n# Two\n\n- Point\n\n# Three\n\n- Point\n" },
    "doc.md": { "text": "# Report\n\nOne\n\nTwo\n" },
    "breaks.json": { "text": "{\"ops\":[{\"op\":\"insert_break\",\"at\":{\"block\":3},\"position\":\"before\",\"kind\":\"page\"},{\"op\":\"insert_break\",\"at\":{\"block\":2},\"position\":\"before\",\"kind\":\"page\"}]}" }
  },
  "steps": [
    {
      "args": ["cells", "create", "book.xlsx", "--sheet-names", "A,B,C", "--license-mode", "evaluation"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["cells", "edit", "book.xlsx", "--in-place", "--set", "A!A1=Hello", "--set", "B!A1=Hello", "--set", "C!A1=Hello", "--license-mode", "evaluation"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["review", "book.xlsx", "--max-items", "1", "--out", "book"],
      "expect": {
        "exitCode": 8,
        "json": [
          { "path": "coverage.renderedItemCount", "equals": 1 },
          { "path": "coverage.expectedItemCount", "equals": 5 },
          { "path": "findings[code=CELLS_REVIEW_TRUNCATED][1]", "exists": false },
          { "path": "findings[code=CELLS_REVIEW_TRUNCATED][0].message", "contains": "rendered 1 of 5 sheets, the most --max-items allows" },
          { "path": "findings[code=CELLS_REVIEW_TRUNCATED][0].message", "contains": "the 4 after the first 1 (2-5 in the view's order)" },
          { "path": "findings[code=CELLS_REVIEW_TRUNCATED][0].hint", "contains": " --max-items 5 --out " },
          { "path": "findings[code=CELLS_REVIEW_TRUNCATED][0].hint", "contains": "book-all\" --output-format json'" }
        ]
      }
    },
    {
      "args": ["review", "book.xlsx", "--max-items", "5", "--out", "book-all"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "coverage.renderedItemCount", "equals": 5 },
          { "path": "coverage.complete", "equals": true },
          { "path": "findings[code=CELLS_REVIEW_TRUNCATED]", "exists": false }
        ]
      }
    },
    {
      "args": ["review", "book.xlsx", "--max-items", "5", "--out", "book-all"],
      "expect": { "error": "OUTPUT_EXISTS" }
    },
    {
      "args": ["slides", "create", "deck.pptx", "--from-markdown", "deck.md"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["review", "deck.pptx", "--max-items", "1", "--out", "deck"],
      "expect": {
        "exitCode": 8,
        "json": [
          { "path": "coverage.renderedItemCount", "equals": 1 },
          { "path": "coverage.expectedItemCount", "equals": 3 },
          { "path": "findings[code=SLIDES_REVIEW_TRUNCATED][1]", "exists": false },
          { "path": "findings[code=SLIDES_REVIEW_TRUNCATED][0].message", "contains": "rendered 1 of 3 slides, the most --max-items allows" },
          { "path": "findings[code=SLIDES_REVIEW_TRUNCATED][0].message", "contains": "the 2 after the first 1 (2-3 in the view's order)" },
          { "path": "findings[code=SLIDES_REVIEW_TRUNCATED][0].hint", "contains": " --max-items 3 --out " },
          { "path": "findings[code=SLIDES_REVIEW_TRUNCATED][0].hint", "contains": "deck-all\" --output-format json'" }
        ]
      }
    },
    {
      "args": ["review", "deck.pptx", "--max-items", "3", "--out", "deck-all"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "coverage.renderedItemCount", "equals": 3 },
          { "path": "coverage.complete", "equals": true },
          { "path": "findings[code=SLIDES_REVIEW_TRUNCATED]", "exists": false }
        ]
      }
    },
    {
      "args": ["review", "deck.pptx", "--max-items", "3", "--out", "deck-all"],
      "expect": { "error": "OUTPUT_EXISTS" }
    },
    {
      "args": ["words", "create", "doc.docx", "--from-markdown", "doc.md"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["words", "edit", "doc.docx", "--in-place", "--ops", "breaks.json"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["review", "doc.docx", "--max-items", "1", "--out", "doc"],
      "expect": {
        "exitCode": 8,
        "json": [
          { "path": "coverage.renderedItemCount", "equals": 1 },
          { "path": "coverage.expectedItemCount", "equals": 3 },
          { "path": "findings[code=WORDS_REVIEW_TRUNCATED][1]", "exists": false },
          { "path": "findings[code=WORDS_REVIEW_TRUNCATED][0].message", "contains": "rendered 1 of 3 pages, the most --max-items allows" },
          { "path": "findings[code=WORDS_REVIEW_TRUNCATED][0].message", "contains": "the 2 after the first 1 (2-3 in the view's order)" },
          { "path": "findings[code=WORDS_REVIEW_TRUNCATED][0].hint", "contains": " --max-items 3 --out " },
          { "path": "findings[code=WORDS_REVIEW_TRUNCATED][0].hint", "contains": "doc-all\" --output-format json'" }
        ]
      }
    },
    {
      "args": ["review", "doc.docx", "--max-items", "3", "--out", "doc-all"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "coverage.renderedItemCount", "equals": 3 },
          { "path": "coverage.complete", "equals": true },
          { "path": "findings[code=WORDS_REVIEW_TRUNCATED]", "exists": false }
        ]
      }
    },
    {
      "args": ["review", "doc.docx", "--max-items", "3", "--out", "doc-all"],
      "expect": { "error": "OUTPUT_EXISTS" }
    },
    {
      "args": ["words", "convert", "doc.docx", "--to", "pdf", "--out", "doc.pdf"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["review", "doc.pdf", "--max-items", "1", "--out", "pdf"],
      "expect": {
        "exitCode": 8,
        "json": [
          { "path": "coverage.renderedItemCount", "equals": 1 },
          { "path": "coverage.expectedItemCount", "equals": 3 },
          { "path": "findings[code=PDF_REVIEW_TRUNCATED][1]", "exists": false },
          { "path": "findings[code=PDF_REVIEW_TRUNCATED][0].message", "contains": "rendered 1 of 3 pages, the most --max-items allows" },
          { "path": "findings[code=PDF_REVIEW_TRUNCATED][0].message", "contains": "the 2 after the first 1 (2-3 in the view's order)" },
          { "path": "findings[code=PDF_REVIEW_TRUNCATED][0].hint", "contains": " --max-items 3 --out " },
          { "path": "findings[code=PDF_REVIEW_TRUNCATED][0].hint", "contains": "pdf-all\" --output-format json'" }
        ]
      }
    },
    {
      "args": ["review", "doc.pdf", "--max-items", "3", "--out", "pdf-all"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "coverage.renderedItemCount", "equals": 3 },
          { "path": "coverage.complete", "equals": true },
          { "path": "findings[code=PDF_REVIEW_TRUNCATED]", "exists": false }
        ]
      }
    },
    {
      "args": ["review", "doc.pdf", "--max-items", "3", "--out", "pdf-all"],
      "expect": { "error": "OUTPUT_EXISTS" }
    }
  ]
}
