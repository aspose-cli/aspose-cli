{
  "name": "pdf edit --verify expects a field a later redact_text of the batch clears to be clear, checks a value set after it or one it does not match, and keeps the redaction checked when the field was flattened or covered",
  "files": {
    "form.html": { "text": "<html><head><meta charset=\"utf-8\"><title>Registration</title></head><body><h1>Registration Form</h1><p>Name: <input type=\"text\" name=\"applicant\" value=\"\"></p><p>ID No.: <input type=\"text\" name=\"idno\" value=\"\"></p><p>Mobile: <input type=\"text\" name=\"mobile\" value=\"13812345678\"></p></body></html>" },
    "fill-then-redact.json": { "text": "{\"ops\":[{\"op\":\"set_form_field\",\"name\":\"idno\",\"value\":\"110101199003071234\"},{\"op\":\"redact_text\",\"find\":\"110101199003071234\"}]}" },
    "redact-then-fill.json": { "text": "{\"ops\":[{\"op\":\"set_form_field\",\"name\":\"idno\",\"value\":\"110101199003071234\"},{\"op\":\"redact_text\",\"find\":\"110101199003071234\"},{\"op\":\"set_form_field\",\"name\":\"idno\",\"value\":\"PENDING\"}]}" },
    "fill-flatten-redact.json": { "text": "{\"ops\":[{\"op\":\"set_form_field\",\"name\":\"idno\",\"value\":\"110101199003071234\"},{\"op\":\"flatten_forms\"},{\"op\":\"redact_text\",\"find\":\"110101199003071234\"}]}" },
    "fill-cover-redact.json": { "text": "{\"ops\":[{\"op\":\"set_form_field\",\"name\":\"applicant\",\"value\":\"Li Lei\"},{\"op\":\"set_form_field\",\"name\":\"idno\",\"value\":\"110101199003071234\"},{\"op\":\"redact_area\",\"page\":1,\"rect\":{\"x\":81,\"y\":114,\"width\":120,\"height\":18}},{\"op\":\"redact_text\",\"find\":\"Li Lei\"}]}" },
    "skill-example.json": { "text": "{ \"ops\": [\n  { \"op\": \"set_form_field\", \"name\": \"applicant\", \"value\": \"Li Lei\" },\n  { \"op\": \"redact_text\", \"find\": \"1[3-9]\\\\d{9}\", \"regex\": true },\n  { \"op\": \"add_page_numbers\", \"text\": \"{n} / {N}\" },\n  { \"op\": \"encrypt_document\", \"userPasswordEnv\": \"PASSWORD\", \"ownerPasswordEnv\": \"OWNERPASSWORD\", \"permissions\": { \"print\": true } }\n] }\n" }
  },
  "steps": [
    {
      "args": ["pdf", "create", "form.pdf", "--from-html", "form.html"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["pdf", "edit", "form.pdf", "--ops", "fill-then-redact.json", "--out", "redacted.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.checkedOps", "contains": "op-0001" },
          { "path": "verification.checkedOps", "contains": "op-0002" }
        ]
      }
    },
    {
      "args": ["pdf", "inspect", "redacted.pdf", "--detail", "forms"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "forms.fields[1].name", "equals": "idno" },
          { "path": "forms.fields[1].value", "equals": "" }
        ]
      }
    },
    {
      "args": ["pdf", "edit", "form.pdf", "--ops", "redact-then-fill.json", "--out", "refilled.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.checkedOps", "contains": "op-0002" },
          { "path": "verification.checkedOps", "contains": "op-0003" }
        ]
      }
    },
    {
      "args": ["pdf", "inspect", "refilled.pdf", "--detail", "forms"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "forms.fields[1].name", "equals": "idno" },
          { "path": "forms.fields[1].value", "equals": "PENDING" }
        ]
      }
    },
    {
      "args": ["pdf", "edit", "form.pdf", "--ops", "fill-flatten-redact.json", "--out", "flattened.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.checkedOps", "contains": "op-0002" },
          { "path": "verification.checkedOps", "contains": "op-0003" }
        ]
      }
    },
    {
      "args": ["pdf", "edit", "form.pdf", "--ops", "fill-cover-redact.json", "--out", "covered.pdf", "--verify"],
      "expect": {
        "json": [
          { "path": "verification.checkedOps", "contains": "op-0001" },
          { "path": "verification.checkedOps", "contains": "op-0004" }
        ]
      }
    },
    {
      "args": ["pdf", "edit", "form.pdf", "--ops", "skill-example.json", "--out", "form.final.pdf", "--verify"],
      "env": { "PASSWORD": "Scenario-Open-7d2a", "OWNERPASSWORD": "Scenario-Owner-3b9e" },
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.checkedOps", "contains": "op-0001" }
        ],
        "hidden": ["Scenario-Open-7d2a", "Scenario-Owner-3b9e"]
      }
    },
    {
      "args": ["pdf", "inspect", "form.final.pdf", "--password-env", "PASSWORD", "--detail", "forms"],
      "env": { "PASSWORD": "Scenario-Open-7d2a" },
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "forms.fields[0].name", "equals": "applicant" },
          { "path": "forms.fields[0].value", "equals": "Li Lei" },
          { "path": "forms.fields[2].name", "equals": "mobile" },
          { "path": "forms.fields[2].value", "equals": "" }
        ]
      }
    }
  ]
}
