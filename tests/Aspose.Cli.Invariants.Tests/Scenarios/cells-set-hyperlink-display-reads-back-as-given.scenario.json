{
  "name": "cells set_hyperlink writes its display as the cell's text, so a display that starts with an apostrophe or writes an error value (#N/A) passes --verify and reads back as given, both from the cell and from the link",
  "files": {
    "book.xlsx": { "fixture": "cells.xlsx" },
    "ops.json": { "text": "{\"ops\":[{\"op\":\"set_hyperlink\",\"sheet\":\"Sheet1\",\"cell\":\"K1\",\"url\":\"https://example.com/a\",\"display\":\"'abc\"},{\"op\":\"set_hyperlink\",\"sheet\":\"Sheet1\",\"cell\":\"K2\",\"url\":\"https://example.com/b\",\"display\":\"#N/A\"},{\"op\":\"set_hyperlink\",\"sheet\":\"Sheet1\",\"cell\":\"K3\",\"url\":\"https://example.com/c\",\"display\":\"plain\"}]}" }
  },
  "steps": [
    {
      "args": ["cells", "edit", "book.xlsx", "--in-place", "--verify", "--ops", "ops.json"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true }
        ]
      }
    },
    {
      "args": ["cells", "read", "book.xlsx", "--sheet", "Sheet1", "--range", "K1:K3"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "sheet.cells[0][0]", "equals": { "v": "'abc", "t": "string" } },
          { "path": "sheet.cells[1][0]", "equals": { "v": "#N/A", "t": "string" } },
          { "path": "sheet.cells[2][0]", "equals": { "v": "plain", "t": "string" } }
        ]
      }
    },
    {
      "args": ["cells", "inspect", "book.xlsx", "--detail", "hyperlinks"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "workbook.hyperlinks[range=K1][0].display", "equals": "'abc" },
          { "path": "workbook.hyperlinks[range=K2][0].display", "equals": "#N/A" },
          { "path": "workbook.hyperlinks[range=K3][0].display", "equals": "plain" }
        ]
      }
    }
  ]
}
