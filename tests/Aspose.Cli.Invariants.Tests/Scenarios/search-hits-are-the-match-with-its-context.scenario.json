{
  "name": "every product's search hit is the match itself: in Cells, Slides and Words with the address of the object, the row and the offset in that row's text where it was found, in PDF with the page's text address, the row and the rectangle the engine found it in",
  "files": { "book.xlsx": { "fixture": "cells.xlsx" }, "doc.pdf": { "fixture": "pdf.pdf" }, "deck.pptx": { "fixture": "slides.pptx" }, "doc.docx": { "fixture": "words.docx" } },
  "steps": [
    {
      "args": ["cells", "search", "book.xlsx", "--pattern", "invariant"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "hits[0].text", "equals": "invariant" },
          { "path": "hits[0].at", "equals": "sheet/Sheet1/cell/A2" },
          { "path": "hits[0].row", "equals": "stringValue" },
          { "path": "hits[0].offset", "equals": 6 },
          { "path": "hits[0].length", "equals": 9 }
        ]
      }
    },
    { "args": ["pdf", "search", "doc.pdf", "--pattern", "invariant"], "expect": { "exitCode": 0, "json": [{ "path": "hits[0].text", "equals": "invariant" }, { "path": "hits[0].at", "equals": "page/1/text" }, { "path": "hits[0].row", "equals": "text" }, { "path": "hits[0].rect", "exists": true }] } },
    {
      "args": ["slides", "search", "deck.pptx", "--pattern", "hello"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "hits[0].text", "equals": "Hello" },
          { "path": "hits[0].at", "equals": "slide/257/shape/2" },
          { "path": "hits[0].row", "equals": "text" },
          { "path": "hits[0].offset", "equals": 0 },
          { "path": "hits[0].length", "equals": 5 }
        ]
      }
    },
    {
      "args": ["words", "search", "doc.docx", "--pattern", "invariant"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "hits[0].text", "equals": "invariant" },
          { "path": "hits[0].at", "startsWith": "section/0/body/paragraph/" },
          { "path": "hits[0].row", "equals": "text" },
          { "path": "hits[0].offset", "equals": 6 },
          { "path": "hits[0].length", "equals": 9 }
        ]
      }
    }
  ]
}
