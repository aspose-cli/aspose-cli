{
  "name": "cells refuses a list named .txt or .md as Markdown it does not read, reads an xlsx named .csv as the xlsx it is, and refuses a damaged xlsx as corrupt",
  "files": {
    "list.txt": { "text": "- one\n- two\n" },
    "list.md": { "text": "- one\n- two\n" },
    "renamed.csv": { "fixture": "cells.xlsx" },
    "broken.xlsx": { "base64": "UEsDBGdhcmJhZ2U=" }
  },
  "steps": [
    {
      "args": ["cells", "read", "list.txt"],
      "expect": { "exitCode": 3, "error": "FILE_CORRUPT" }
    },
    {
      "args": ["cells", "read", "list.md"],
      "expect": { "exitCode": 3, "error": "FILE_CORRUPT" }
    },
    {
      "args": ["cells", "read", "renamed.csv"],
      "expect": { "exitCode": 0, "json": [{ "path": "input.format", "equals": "xlsx" }] }
    },
    {
      "args": ["cells", "read", "broken.xlsx"],
      "expect": { "exitCode": 3, "error": "FILE_CORRUPT" }
    }
  ]
}
