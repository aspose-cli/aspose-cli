{
  "name": "pdf edit move_pages copies the pages it passes rather than those it moves where that keeps the form: a field with a parent in its name stays one field, filled and covered as the page shows it; a move that must copy one is refused naming it, and in --best-effort the field stays where it was; a field split between pages moves when the pages the hint names move together; pages that are not one run move as before",
  "files": {
    "hier.pdf": {
      "base64": ""
    },
    "hier2.pdf": {
      "base64": ""
    },
    "two.pdf": {
      "base64": ""
    },
    "formx.pdf": {
      "base64": ""
    },
    "nav4.pdf": {
      "base64": ""
    },
    "nav4f.pdf": {
      "base64": ""
    },
    "form.html": {
      "text": "<html><head><meta charset=\"utf-8\"><title>Registration</title></head><body><h1>Registration Form</h1><p>Name: <input type=\"text\" name=\"applicant\" value=\"\"></p><p>ID No.: <input type=\"text\" name=\"idno\" value=\"\"></p><p>Mobile: <input type=\"text\" name=\"mobile\" value=\"13812345678\"></p></body></html>"
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "edit",
        "hier.pdf",
        "--ops",
        "[{\"op\":\"move_pages\",\"pages\":\"1\",\"to\":2}]",
        "--out",
        "hier-moved.pdf"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "hier-moved.pdf",
        "--detail",
        "forms"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "forms.fieldCount",
            "equals": 2
          },
          {
            "path": "forms.fields[0].name",
            "equals": "form.person.name"
          },
          {
            "path": "forms.fields[0].value",
            "equals": "Alice"
          },
          {
            "path": "forms.fields[0].page",
            "equals": 2
          },
          {
            "path": "forms.fields[1].name",
            "equals": "other"
          },
          {
            "path": "forms.fields[1].page",
            "equals": 1
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "hier.pdf",
        "--ops",
        "[{\"op\":\"move_pages\",\"pages\":\"1\",\"to\":2},{\"op\":\"set_form_field\",\"name\":\"form.person.name\",\"value\":\"Bob\"}]",
        "--out",
        "hier-set.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "verification.ok",
            "equals": true
          },
          {
            "path": "verification.checkedOps",
            "contains": "op-0002"
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "hier-set.pdf",
        "--detail",
        "forms"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "forms.fields[0].name",
            "equals": "form.person.name"
          },
          {
            "path": "forms.fields[0].value",
            "equals": "Bob"
          },
          {
            "path": "forms.fields[0].page",
            "equals": 2
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "hier.pdf",
        "--ops",
        "[{\"op\":\"move_pages\",\"pages\":\"1\",\"to\":2},{\"op\":\"redact_area\",\"page\":2,\"rect\":{\"x\":60,\"y\":160,\"width\":230,\"height\":45}}]",
        "--out",
        "hier-covered.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "verification.ok",
            "equals": true
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "search",
        "hier-covered.pdf",
        "--pattern",
        "Alice"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "hits",
            "equals": []
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "hier2.pdf",
        "--ops",
        "[{\"op\":\"move_pages\",\"pages\":\"1\",\"to\":2}]",
        "--out",
        "hier2-moved.pdf"
      ],
      "expect": {
        "exitCode": 4,
        "error": "OPS_INVALID",
        "json": [
          {
            "path": "error.message",
            "contains": "form field 'form.a' on page 1 has a parent in its name, and this move copies that page"
          },
          {
            "path": "error.hint",
            "equals": "Move the pages without form fields around page 1 instead, which can give the same order without copying the field; if no such move does, tell the user."
          }
        ],
        "files": {
          "absent": [
            "hier2-moved.pdf"
          ],
          "nothingWritten": true
        }
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "formx.pdf",
