{
  "name": "a convert of selected pages counts every link on them that leads to a page it leaves out, as a page deletion does, and a split counts a link to a page its part does not hold whether another part or none holds it: four pages with bookmarks on pages 1, 3 and 4 and links from page 1 to 4, from 3 to 1 and from 4 to 2",
  "files": {
    "nav.pdf": {
      "base64": ""
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "convert",
        "nav.pdf",
        "--to",
        "docx",
        "--pages",
        "2-4",
        "--out",
        "last.docx"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "1 bookmark(s), 1 link(s) and 0 named destination(s) lead to pages that --pages did not select."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "nav.pdf",
        "--to",
        "docx",
        "--pages",
        "2-3",
        "--out",
        "middle.docx"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "2 bookmark(s), 1 link(s) and 0 named destination(s) lead to pages that --pages did not select."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "nav.pdf",
        "--ops",
        "[{\"op\":\"delete_pages\",\"pages\":\"1\"}]",
        "--out",
        "deleted.pdf"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "1 bookmark(s), 1 link(s) and 0 named destination(s) lead to pages the edit deleted."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "split",
        "nav.pdf",
        "--by",
        "pages",
        "--groups",
        "1-2,3",
        "--out-dir",
        "one"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "0 bookmark(s), 1 link(s) and 0 named destination(s) lead to a page their part does not hold, so they lead nowhere in it."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1].message",
            "equals": "1 bookmark(s) of the parts open their page as a whole, not at the place in it they opened in the input."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][2]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "split",
        "nav.pdf",
        "--by",
        "pages",
        "--groups",
        "1-2",
        "--groups",
        "3-4",
        "--out-dir",
        "two"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "0 bookmark(s), 3 link(s) and 0 named destination(s) lead to a page their part does not hold, so they lead nowhere in it."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1].message",
            "equals": "2 bookmark(s) of the parts open their page as a whole, not at the place in it they opened in the input."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][2]",
            "exists": false
          }
        ]
      }
    }
  ]
}
