{
  "name": "slides create --from-markdown writes the paragraph under a deck's title into the title slide's subtitle, as the outline guide says, when the template's Title Slide layout also has a body placeholder beside its subtitle, such as a presenter or date box",
  "files": {
    "template.pptx": { "copy": "Assets/slides-title-slide-with-a-body-placeholder.pptx" },
    "deck.md": { "text": "# One\n\nsub\n" }
  },
  "steps": [
    {
      "args": ["slides", "create", "deck.pptx", "--from-markdown", "deck.md", "--template", "template.pptx"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["slides", "read", "deck.pptx", "--slides", "1"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "slides[0].layout", "equals": "Title Slide" },
          { "path": "slides[0].shapes[0].placeholder", "equals": "title" },
          { "path": "slides[0].shapes[1].placeholder", "equals": "subtitle" },
          { "path": "slides[0].shapes[1].text", "equals": "sub" }
        ]
      }
    }
  ]
}
