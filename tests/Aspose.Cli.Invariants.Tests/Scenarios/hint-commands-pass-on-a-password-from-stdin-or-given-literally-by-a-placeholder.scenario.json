{
  "name": "the commands a hint names on an input opened with a password from stdin or given literally pass it on by a variable placeholder, and run with the variable filled in",
  "files": {
    "deck.pptx": { "fixture": "slides.pptx" },
    "locked.pptx": { "fixture": "slides.encrypted" }
  },
  "steps": [
    {
      "args": ["slides", "convert", "locked.pptx", "--password-stdin", "--to", "tiff", "--out", "x.tiff"],
      "stdin": "Invariant-Secret-5f1c9e7a\n",
      "expect": {
        "error": "FEATURE_UNSUPPORTED",
        "json": [
          { "path": "error.hint", "contains": "locked.pptx\" --password-env \"<password-env>\" --to tiff --out " },
          { "path": "error.hint", "contains": "locked.pptx\" --password-env \"<password-env>\" --to pdf --out " },
          { "path": "error.hint", "notContains": "--password-stdin" }
        ],
        "files": { "nothingWritten": true },
        "hidden": ["Invariant-Secret-5f1c9e7a"]
      }
    },
    {
      "args": ["slides", "convert", "locked.pptx", "--password", "Invariant-Secret-5f1c9e7a", "--to", "tiff", "--out", "x.tiff"],
      "expect": {
        "error": "FEATURE_UNSUPPORTED",
        "json": [
          { "path": "error.hint", "contains": "locked.pptx\" --password-env \"<password-env>\" --to tiff --out " },
          { "path": "error.hint", "contains": "locked.pptx\" --password-env \"<password-env>\" --to pdf --out " }
        ],
        "files": { "nothingWritten": true },
        "hidden": ["Invariant-Secret-5f1c9e7a"]
      }
    },
    {
      "args": ["slides", "convert", "locked.pptx", "--password-env", "DECK_PASSWORD", "--to", "tiff", "--out", "x.tiff"],
      "env": { "DECK_PASSWORD": "Invariant-Secret-5f1c9e7a" },
      "expect": {
        "error": "FEATURE_UNSUPPORTED",
        "json": [
          { "path": "error.hint", "contains": "locked.pptx\" --password-env DECK_PASSWORD --to tiff --out " },
          { "path": "error.hint", "notContains": "<password-env>" }
        ]
      }
    },
    {
      "args": ["slides", "convert", "deck.pptx", "--to", "tiff", "--out", "y.tiff"],
      "expect": {
        "error": "FEATURE_UNSUPPORTED",
        "json": [{ "path": "error.hint", "notContains": "--password" }]
      }
    },
    {
      "args": ["slides", "render", "locked.pptx", "--password-env", "<password-env>", "--to", "tiff", "--out", "x.tiff"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          { "path": "error.details.option", "equals": "--password-env" },
          { "path": "error.hint", "contains": "--password-stdin" }
        ],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["slides", "render", "locked.pptx", "--password-env", "DECK_PASSWORD", "--to", "tiff", "--out", "x.tiff"],
      "env": { "DECK_PASSWORD": "Invariant-Secret-5f1c9e7a" },
      "expect": { "exitCode": 0, "files": { "present": ["x.1.tiff", "x.2.tiff"] } }
    },
    {
      "args": ["slides", "convert", "locked.pptx", "--password-env", "DECK_PASSWORD", "--to", "pdf", "--out", "x.pdf"],
      "env": { "DECK_PASSWORD": "Invariant-Secret-5f1c9e7a" },
      "expect": { "exitCode": 0, "files": { "present": ["x.pdf"] } }
    },
    {
      "args": ["pdf", "convert", "x.pdf", "--to", "tiff", "--out", "x.tiff"],
      "expect": { "exitCode": 0, "files": { "present": ["x.tiff"] }, "reopens": ["@result"] }
    }
  ]
}
