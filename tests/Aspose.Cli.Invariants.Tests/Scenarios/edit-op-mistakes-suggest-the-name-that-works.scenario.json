{
  "name": "an edit operation mistake in each product suggests the name that works first, before the document is read",
  "files": {
    "a.docx": {
      "text": "not a document"
    },
    "a.pptx": {
      "text": "not a document"
    },
    "a.xlsx": {
      "text": "not a document"
    },
    "a.pdf": {
      "text": "not a document"
    }
  },
  "steps": [
    {
      "args": [
        "words",
        "edit",
        "a.docx",
        "--ops",
        "{\"ops\":[{\"op\":\"replace_text\",\"find\":\"30\",\"replacement\":\"15\"}]}"
      ],
      "expect": {
        "error": "OPS_INVALID",
        "json": [
          {
            "path": "error.details.suggestions[0]",
            "equals": "replace"
          },
          {
            "path": "error.hint",
            "startsWith": "Did you mean 'replace'"
          }
        ],
        "files": {
          "nothingWritten": true
        }
      }
    },
    {
      "args": [
        "slides",
        "edit",
        "a.pptx",
        "--ops",
