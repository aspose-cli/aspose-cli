{
  "name": "a page operation's hint names a bookmark that lost its page but holds others, whose children have a page or not, instead of deleting it with them: after a page deletion it may be kept, and after a move that strands it the hint says why the batch cannot put it back",
  "files": {
    "held.pdf": {
      "base64": ""
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "edit",
        "held.pdf",
        "--ops",
        "[{\"op\":\"move_pages\",\"pages\":\"3\",\"to\":1}]",
        "--out",
        "moved.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 8,
        "json": [
          {
            "path": "verification.ok",
            "equals": false
          },
          {
            "path": "verification.issues[0].code",
            "equals": "NAVIGATION_DEGRADED"
          },
          {
            "path": "verification.issues[0].hint",
            "contains": "Bookmark(s) 1 of the output lost their page but hold other bookmarks, which deleting them deletes too, and add_bookmark adds only a bookmark that opens a page, so what they hold cannot always be added back: tell the user which no longer open their page."
          },
          {
            "path": "verification.issues[0].hint",
            "notContains": "delete_bookmarks"
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "held.pdf",
        "--ops",
        "[{\"op\":\"delete_pages\",\"pages\":\"2\"}]",
        "--out",
        "deleted.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "verification.ok",
            "equals": true
          },
          {
            "path": "warnings",
            "contains": {
              "code": "NAVIGATION_DEGRADED",
              "message": "1 bookmark(s), 0 link(s) and 0 named destination(s) lead to pages the edit deleted.",
              "hint": "The pages they led to were deleted as the batch asked. Bookmark(s) 2 of the output lost their page but hold other bookmarks, which deleting them deletes too, so keep them or tell the user."
            }
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "deleted.pdf",
        "--detail",
        "outline"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "outline[3]",
            "equals": {
              "title": "B1",
              "level": 2,
              "bookmark": "2/1"
            }
          }
        ]
      }
    }
  ]
}
