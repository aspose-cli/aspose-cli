{
  "name": "slides convert refuses a TIFF of several slides, which the engine writes with the first slide alone, and renders or converts one TIFF of one slide",
  "files": {
    "deck.pptx": { "fixture": "slides.pptx" },
    "with space/my deck.pptx": { "fixture": "slides.pptx" },
    "locked.pptx": { "fixture": "slides.encrypted" }
  },
  "steps": [
    {
      "args": ["slides", "convert", "deck.pptx", "--to", "tiff"],
      "expect": {
        "error": "FEATURE_UNSUPPORTED",
        "json": [
          { "path": "error.details.reason", "equals": "engine-defect" },
          { "path": "error.hint", "contains": "slides render" },
          { "path": "error.hint", "contains": "pdf convert" }
        ],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["slides", "convert", "with space/my deck.pptx", "--to", "tiff", "--slides", "1-2"],
      "expect": {
        "error": "FEATURE_UNSUPPORTED",
        "json": [
          { "path": "error.hint", "contains": "--slides 1-2" }
        ],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["slides", "convert", "locked.pptx", "--password-env", "SLIDES_TIFF_PASSWORD", "--to", "tiff"],
      "env": { "SLIDES_TIFF_PASSWORD": "Invariant-Secret-5f1c9e7a" },
      "expect": {
        "error": "FEATURE_UNSUPPORTED",
        "json": [
          { "path": "error.hint", "contains": "--password-env SLIDES_TIFF_PASSWORD" }
        ],
        "files": { "nothingWritten": true },
        "hidden": ["Invariant-Secret-5f1c9e7a"]
      }
    },
    {
      "args": ["slides", "convert", "deck.pptx", "--to", "tiff", "--slides", "2", "--out", "second.tiff"],
      "expect": {
        "exitCode": 0,
        "files": { "present": ["second.tiff"] },
        "reopens": ["@result"]
      }
    },
    {
      "args": ["slides", "edit", "deck.pptx", "--ops", "{\"ops\":[{\"op\":\"set_slide_hidden\",\"slides\":\"2\",\"hidden\":true}]}", "--out", "hidden.pptx"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["slides", "convert", "hidden.pptx", "--to", "tiff"],
      "expect": {
        "exitCode": 0,
        "warnings": { "present": ["HIDDEN_SLIDES_SKIPPED"] },
        "files": { "present": ["hidden.tiff"] },
        "reopens": ["@result"]
      }
    },
    {
      "args": ["slides", "convert", "deck.pptx", "--to", "gif"],
      "expect": {
        "exitCode": 0,
        "files": { "present": ["deck.gif"] },
        "reopens": ["@result"]
      }
    },
    {
      "args": ["slides", "render", "deck.pptx", "--to", "tiff"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "outputs[0].slide", "equals": 1 },
          { "path": "outputs[1].slide", "equals": 2 },
          { "path": "outputs[0].format", "equals": "tiff" }
        ],
        "files": { "present": ["deck.1.tiff", "deck.2.tiff"] },
        "reopens": ["@result"]
      }
    }
  ]
}
