{
  "name": "a bookmark that opens its page through a named destination has that page in pdf inspect --detail outline, keeps it in a merge, after the pages of the inputs before it, and in the part that holds it, which split --by bookmarks also starts there, and no warning tells the agent to add it again",
  "files": {
    "one.pdf": { "fixture": "pdf.pdf" },
    "nav.pdf": { "base64": "" }
  },
  "steps": [
    {
      "args": ["pdf", "inspect", "nav.pdf", "--detail", "outline"],
      "expect": {
        "exitCode": 0,
        "json": [{ "path": "outline[1]", "equals": { "title": "Named", "level": 1, "bookmark": "2", "page": 3 } }]
      }
    },
    {
      "args": ["pdf", "merge", "one.pdf", "nav.pdf", "--out", "merged.pdf"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "warnings", "contains": { "code": "NAVIGATION_DEGRADED", "message": "0 bookmark(s), 1 link(s) and 1 named destination(s) no longer lead to their page, although the merged document holds it: it carries no named destinations, so what led there through one leads nowhere.", "hint": "No operation re-creates links or named destinations: tell the user which no longer lead to their page.", "affectsCompleteness": true } }
        ]
      }
    },
    {
      "args": ["pdf", "inspect", "merged.pdf", "--detail", "outline"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "pdf.pageCount", "equals": 4 },
          { "path": "outline", "equals": [{ "title": "Two", "level": 1, "bookmark": "1", "page": 3 }, { "title": "Named", "level": 1, "bookmark": "2", "page": 4 }] }
        ]
      }
    },
    {
      "args": ["pdf", "split", "nav.pdf", "--by", "pages", "--out-dir", "parts"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["pdf", "inspect", "parts/nav.3.pdf", "--detail", "outline"],
      "expect": {
        "exitCode": 0,
        "json": [{ "path": "outline", "equals": [{ "title": "Named", "level": 1, "bookmark": "1", "page": 1 }] }]
      }
    },
    {
      "args": ["pdf", "inspect", "parts/nav.1.pdf", "--detail", "outline"],
      "expect": { "exitCode": 0, "json": [{ "path": "outline", "equals": [] }] }
    },
    {
      "args": ["pdf", "split", "nav.pdf", "--by", "bookmarks", "--out-dir", "chapters"],
      "expect": {
        "exitCode": 0,
        "json": [{ "path": "outputs[2].pages", "equals": "3" }]
      }
    }
  ]
}
