{
  "name": "cells edit of a formula the engine cannot parse is ENGINE_ERROR at the operation and row that set it, with the engine's message, and writes nothing",
  "steps": [
    { "args": ["cells", "create", "book.xlsx"], "expect": { "exitCode": 0 } },
    {
      "args": ["cells", "edit", "book.xlsx", "--in-place", "--ops", "{\"ops\":[{\"set\":\"sheet/Sheet1/cell/A2\",\"props\":{\"value\":1}},{\"set\":\"sheet/Sheet1/cell/A1\",\"props\":{\"formula\":\"=SUM(B1;B2)\"}}]}"],
      "expect": {
        "error": "ENGINE_ERROR",
        "json": [
          { "path": "error.details.index", "equals": 1 },
          { "path": "error.details.at", "equals": "sheet/Sheet1/cell/A1" },
          { "path": "error.message", "contains": "Aspose.Cells.CellsException" }
        ],
        "files": { "unchanged": ["book.xlsx"], "absent": [".aspose-publication-*"], "nothingWritten": true }
      }
    }
  ]
}
