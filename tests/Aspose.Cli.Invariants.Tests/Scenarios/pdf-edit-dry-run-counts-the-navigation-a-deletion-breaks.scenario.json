{
  "name": "a dry run counts the navigation a page deletion breaks as the edit itself reads it from its output: a link read before the deletion leads to the page it led to then, not to the page that took its number: four pages with bookmarks on pages 1, 3 and 4 and links from page 1 to 4, from 3 to 1 and from 4 to 2",
  "files": {
    "nav.pdf": {
      "base64": ""
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "edit",
        "nav.pdf",
        "--ops",
        "[{\"op\":\"delete_pages\",\"pages\":\"1\"}]",
        "--out",
        "deleted-1.pdf",
        "--dry-run"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "1 bookmark(s), 1 link(s) and 0 named destination(s) lead to pages the edit deleted."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].affectsCompleteness",
            "exists": false
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "nav.pdf",
        "--ops",
        "[{\"op\":\"delete_pages\",\"pages\":\"1\"}]",
        "--out",
        "deleted-1.pdf"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "1 bookmark(s), 1 link(s) and 0 named destination(s) lead to pages the edit deleted."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].affectsCompleteness",
            "exists": false
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "nav.pdf",
        "--ops",
        "[{\"op\":\"delete_pages\",\"pages\":\"2\"}]",
        "--out",
        "deleted-2.pdf",
        "--dry-run"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "0 bookmark(s), 1 link(s) and 0 named destination(s) lead to pages the edit deleted."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].affectsCompleteness",
            "exists": false
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "nav.pdf",
        "--ops",
        "[{\"op\":\"delete_pages\",\"pages\":\"2\"}]",
        "--out",
        "deleted-2.pdf"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "0 bookmark(s), 1 link(s) and 0 named destination(s) lead to pages the edit deleted."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].affectsCompleteness",
            "exists": false
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1]",
            "exists": false
          }
        ]
      }
    }
  ]
}
