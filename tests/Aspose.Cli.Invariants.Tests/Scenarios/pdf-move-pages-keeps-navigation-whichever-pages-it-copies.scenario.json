{
  "name": "pdf edit move_pages leaves the page order, the pages of the bookmarks and the target pages of the links the same whichever pages it copies: those it moves or, beside a form field, those it passes",
  "files": {
    "nav4.pdf": {
      "base64": ""
    },
    "nav4f.pdf": {
      "base64": ""
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "edit",
        "nav4.pdf",
        "--ops",
        "[{\"op\":\"move_pages\",\"pages\":\"3\",\"to\":2}]",
        "--out",
        "nav4-3-2.pdf"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "read",
        "nav4-3-2.pdf"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "pages[0].text",
            "contains": "Page 1"
          },
          {
            "path": "pages[1].text",
            "contains": "Page 3"
          },
          {
            "path": "pages[2].text",
            "contains": "Page 2"
          },
          {
            "path": "pages[3].text",
            "contains": "Page 4"
          },
          {
            "path": "pages[4]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "nav4-3-2.pdf",
        "--detail",
        "outline",
        "--detail",
        "links"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "outline[0].page",
            "equals": 1
          },
          {
            "path": "outline[1].page",
            "equals": 2
          },
          {
            "path": "outline[2].page",
            "equals": 4
          },
          {
            "path": "documentLinks[0].targetPage",
            "equals": 4
          },
          {
            "path": "documentLinks[1].targetPage",
            "equals": 1
          },
          {
            "path": "documentLinks[2].targetPage",
            "equals": 3
          }
        ]
      }
    },
