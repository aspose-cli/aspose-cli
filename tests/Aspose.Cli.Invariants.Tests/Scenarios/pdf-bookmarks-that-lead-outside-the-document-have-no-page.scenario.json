{
  "name": "a bookmark that opens a web address or a page of another file has no page of the document: pdf inspect --detail outline reports none, merge and split keep it without pointing it at a local page, split --by bookmarks does not start a part there, and move_pages moves the page its remote destination names",
  "files": {
    "one.pdf": {
      "fixture": "pdf.pdf"
    },
    "links.pdf": {
      "base64": ""
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "inspect",
        "links.pdf",
        "--detail",
        "outline"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "outline",
            "equals": [
              {
                "title": "Page",
                "level": 1,
                "bookmark": "1",
                "page": 3
              },
              {
                "title": "Named",
                "level": 1,
                "bookmark": "2",
                "page": 3
              },
              {
                "title": "Web",
                "level": 1,
                "bookmark": "3"
              },
              {
                "title": "Remote",
                "level": 1,
                "bookmark": "4"
              }
            ]
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "merge",
        "one.pdf",
        "links.pdf",
        "--out",
        "merged.pdf"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "merged.pdf",
        "--detail",
        "outline"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "outline",
            "equals": [
              {
                "title": "Page",
                "level": 1,
                "bookmark": "1",
                "page": 4
              },
              {
                "title": "Named",
                "level": 1,
                "bookmark": "2",
                "page": 4
              },
              {
                "title": "Web",
                "level": 1,
                "bookmark": "3"
              },
              {
                "title": "Remote",
                "level": 1,
                "bookmark": "4"
              }
            ]
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "split",
        "links.pdf",
        "--by",
        "pages",
        "--out-dir",
        "parts"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "parts/links.3.pdf",
        "--detail",
        "outline"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "outline",
            "equals": [
              {
                "title": "Page",
                "level": 1,
                "bookmark": "1",
                "page": 1
              },
              {
                "title": "Named",
                "level": 1,
                "bookmark": "2",
                "page": 1
              },
              {
                "title": "Web",
                "level": 1,
                "bookmark": "3"
              },
              {
                "title": "Remote",
                "level": 1,
                "bookmark": "4"
              }
            ]
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "split",
        "links.pdf",
        "--by",
        "bookmarks",
        "--out-dir",
        "chapters"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "outputs[0].pages",
            "equals": "1-2"
          },
          {
            "path": "outputs[1].pages",
            "equals": "3"
          },
          {
            "path": "outputs[2]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "links.pdf",
        "--ops",
        "[{\"op\":\"move_pages\",\"pages\":\"2\",\"to\":1}]",
        "--out",
        "moved.pdf"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "moved.pdf",
        "--detail",
        "outline"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "outline",
            "equals": [
              {
                "title": "Page",
                "level": 1,
                "bookmark": "1",
                "page": 3
              },
              {
                "title": "Named",
                "level": 1,
                "bookmark": "2",
                "page": 3
              },
              {
                "title": "Web",
                "level": 1,
                "bookmark": "3"
              },
              {
                "title": "Remote",
                "level": 1,
                "bookmark": "4"
              }
            ]
          }
        ]
      }
    }
  ]
}
