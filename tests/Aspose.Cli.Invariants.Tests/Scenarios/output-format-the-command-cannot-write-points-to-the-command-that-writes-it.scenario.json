            "exists": false
          },
          {
            "path": "error.hint",
            "contains": "then run 'aspose-cli slides convert <that file> --to pdf' for pdf"
          }
        ],
        "files": {
          "absent": [
            "x.pdf"
          ]
        }
      }
    },
    {
