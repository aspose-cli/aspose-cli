{
  "name": "an output format the command cannot write points to the command that writes it",
  "files": {
    "a.xlsx": {
      "text": "not a document"
    },
    "a.pptx": {
      "text": "not a document"
    },
    "a.pdf": {
      "text": "not a document"
    },
    "a.docx": {
      "text": "not a document"
    },
    "ops.json": {
      "text": "{\"ops\":[{\"op\":\"set_notes\",\"slide\":1,\"text\":\"x\"}]}"
    },
    "deck.md": {
      "text": "# Title"
    }
  },
  "steps": [
    {
      "args": [
        "cells",
        "edit",
        "a.xlsx",
        "--set",
        "Sheet1!A1=5",
        "--out",
        "x.pdf"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          {
            "path": "error.details.option",
            "equals": "--out"
          },
          {
            "path": "error.message",
            "startsWith": "--out '"
          },
          {
            "path": "error.message",
            "contains": "which aspose-cli cells edit does not write. Must be one of: .xlsx,"
          },
          {
            "path": "error.details.format",
            "exists": true
          }
        ],
        "files": {
          "absent": [
            "x.pdf"
          ]
        }
      }
    },
    {
      "args": [
        "slides",
        "edit",
        "a.pptx",
        "--ops",
        "ops.json",
        "--out",
        "x.pdf"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          {
            "path": "error.details.option",
            "equals": "--out"
          },
          {
            "path": "error.message",
            "startsWith": "--out '"
          },
          {
            "path": "error.message",
            "contains": "which aspose-cli slides edit does not write. Must be one of: .pptx,"
          },
          {
            "path": "error.details.format",
            "exists": true
          }
        ],
        "files": {
          "absent": [
            "x.pdf"
          ]
        }
      }
    },
    {
      "args": [
        "slides",
        "create",
        "x.ppt",
        "--from-markdown",
        "deck.md"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
