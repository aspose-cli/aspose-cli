{
  "name": "an output format the command cannot write points to the command that writes it",
  "files": {
    "book.xlsx": {
      "fixture": "cells.xlsx"
    },
    "a.xlsx": {
      "text": "not a document"
    },
    "a.pptx": {
      "text": "not a document"
    },
    "a.pdf": {
      "fixture": "pdf.pdf"
    },
    "a.docx": {
      "text": "not a document"
    },
    "ops.json": {
      "text": "{\"ops\":[{\"set\":\"document\",\"props\":{\"info.title\":\"x\"}}]}"
    },
    "deck.md": {
      "text": "# Title"
    },
    "deck.pptx": {
      "fixture": "slides.pptx"
    },
    "slides-ops.json": {
      "fixture": "slides.ops"
    },
    "doc.docx": {
      "fixture": "words.docx"
    }
  },
  "steps": [
    {
      "args": [
        "cells",
        "edit",
        "book.xlsx",
        "--ops",
        "{\"ops\":[{\"do\":\"calculate\"}]}",
        "--out",
        "x.pdf"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          {
            "path": "error.details.option",
            "equals": "--out"
          },
          {
            "path": "error.details.format",
            "equals": "xlsx"
          },
          {
            "path": "error.details.available",
            "equals": [
              ".xlsx"
            ]
          },
          {
            "path": "error.message",
            "contains": "Must be one of: .xlsx."
          }
        ],
        "files": {
          "absent": [
            "x.pdf"
          ]
        }
      }
    },
    {
      "args": [
        "slides",
        "edit",
        "deck.pptx",
        "--ops",
        "slides-ops.json",
        "--out",
        "x.pdf"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          {
            "path": "error.details.option",
            "equals": "--out"
          },
          {
            "path": "error.details.format",
            "equals": "pptx"
          },
          {
            "path": "error.details.available",
            "equals": [
              ".pptx"
            ]
          },
          {
            "path": "error.message",
            "contains": "Must be one of: .pptx."
          }
        ],
        "files": {
          "absent": [
            "x.pdf"
          ]
        }
      }
    },
    {
      "args": [
        "slides",
        "create",
        "x.ppt"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          {
            "path": "error.details.argument",
            "equals": "file"
          },
          {
            "path": "error.message",
            "startsWith": "The file '"
          },
          {
            "path": "error.message",
            "contains": "which aspose-cli slides create does not write. Must be one of: .pptx,"
          },
          {
            "path": "error.details.format",
            "exists": true
          }
        ],
        "files": {
          "absent": [
            "x.ppt"
          ]
        }
      }
    },
    {
      "args": [
        "cells",
