{
  "name": "words compare --ignore-formatting drops a formatting-only change and keeps a text change",
  "files": {
    "plain.md": { "text": "The notice period is thirty days.\n" },
    "bold.md": { "text": "The notice period is **thirty** days.\n" },
    "changed.md": { "text": "The notice period is **sixty** days.\n" }
  },
  "steps": [
    { "args": ["words", "convert", "plain.md", "--to", "docx", "--encoding", "utf-8", "--out", "plain.docx"], "expect": { "exitCode": 0 } },
    { "args": ["words", "convert", "bold.md", "--to", "docx", "--encoding", "utf-8", "--out", "bold.docx"], "expect": { "exitCode": 0 } },
    { "args": ["words", "convert", "changed.md", "--to", "docx", "--encoding", "utf-8", "--out", "changed.docx"], "expect": { "exitCode": 0 } },
    {
      "args": ["words", "compare", "plain.docx", "bold.docx", "--author", "Reviewer", "--date-time", "2026-03-01T09:00:00", "--out", "formatting.docx"],
      "expect": { "exitCode": 0, "json": [{ "path": "revisionCount", "equals": 1 }], "files": { "present": ["formatting.docx"] } }
    },
    {
      "args": ["words", "compare", "plain.docx", "bold.docx", "--ignore-formatting", "--author", "Reviewer", "--date-time", "2026-03-01T09:00:00", "--out", "ignored.docx"],
      "expect": { "exitCode": 0, "json": [{ "path": "revisionCount", "equals": 0 }] }
    },
    {
      "args": ["words", "compare", "plain.docx", "changed.docx", "--ignore-formatting", "--author", "Reviewer", "--date-time", "2026-03-01T09:00:00", "--out", "text.docx"],
      "expect": { "exitCode": 0, "json": [{ "path": "revisionCount", "equals": 2 }] }
    }
  ]
}
