{
  "name": "words edit --in-place --encrypt-env of a Flat OPC .xml document is refused with OPTION_INVALID, never saved as an encrypted package under .xml",
  "files": {
    "flat.xml": { "fixture": "words.flatopc" },
    "ops.json": { "fixture": "words.ops" }
  },
  "steps": [
    {
      "args": ["words", "edit", "flat.xml", "--ops", "ops.json", "--in-place", "--encrypt-env", "NEW_PASSWORD"],
      "env": { "NEW_PASSWORD": "Scenario-New-Secret-7d2a" },
      "expect": { "exitCode": 2, "error": "OPTION_INVALID", "files": { "nothingWritten": true } }
    },
    {
      "args": ["words", "inspect", "flat.xml"],
      "expect": { "exitCode": 0, "json": [{ "path": "source.format", "equals": "flatopc" }] }
    }
  ]
}
