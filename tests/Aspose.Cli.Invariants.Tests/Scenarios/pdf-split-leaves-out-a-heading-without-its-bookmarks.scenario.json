{
  "name": "pdf split --by pages leaves a heading without a page out of the parts that hold none of the bookmarks below it, and keeps a bookmark that opens a web address in every part",
  "files": {
    "group.pdf": {
      "base64": ""
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "split",
        "group.pdf",
        "--by",
        "pages",
        "--out-dir",
        "parts"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "parts/group.1.pdf",
        "--detail",
        "outline"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "outline",
            "equals": [
              {
                "title": "Group",
                "level": 1,
                "bookmark": "1"
              },
              {
                "title": "G1",
                "level": 2,
                "bookmark": "1/1",
                "page": 1
              },
              {
                "title": "Web",
                "level": 1,
                "bookmark": "2"
              }
            ]
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "parts/group.2.pdf",
        "--detail",
        "outline"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "outline",
            "equals": [
              {
                "title": "Web",
                "level": 1,
                "bookmark": "1"
              }
            ]
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "parts/group.3.pdf",
        "--detail",
        "outline"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "outline",
            "equals": [
              {
                "title": "Group",
                "level": 1,
                "bookmark": "1"
              },
              {
                "title": "G3",
                "level": 2,
                "bookmark": "1/1",
                "page": 1
              },
              {
                "title": "Web",
                "level": 1,
                "bookmark": "2"
              }
            ]
          }
        ]
      }
    }
  ]
}
