{
  "name": "a Word document named .pdf is FORMAT_MISMATCH naming words and its command, supervised or not, through pdf inspect, review and pdf merge",
  "files": {
    "renamed.pdf": {
      "fixture": "words.docx"
    },
    "report.pdf": {
      "fixture": "pdf.pdf"
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "inspect",
        "renamed.pdf"
      ],
      "expect": {
        "exitCode": 6,
        "error": "FORMAT_MISMATCH",
        "json": [
          {
            "path": "error.details.declared",
            "equals": "pdf"
          },
          {
            "path": "error.details.detected",
            "equals": [
              "words"
            ]
          },
          {
            "path": "error.details.path",
            "equals": "<workspace>/renamed.pdf"
          },
          {
            "path": "error.message",
            "equals": "By its content, 'renamed.pdf' is a words document; it is not a pdf document."
          },
          {
            "path": "error.hint",
            "contains": "looks like a words document"
          },
          {
            "path": "error.hint",
            "contains": "'aspose-cli words inspect'"
          }
        ],
        "files": {
          "nothingWritten": true
        }
      }
    },
    {
      "args": [
        "--timeout",
        "100",
        "pdf",
        "inspect",
        "renamed.pdf"
      ],
      "expect": {
        "exitCode": 6,
        "error": "FORMAT_MISMATCH",
        "json": [
          {
            "path": "error.details.declared",
            "equals": "pdf"
          },
          {
            "path": "error.details.detected",
            "equals": [
              "words"
            ]
          },
          {
            "path": "error.details.path",
            "equals": "<workspace>/renamed.pdf"
          },
          {
            "path": "error.message",
            "equals": "By its content, 'renamed.pdf' is a words document; it is not a pdf document."
          },
          {
            "path": "error.hint",
            "contains": "looks like a words document"
          },
          {
            "path": "error.hint",
            "contains": "'aspose-cli words inspect'"
          }
        ],
        "files": {
          "nothingWritten": true
        }
      }
    },
    {
      "args": [
        "review",
        "renamed.pdf"
      ],
      "expect": {
        "exitCode": 6,
        "error": "FORMAT_MISMATCH",
        "json": [
          {
            "path": "error.details.declared",
            "equals": "pdf"
          },
          {
            "path": "error.details.detected",
            "equals": [
              "words"
            ]
          },
          {
            "path": "error.details.path",
            "equals": "<workspace>/renamed.pdf"
          },
          {
            "path": "error.message",
            "equals": "By its content, 'renamed.pdf' is a words document; it is not a pdf document."
          }
        ],
        "files": {
          "nothingWritten": true
        }
      }
    },
    {
      "args": [
        "pdf",
        "merge",
        "report.pdf",
        "renamed.pdf",
        "--out",
        "merged.pdf"
      ],
      "expect": {
        "exitCode": 6,
        "error": "FORMAT_MISMATCH",
        "json": [
          {
            "path": "error.details.path",
            "equals": "<workspace>/renamed.pdf"
          },
          {
            "path": "error.details.detected",
            "equals": [
              "words"
            ]
          }
        ],
        "files": {
          "absent": [
            "merged.pdf"
          ],
          "nothingWritten": true
        }
      }
    }
  ]
}
