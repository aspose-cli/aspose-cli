{
  "name": "the commands cells render names for the other print areas of an encrypted workbook pass on its password variable",
  "steps": [
    {
      "args": ["cells", "create", "areas.xlsx", "--sheet-names", "Data", "--encrypt-env", "BOOK_PASSWORD"],
      "env": { "BOOK_PASSWORD": "hint-secret-7d2a" },
      "expect": { "exitCode": 0 }
    },
    {
      "args": [
        "cells", "edit", "areas.xlsx", "--password-env", "BOOK_PASSWORD", "--in-place", "--ops",
        "{\"ops\":[{\"op\":\"set_values\",\"sheet\":\"Data\",\"range\":\"A1\",\"values\":[[\"Left\",1],[\"Rows\",2]]},{\"op\":\"set_values\",\"sheet\":\"Data\",\"range\":\"E1\",\"values\":[[\"Right\",3],[\"Rows\",4]]},{\"op\":\"set_print_area\",\"sheet\":\"Data\",\"range\":\"A1:B2,E1:F2\"}]}"
      ],
      "env": { "BOOK_PASSWORD": "hint-secret-7d2a" },
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["cells", "render", "areas.xlsx", "--password-env", "BOOK_PASSWORD", "--out", "areas.png"],
      "env": { "BOOK_PASSWORD": "hint-secret-7d2a" },
      "expect": {
        "exitCode": 0,
        "warnings": { "present": ["SHEET_PARTIALLY_RENDERED"] },
        "hidden": ["hint-secret-7d2a"]
      }
    }
  ]
}
