{
  "name": "an unknown guide, schema or operation name lists what exists",
  "steps": [
    {
      "args": [
        "docs",
        "edting"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          {
            "path": "error.details.available",
            "contains": "editing"
          }
        ]
      }
    },
    {
      "args": [
        "schema",
        "v2/common/not-found-detail"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          {
            "path": "error.details.available",
            "contains": "v2/common/not-found-details"
          }
        ]
      }
    },
    {
      "args": [
        "schema",
        "v2/pdf/ops",
        "--operation",
        "fild"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          {
            "path": "error.details.available",
            "contains": "field"
          }
        ]
      }
    }
  ]
}
