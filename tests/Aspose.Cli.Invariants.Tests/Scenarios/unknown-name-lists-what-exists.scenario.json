{
  "name": "an unknown schema id lists what exists",
  "steps": [
    {
      "args": [
        "schema",
        "v2/common/not-found-detail"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          {
            "path": "error.details.available",
            "contains": "v2/common/not-found-details"
          }
        ]
      }
    },
    {
      "args": [
        "schema",
        "v2/pdf/ops/fild"
      ],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          {
            "path": "error.details.available",
            "contains": "v2/pdf/ops/field"
          }
        ]
      }
    }
  ]
}
