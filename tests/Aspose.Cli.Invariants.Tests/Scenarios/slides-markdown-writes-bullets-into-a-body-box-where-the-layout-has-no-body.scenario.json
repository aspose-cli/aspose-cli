{
  "name": "slides create --from-markdown writes a content slide's bullets into a box named Body, not into the subtitle, when the template has no content layout and the slide falls back to its Title Slide layout",
  "files": {
    "template.pptx": { "copy": "Assets/slides-only-a-title-slide-layout.pptx" },
    "deck.md": { "text": "# T\n\n## Two\n\n- b\n" }
  },
  "steps": [
    {
      "args": ["slides", "create", "deck.pptx", "--from-markdown", "deck.md", "--template", "template.pptx"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["slides", "read", "deck.pptx", "--slides", "2"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "slides[0].layout", "equals": "Title Slide" },
          { "path": "slides[0].title", "equals": "Two" },
          { "path": "slides[0].shapes[1].shapeName", "equals": "Body" },
          { "path": "slides[0].shapes[1].placeholder", "exists": false },
          { "path": "slides[0].shapes[1].text", "equals": "b" }
        ]
      }
    }
  ]
}
