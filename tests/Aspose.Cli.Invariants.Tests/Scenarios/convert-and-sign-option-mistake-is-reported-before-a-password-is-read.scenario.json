{
  "name": "cells, words and slides convert and pdf sign report a mistake in their own options before they read a password",
  "files": {
    "data.csv": { "text": "name,amount\nTotal,3\n" },
    "notes.md": { "fixture": "markdown" },
    "deck.pptx": { "fixture": "slides.pptx" },
    "input.pdf": { "fixture": "pdf.pdf" },
    "cert.pfx": { "fixture": "certificate.pfx" }
  },
  "steps": [
    {
      "args": ["cells", "convert", "data.csv", "--to", "xlsx", "--out", "book.xlsx", "--password-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--separator" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["cells", "convert", "data.csv", "--to", "xlsx", "--out", "book.xlsx", "--separator", ",", "--encoding", "no-such-encoding", "--convert-numbers", "false", "--convert-dates", "false", "--encrypt-stdin"],
      "stdin": "",
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--encoding" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["cells", "convert", "data.csv", "--to", "xlsx", "--out", "book.xlsx", "--separator", ",", "--encoding", "utf-8", "--convert-numbers", "false", "--convert-dates", "false", "--password-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--password-env" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["words", "convert", "notes.md", "--to", "docx", "--out", "notes.docx", "--password-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--encoding" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["words", "convert", "notes.md", "--to", "docx", "--out", "notes.docx", "--encoding", "no-such-encoding", "--encrypt", ""],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--encoding" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["words", "convert", "notes.md", "--to", "docx", "--out", "notes.docx", "--encoding", "utf-8", "--password-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--password-env" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["slides", "convert", "deck.pptx", "--to", "pptx", "--out", "copy.pptx", "--slides", "first", "--encrypt-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--slides" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["slides", "convert", "deck.pptx", "--to", "pptx", "--out", "copy.pptx", "--slides", "1", "--encrypt-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--encrypt-env" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "sign", "input.pdf", "--page", "1", "--certificate", "cert.pfx", "--visible", "--rect", "36,36,wide,60", "--certificate-password-env", "SCENARIO_UNSET_SECRET", "--out", "signed.pdf"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--rect" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "sign", "input.pdf", "--page", "1", "--certificate", "cert.pfx", "--visible", "--rect", "36,36,wide,60", "--certificate-password-stdin", "--password-env", "SCENARIO_UNSET_SECRET", "--out", "signed.pdf"],
      "stdin": "",
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--rect" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "sign", "input.pdf", "--page", "1", "--certificate", "cert.pfx", "--visible", "--rect", "36,36,wide,60", "--certificate-password-env", "SCENARIO_UNSET_SECRET", "--out", "signed.txt"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--rect" }],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "sign", "input.pdf", "--page", "1", "--certificate", "cert.pfx", "--visible", "--rect", "36,36,180,60", "--certificate-password-env", "SCENARIO_UNSET_SECRET", "--out", "signed.pdf"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.option", "equals": "--certificate-password-env" }],
        "files": { "nothingWritten": true }
      }
    }
  ]
}
