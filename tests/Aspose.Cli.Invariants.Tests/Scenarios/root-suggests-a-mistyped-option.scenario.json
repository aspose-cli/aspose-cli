{
  "name": "a mistyped root option suggests that root option alone",
  "steps": [
    {
      "args": ["--vresion"],
      "expect": {
        "exitCode": 2,
        "error": "USAGE_ERROR",
        "json": [{ "path": "error.details.suggestions", "equals": ["--version"] }],
        "files": { "nothingWritten": true }
      }
    }
  ]
}
