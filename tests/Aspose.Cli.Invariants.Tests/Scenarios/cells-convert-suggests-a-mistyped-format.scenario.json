{
  "name": "a mistyped --to value is an invalid option value that suggests the format",
  "files": {
    "book.xlsx": { "fixture": "cells.xlsx" }
  },
  "steps": [
    {
      "args": ["cells", "convert", "book.xlsx", "--to", "csvv", "--out", "out.csv"],
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [{ "path": "error.details.suggestions", "contains": "csv" }],
        "files": { "absent": ["out.csv"], "nothingWritten": true }
      }
    }
  ]
}
