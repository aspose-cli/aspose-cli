{
  "name": "words convert into Markdown leaves out every kind of drawing its export writes as a picture and names it, keeping the text of shapes and text boxes in the body after the paragraph that held them, and a horizontal rule and a formula as text",
  "files": {
    "drawn.docx": { "copy": "Assets/words-every-kind-of-drawing.docx" }
  },
  "steps": [
    {
      "args": ["words", "convert", "drawn.docx", "--to", "md"],
      "expect": {
        "exitCode": 0,
        "warnings": { "only": ["REMOTE_RESOURCES_BLOCKED", "LOSSY_CONVERSION", "LOSSY_CONVERSION"] },
        "json": [
          { "path": "warnings[code=LOSSY_CONVERSION][1].details.content", "equals": ["pictures", "charts", "shapes"] },
          { "path": "warnings[code=LOSSY_CONVERSION][1].message", "equals": "The md output holds the text alone and leaves out 6 picture(s), 1 chart(s) and 5 other drawing(s), such as shapes, text boxes, WordArt and SmartArt; the text of shapes and text boxes stays in the body." }
        ],
        "files": { "present": ["drawn.md"], "absent": ["drawn.001.png", "drawn-images"] },
        "hidden": ["data:", "!["]
      }
    },
    {
      "args": ["words", "read", "drawn.md"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "blocks[4].text", "equals": "Rectangle with text:" },
          { "path": "blocks[5].text", "equals": "RECT-TEXT" },
          { "path": "blocks[11].text", "equals": "Formula:" },
          { "path": "blocks[12].text", "equals": "x=2" },
          { "path": "blocks[15].text", "equals": "Text box:" },
          { "path": "blocks[16].text", "equals": "TEXTBOX-TEXT" },
          { "path": "blocks[17].text", "equals": "After." },
          { "path": "blocks[18]", "exists": false }
        ]
      }
    }
  ]
}
