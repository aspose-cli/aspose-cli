{
  "name": "a PDF with a picture converts to every format pdf convert writes",
  "files": {
    "pic.html": {
      "text": "<html><body><h1>Report</h1><p>Text before.</p><img src=\"dot.png\"><p>Text after.</p></body></html>"
    },
    "dot.png": {
      "base64": "iVBORw0KGgoAAAANSUhEUgAAACgAAAAoCAIAAAADnC86AAAAMElEQVR4nO3NMQ0AAAgDsCmZfynIwgQJT5P+zbQvIhaLxWKxWCwWi8VisVgsFvcsXhHvWVsvWSOBAAAAAElFTkSuQmCC"
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "convert",
        "pic.html",
        "--out",
        "pic.pdf"
      ],
      "expect": {
        "exitCode": 0,
        "files": {
          "present": [
            "pic.pdf"
          ]
        }
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "md",
        "--out",
        "pic.out.md"
      ],
      "expect": {
        "exitCode": 0,
        "files": {
          "present": [
            "pic.out.md"
          ]
        }
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "txt",
        "--out",
        "pic.out.txt"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "html",
        "--out",
        "pic.out.html"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "docx",
        "--out",
        "pic.out.docx"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "xlsx",
        "--out",
        "pic.out.xlsx"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "pptx",
        "--out",
        "pic.out.pptx"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "epub",
        "--out",
        "pic.out.epub"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "xps",
        "--out",
        "pic.out.xps"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "pdfa-1b",
        "--convert-error-action",
        "Delete",
        "--out",
        "pic.out.pdfa-1b.pdf"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "pdfa-2b",
        "--convert-error-action",
        "Delete",
        "--out",
        "pic.out.pdfa-2b.pdf"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "pdfa-3b",
        "--convert-error-action",
        "Delete",
        "--out",
        "pic.out.pdfa-3b.pdf"
      ],
      "expect": {
        "exitCode": 0
      }
    },
    {
      "args": [
        "pdf",
        "convert",
        "pic.pdf",
        "--to",
        "tiff",
        "--out",
        "pic.out.tiff"
      ],
      "expect": {
        "exitCode": 0
      }
    }
  ]
}
