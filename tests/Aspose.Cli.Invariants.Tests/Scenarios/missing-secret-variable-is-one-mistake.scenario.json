{
  "name": "an *-env option or *Env field naming an unset variable is reported with one wording",
  "files": {
    "doc.docx": { "fixture": "words.docx" },
    "input.pdf": { "fixture": "pdf.pdf" },
    "cert.pfx": { "fixture": "certificate.pfx" },
    "unprotect.json": { "text": "{\"ops\":[{\"op\":\"unprotect\",\"passwordEnv\":\"SCENARIO_UNSET_SECRET\"}]}" }
  },
  "steps": [
    {
      "args": ["words", "inspect", "doc.docx", "--password-env", "SCENARIO_UNSET_SECRET"],
      "expect": {
        "error": "OPTION_INVALID",
        "json": [
          { "path": "error.message", "contains": "environment variable 'SCENARIO_UNSET_SECRET' is not set or is empty" },
          { "path": "error.details.option", "equals": "--password-env" },
          { "path": "error.details.variable", "equals": "SCENARIO_UNSET_SECRET" }
        ],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["pdf", "sign", "input.pdf", "--certificate", "cert.pfx", "--certificate-password-env", "SCENARIO_UNSET_SECRET", "--out", "signed.pdf"],
      "expect": {
        "error": "OPTION_INVALID",
        "json": [
          { "path": "error.message", "contains": "environment variable 'SCENARIO_UNSET_SECRET' is not set or is empty" },
          { "path": "error.details.option", "equals": "--certificate-password-env" },
          { "path": "error.details.variable", "equals": "SCENARIO_UNSET_SECRET" }
        ],
        "files": { "nothingWritten": true }
      }
    },
    {
      "args": ["words", "edit", "doc.docx", "--ops", "unprotect.json", "--out", "out.docx"],
      "expect": {
        "error": "OPS_INVALID",
        "json": [
          { "path": "error.details.reason", "equals": "environment variable 'SCENARIO_UNSET_SECRET' is not set or is empty" },
          { "path": "error.hint", "contains": "Set SCENARIO_UNSET_SECRET to the secret" }
        ],
        "files": { "nothingWritten": true }
      }
    }
  ]
}
