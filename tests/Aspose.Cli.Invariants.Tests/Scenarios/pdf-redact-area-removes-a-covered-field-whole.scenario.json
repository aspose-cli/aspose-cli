{
  "name": "pdf edit redact_area removes a field it covers whole with nothing of it left to read: one the calculation order names, and the parent a covered field leaves empty, while a parent with another field stays",
  "files": {
    "calc.pdf": {
      "base64": ""
    },
    "hier.pdf": {
      "base64": ""
    },
    "hier2.pdf": {
      "base64": ""
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "edit",
        "calc.pdf",
        "--ops",
        "[{\"op\":\"set_form_field\",\"name\":\"total\",\"value\":\"TOTALSECRET\"},{\"op\":\"redact_area\",\"page\":1,\"rect\":{\"x\":60,\"y\":262,\"width\":230,\"height\":40}}]",
        "--out",
        "calc-covered.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "verification.ok",
            "equals": true
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "calc-covered.pdf",
        "--detail",
        "forms"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "forms.fieldCount",
            "equals": 2
          },
          {
            "path": "forms.fields[0].name",
            "equals": "qty"
          },
          {
            "path": "forms.fields[1].name",
            "equals": "sig"
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "hier.pdf",
        "--ops",
        "[{\"op\":\"redact_area\",\"page\":1,\"rect\":{\"x\":60,\"y\":162,\"width\":230,\"height\":40}}]",
        "--out",
        "hier-covered.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "verification.ok",
            "equals": true
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "hier-covered.pdf",
        "--detail",
        "forms"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "forms.fieldCount",
            "equals": 1
          },
          {
            "path": "forms.fields[0].name",
            "equals": "other"
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "hier2.pdf",
        "--ops",
        "[{\"op\":\"redact_area\",\"page\":1,\"rect\":{\"x\":60,\"y\":162,\"width\":230,\"height\":40}}]",
        "--out",
        "hier2-covered.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "verification.ok",
            "equals": true
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "hier2-covered.pdf",
        "--detail",
        "forms"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "forms.fieldCount",
            "equals": 1
          },
          {
            "path": "forms.fields[0].name",
            "equals": "form.b"
          },
          {
            "path": "forms.fields[0].value",
            "equals": "BetaV"
          }
        ]
      }
    }
  ]
}
