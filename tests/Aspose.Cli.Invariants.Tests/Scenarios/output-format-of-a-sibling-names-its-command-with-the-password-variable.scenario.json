{
  "name": "the command an output format of a sibling names for an encrypted input passes on its password variable",
  "steps": [
    {
      "args": ["cells", "create", "book.xlsx", "--sheet-names", "Data", "--encrypt-env", "BOOK_PASSWORD"],
      "env": { "BOOK_PASSWORD": "hint-secret-7d2a" },
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["cells", "render", "book.xlsx", "--password-env", "BOOK_PASSWORD", "--out", "book.pdf"],
      "env": { "BOOK_PASSWORD": "hint-secret-7d2a" },
      "expect": {
        "exitCode": 2,
        "error": "OPTION_INVALID",
        "json": [
          { "path": "error.hint", "contains": "or run 'aspose-cli cells convert " },
          { "path": "error.hint", "contains": " --password-env BOOK_PASSWORD --to pdf --out book.pdf --output-format json' for pdf" }
        ],
        "files": { "absent": ["book.pdf"] },
        "hidden": ["hint-secret-7d2a"]
      }
    }
  ]
}
