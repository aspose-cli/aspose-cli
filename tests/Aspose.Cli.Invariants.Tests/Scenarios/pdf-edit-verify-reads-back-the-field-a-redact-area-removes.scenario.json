{
  "name": "pdf edit --verify reads back that a redact_area removes the field of the input whose only widget it covers, and leaves the operation unchecked, saying only the fields were read back, as it leaves a cover over no field",
  "files": {
    "calc.pdf": {
      "base64": ""
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "edit",
        "calc.pdf",
        "--ops",
        "[{\"op\":\"redact_area\",\"page\":1,\"rect\":{\"x\":60,\"y\":262,\"width\":230,\"height\":40}}]",
        "--out",
        "covered.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "verification.ok",
            "equals": true
          },
          {
            "path": "verification.checkedOps",
            "notContains": "op-0001"
          },
          {
            "path": "verification.uncheckedOps",
            "contains": {
              "id": "op-0001",
              "reason": "Only that the form fields its area covers are gone was read back; render the page to confirm the cover."
            }
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "covered.pdf",
        "--detail",
        "forms"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "forms.fieldCount",
            "equals": 2
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "calc.pdf",
        "--ops",
        "[{\"op\":\"redact_area\",\"page\":1,\"rect\":{\"x\":400,\"y\":10,\"width\":50,\"height\":50}}]",
        "--out",
        "corner.pdf",
        "--verify"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "verification.ok",
            "equals": true
          },
          {
            "path": "verification.uncheckedOps[0].id",
            "equals": "op-0001"
          },
          {
            "path": "verification.uncheckedOps[0].reason",
            "equals": "The verification did not read this operation's effect back from the output; read the output to confirm it."
          }
        ]
      }
    }
  ]
}
