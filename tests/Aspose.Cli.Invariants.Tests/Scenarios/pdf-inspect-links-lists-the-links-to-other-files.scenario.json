{
  "name": "pdf inspect --detail links lists the links that open another file, with the file and the page of it they open where they name one, beside the web links, and a page deletion counts neither as navigation it broke",
  "files": {
    "remote.pdf": {
      "base64": ""
    },
    "bm.pdf": {
      "base64": ""
    }
  },
  "steps": [
    {
      "args": [
        "pdf",
        "inspect",
        "remote.pdf",
        "--detail",
        "links"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "links",
            "equals": [
              {
                "page": 1,
                "rect": {
                  "x": 72,
                  "y": 72,
                  "width": 128,
                  "height": 20
                },
                "file": "other.pdf",
                "targetPage": 3
              },
              {
                "page": 1,
                "rect": {
                  "x": 72,
                  "y": 172,
                  "width": 128,
                  "height": 20
                },
                "file": "other.pdf"
              },
              {
                "page": 1,
                "rect": {
                  "x": 72,
                  "y": 272,
                  "width": 128,
                  "height": 20
                },
                "url": "https://example.com/"
              }
            ]
          },
          {
            "path": "documentLinks",
            "equals": [
              {
                "page": 1,
                "rect": {
                  "x": 72,
                  "y": 372,
                  "width": 128,
                  "height": 20
                },
                "targetPage": 2
              }
            ]
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "edit",
        "remote.pdf",
        "--ops",
        "[{\"op\":\"delete_pages\",\"pages\":\"2\"}]",
        "--out",
        "remote-deleted.pdf"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][0].message",
            "equals": "0 bookmark(s), 1 link(s) and 0 named destination(s) lead to pages the edit deleted."
          },
          {
            "path": "warnings[code=NAVIGATION_DEGRADED][1]",
            "exists": false
          }
        ]
      }
    },
    {
      "args": [
        "pdf",
        "inspect",
        "bm.pdf",
        "--detail",
        "links"
      ],
      "expect": {
        "exitCode": 0,
        "json": [
          {
            "path": "links[0].file",
            "equals": "other.pdf"
          },
          {
            "path": "links[0].targetPage",
            "equals": 3
          },
          {
            "path": "links[0].url",
            "exists": false
          },
          {
            "path": "links[1].url",
            "equals": "https://example.com/"
          }
        ]
      }
    }
  ]
}
