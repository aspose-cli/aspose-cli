{
  "name": "pdf edit --verify reads back the web link add_hyperlink adds, with its address and area as pdf inspect --detail links reads them, and leaves it unchecked once a later operation changes its page's geometry or covers an area of its page",
  "files": {
    "nav.pdf": { "base64": "" }
  },
  "steps": [
    {
      "args": ["pdf", "edit", "nav.pdf", "--ops", "[{\"op\":\"add_hyperlink\",\"page\":2,\"rect\":{\"x\":72.5,\"y\":100.25,\"width\":120,\"height\":18},\"url\":\"https://example.org/terms\"}]", "--out", "linked.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.checkedOps", "equals": ["op-0001"] },
          { "path": "verification.uncheckedOps", "exists": false }
        ]
      }
    },
    {
      "args": ["pdf", "inspect", "linked.pdf", "--detail", "links"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "links[0]", "equals": { "page": 2, "rect": { "x": 72.5, "y": 100.25, "width": 120, "height": 18 }, "url": "https://example.org/terms" } }
        ]
      }
    },
    {
      "args": ["pdf", "edit", "nav.pdf", "--ops", "[{\"op\":\"add_hyperlink\",\"page\":2,\"rect\":{\"x\":72.5,\"y\":100.25,\"width\":120,\"height\":18},\"url\":\"https://example.org/terms\"},{\"op\":\"redact_area\",\"page\":2,\"rect\":{\"x\":60,\"y\":90,\"width\":200,\"height\":40}}]", "--out", "covered.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.uncheckedOps[0].id", "equals": "op-0001" }
        ]
      }
    },
    {
      "args": ["pdf", "edit", "nav.pdf", "--ops", "[{\"op\":\"add_hyperlink\",\"page\":2,\"rect\":{\"x\":72.5,\"y\":100.25,\"width\":120,\"height\":18},\"url\":\"https://example.org/terms\"},{\"op\":\"redact_area\",\"page\":1,\"rect\":{\"x\":60,\"y\":90,\"width\":200,\"height\":40}}]", "--out", "elsewhere.pdf", "--verify"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.checkedOps", "contains": "op-0001" }
        ]
      }
    }
  ]
}
