{
  "name": "cells edit replace_text writes text that reads back as it wrote it: a leading apostrophe stays, the text #N/A replaced to #REF! stays text, so --verify passes, and a replacement that looks like a number stays text as before",
  "steps": [
    {
      "args": ["cells", "create", "texts.xlsx", "--sheet-names", "S"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["cells", "edit", "texts.xlsx", "--in-place", "--ops",
        "{\"ops\":[{\"op\":\"set_values\",\"sheet\":\"S\",\"range\":\"A1\",\"values\":[[\"'abc\",\"'007\",\"'#N/A\",\"#N/A\",\"7\",\"plain abc\"]]}]}"],
      "expect": { "exitCode": 0 }
    },
    {
      "args": ["cells", "edit", "texts.xlsx", "--out", "replaced.xlsx", "--verify", "--ops",
        "{\"ops\":[{\"op\":\"replace_text\",\"sheet\":\"S\",\"find\":\"abc\",\"replace\":\"xyz\"},{\"op\":\"replace_text\",\"sheet\":\"S\",\"find\":\"007\",\"replace\":\"008\"},{\"op\":\"replace_text\",\"sheet\":\"S\",\"find\":\"N/A\",\"replace\":\"REF!\"},{\"op\":\"replace_text\",\"sheet\":\"S\",\"find\":\"7\",\"replace\":\"8\"}]}"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "verification.ok", "equals": true },
          { "path": "verification.formulaErrors", "equals": [] }
        ]
      }
    },
    {
      "args": ["cells", "read", "replaced.xlsx", "--sheet", "S", "--range", "A1:F1"],
      "expect": {
        "exitCode": 0,
        "json": [
          { "path": "sheet.cells[0]", "equals": [
            { "v": "'xyz", "t": "string" }, { "v": "'008", "t": "string" }, { "v": "'#REF!", "t": "string" },
            { "v": "#REF!", "t": "string" }, { "v": "8", "t": "string" }, { "v": "plain xyz", "t": "string" }
          ] }
        ]
      }
    }
  ]
}
